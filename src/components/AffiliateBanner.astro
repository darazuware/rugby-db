---
import { getWatchProviders, AFFILIATE_LINK_ATTRS } from "../lib/affiliates";

interface Props {
    league?: string;
    type?: "horizontal" | "card";
}

const { league, type = "horizontal" } = Astro.props;

interface BannerInfo {
    title: string;
    subtitle: string;
    description: string;
    buttonText: string;
    url: string;
    color: string;
    provider: string;
}

const getBannerInfo = (leagueId?: string): BannerInfo | null => {
    const providers = getWatchProviders(leagueId ?? "league-one");
    const primary = providers[0];
    // 視聴サービス未登録のリーグ（urc / premiership 等）はバナー自体を出さない
    if (!primary) return null;
    const providerLabel = providers.map((p) => p.name).join(" / ");

    switch (leagueId) {
        case "super-rugby":
            return {
                title: "SUPER RUGBY PACIFIC",
                subtitle: `${providerLabel} 独占生中継`,
                description:
                    "世界最高峰の戦いを、日本で唯一の独占放送・配信で楽しむ。",
                buttonText: `${providerLabel} で今すぐ視聴する`,
                url: primary.url,
                color: "from-[#0055A4] to-black",
                provider: providerLabel,
            };
        case "top14":
            return {
                title: "TOP 14 FRANCE",
                subtitle: `${providerLabel} で視聴可能`,
                description:
                    "スター選手が集結するフランス・トップ14を、いつでもどこでも視聴。",
                buttonText: `${providerLabel} で今すぐ視聴する`,
                url: primary.url,
                color: "from-[#C5A059] to-black",
                provider: providerLabel,
            };
        case "league-one":
        default:
            return {
                title: "JAPAN RUGBY LEAGUE ONE",
                subtitle: `${providerLabel} で放送・配信`,
                description:
                    "熱狂の国内リーグ全試合をチェック。マルチアングルや見逃し配信も。",
                buttonText: "視聴方法をチェックする",
                url: primary.url,
                color: "from-[#E60012] to-black",
                provider: providerLabel,
            };
    }
};

const banner = getBannerInfo(league);
---

{banner && (
<div
    class={`relative overflow-hidden rounded-[2rem] bg-gradient-to-br ${
        banner.color
    } p-8 md:p-12 text-white shadow-2xl group border border-white/10 ${
        type === "card" ? "aspect-square flex flex-col justify-end" : ""
    }`}
>
    <div
        class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"
    >
    </div>

    <div class="relative z-10">
        <div class="flex items-center gap-3 mb-4">
            <span
                class="px-3 py-1 bg-yellow-400 text-black text-[10px] font-black uppercase tracking-widest rounded-full italic"
            >
                {banner.provider}
            </span>
            <div class="h-px flex-grow bg-white/20"></div>
        </div>

        <h3
            class={`font-black italic tracking-tighter leading-none mb-2 ${
                type === "card" ? "text-2xl" : "text-3xl md:text-5xl uppercase"
            }`}
        >
            {banner.title}
        </h3>
        <p
            class={`text-yellow-400 font-bold italic mb-4 ${
                type === "card" ? "text-lg" : "text-xl md:text-2xl"
            }`}
        >
            {banner.subtitle}
        </p>

        {
            type !== "card" && (
                <p class="text-foreground/60 font-medium mb-8 max-w-xl text-sm md:text-base leading-relaxed">
                    {banner.description}
                </p>
            )
        }

        <div class="flex flex-wrap items-center gap-6">
            <a href={banner.url}
               target={AFFILIATE_LINK_ATTRS.target}
               rel={AFFILIATE_LINK_ATTRS.rel}
               class="inline-flex items-center gap-3 px-10 py-5 bg-white text-gray-950 rounded-2xl font-black text-lg hover:bg-yellow-400 hover:text-black hover:scale-105 active:scale-95 transition-all shadow-xl shadow-white/10 group/btn">
                公式サイトで詳細を見る
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
            {
                type !== "card" && (
                    <span class="hidden md:inline-block text-xs font-bold text-foreground/40 italic">
                        ※ 放送・配信内容は予告なく変更される場合があります
                    </span>
                )
            }
        </div>
    </div>

    {/* 特殊な装飾用要素 */}
    <div
        class="absolute -bottom-12 -right-12 w-48 h-48 bg-white/5 rounded-full blur-3xl group-hover:bg-yellow-400/10 transition-colors"
    >
    </div>
</div>
)}
