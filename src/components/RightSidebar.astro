---
import teamsData from "../../data/teams.json";

interface Props {
  type?: "default" | "results";
  activeLeague?: string;
  activeRound?: number | "all";
}

const { type = "default", activeLeague, activeRound } = Astro.props;

// ダミーの人気選手データ (後で動的化可能)
const popularPlayers = [
  { id: "cheslin-kolbe", name: "Cheslin KOLBE", team: "Suntory Sungoliath", image: "https://league-one.jp/img/player/29260.jpg", rank: 1 }, // 実際は適切な画像URLが必要
  { id: "richie-mounga", name: "Richie MO'UNGA", team: "Toshiba Brave Lupus", rank: 2 },
  { id: "pieter-steph-du-toit", name: "Pieter-Steph DU TOIT", team: "Toyota Verblitz", rank: 3 },
  { id: "beauden-barrett", name: "Beauden BARRETT", team: "Toyota Verblitz", rank: 4 },
  { id: "damian-de-allende", name: "Damian DE ALLENDE", team: "Wild Knights", rank: 5 },
];

// 戦績ページ用の節リスト取得 (簡易版)
const getRounds = () => {
    return Array.from({ length: 18 }, (_, i) => i + 1);
};
---

<aside class="w-full space-y-8 mt-12 lg:mt-0 lg:sticky lg:top-24 lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto no-scrollbar">
  {/* リーグ切り替え (New) */}
  <div class="bg-card/30 backdrop-blur-xl border border-border-dim/50 rounded-[2rem] p-6 shadow-2xl">
      <div class="flex items-center gap-3 mb-6">
          <span class="w-2 h-8 bg-yellow-400 rounded-full"></span>
          <h3 class="font-black italic text-xl tracking-tighter uppercase">Switch League</h3>
      </div>
      <div class="grid gap-2">
          {[
              { id: 'league-one-d1', label: 'リーグワン', color: 'bg-red-600' },
              { id: 'super-rugby', label: 'Super Rugby', color: 'bg-blue-600' },
              { id: 'top14', label: 'TOP 14', color: 'bg-yellow-600' }
          ].map(l => (
              <button
                  data-league-switch={l.id}
                  class={`sidebar-league-btn flex items-center gap-3 p-3 rounded-xl border border-border-dim/50 hover:border-yellow-400/50 transition-all group text-left ${activeLeague === l.id ? 'bg-white/5 border-yellow-400' : 'bg-transparent'}`}
              >
                  <span class={`w-2 h-2 rounded-full ${l.color}`}></span>
                  <span class="text-[10px] font-black uppercase tracking-widest text-foreground/60 group-hover:text-yellow-400">
                      {l.label}
                  </span>
              </button>
          ))}
      </div>
      <div class="mt-4 pt-4 border-t border-border-dim/30">
        <a href="/standings" class="flex items-center justify-center gap-2 p-3 rounded-xl bg-yellow-400 text-black font-black text-[10px] hover:bg-white transition-all shadow-lg uppercase tracking-widest group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-4 4 4 5-8"/></svg>
            Full Standings
        </a>
      </div>
  </div>
  {type === "results" && (
    <div class="bg-card/30 backdrop-blur-xl border border-border-dim/50 rounded-[2rem] p-6 shadow-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-2 h-8 bg-yellow-400 rounded-full"></span>
        <h3 class="font-black italic text-xl tracking-tighter uppercase">Jump to Round</h3>
      </div>
      
      <div class="grid grid-cols-3 gap-2">
        {getRounds().map(r => (
          <a
            href={`#${activeLeague}-round-${r}`}
            data-round={r}
            class={`sidebar-round-link flex items-center justify-center p-3 rounded-xl text-[10px] font-black transition-all border ${
              activeRound === r 
                ? 'bg-yellow-400 border-yellow-500 text-black' 
                : 'bg-background/50 border-border-dim text-foreground/40 hover:border-yellow-400/50 hover:text-foreground'
            }`}
          >
            {r}
          </a>
        ))}
      </div>
      <div class="mt-6 flex justify-center">
        <a href="#top" class="text-[10px] font-black text-foreground/20 hover:text-yellow-400 transition-colors uppercase tracking-[0.2em] flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
          Back to Top
        </a>
      </div>
    </div>
  )}

  {/* アクセスランキング */}
  <div class="bg-card/30 backdrop-blur-xl border border-border-dim/50 rounded-[2rem] p-6 shadow-2xl">
    <div class="flex items-center gap-3 mb-8">
      <span class="w-2 h-8 bg-yellow-400 rounded-full"></span>
      <h3 class="font-black italic text-xl tracking-tighter uppercase">Access Ranking</h3>
    </div>

    <div class="space-y-4">
      {popularPlayers.map((player) => (
        <a 
          href={`/players/${player.id}`} 
          class="flex items-center gap-4 p-3 rounded-2xl hover:bg-white/5 transition-all group border border-transparent hover:border-white/10"
        >
          <div class="relative">
            <div class="w-12 h-12 bg-background rounded-xl overflow-hidden border border-border-dim group-hover:border-yellow-400/50 transition-colors">
              <div class="w-full h-full flex items-center justify-center text-foreground/20 font-black italic">
                {player.name[0]}
              </div>
            </div>
            <span class="absolute -top-2 -left-2 w-6 h-6 bg-yellow-400 text-black text-[10px] font-black rounded-lg flex items-center justify-center shadow-lg transform -rotate-12 group-hover:rotate-0 transition-transform">
              {player.rank}
            </span>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-xs font-black text-foreground group-hover:text-yellow-400 transition-colors truncate">
              {player.name}
            </h4>
            <p class="text-[10px] text-foreground/40 font-bold truncate">
              {player.team}
            </p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-foreground/20 group-hover:text-yellow-400 group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      ))}
    </div>

    <div class="mt-8 pt-6 border-t border-border-dim/30">
        <div class="bg-yellow-400/5 rounded-2xl p-4 border border-yellow-400/10">
            <p class="text-[10px] text-yellow-400/60 font-black italic text-center uppercase tracking-widest">
                Real-time Statistics 2026
            </p>
        </div>
    </div>
  </div>

  {/* 順位表・戦績クイックリンク */}
  <div class="bg-gradient-to-br from-yellow-400 to-yellow-600 p-8 rounded-[2rem] shadow-2xl relative overflow-hidden group">
    <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
    <div class="relative z-10">
        <h4 class="font-black italic text-2xl text-black mb-2 leading-none uppercase tracking-tighter">Standings</h4>
        <p class="text-black/60 text-[10px] font-bold mb-6 italic uppercase tracking-widest">Global League Data</p>
        <a href="/standings" class="inline-flex items-center gap-2 px-6 py-3 bg-black text-white rounded-xl font-black text-[10px] hover:bg-white hover:text-black hover:scale-105 transition-all uppercase tracking-widest shadow-xl">
            View All
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
    </div>
    <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-white/20 rounded-full blur-3xl group-hover:bg-black/10 transition-colors"></div>
  </div>
</aside>
