---
import { getMagazineProvider, AFFILIATE_LINK_ATTRS } from "../lib/affiliates";

interface Props {
    type?: "horizontal" | "card";
}

const { type = "horizontal" } = Astro.props;
const mag = getMagazineProvider();
---

<div
    class={`relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-[#BF0000] to-black p-8 md:p-12 text-white shadow-2xl group border border-white/10 ${
        type === "card" ? "aspect-square flex flex-col justify-end" : ""
    }`}
>
    <div class="relative z-10">
        <div class="flex items-center gap-3 mb-4">
            <span class="px-3 py-1 bg-yellow-400 text-black text-[10px] font-black uppercase tracking-widest rounded-full italic">
                {mag.name}
            </span>
            <div class="h-px flex-grow bg-white/20"></div>
        </div>

        <p class="text-yellow-400 font-black italic text-3xl md:text-5xl leading-none mb-2 tracking-tighter">
            {mag.campaign}
        </p>
        <h3 class={`font-black tracking-tighter leading-tight mb-4 ${type === "card" ? "text-lg" : "text-2xl md:text-3xl"}`}>
            ラグビーマガジンが読み放題
        </h3>

        {
            type !== "card" && (
                <p class="text-white/70 font-medium mb-8 max-w-xl text-sm md:text-base leading-relaxed">
                    国内外の試合レポート・戦術分析・選手インタビューが満載のラグビー専門誌を、期間限定キャンペーンでお得に試し読み。
                </p>
            )
        }

        <div class="flex flex-wrap items-center gap-6">
            <a href={mag.url}
               target={AFFILIATE_LINK_ATTRS.target}
               rel={AFFILIATE_LINK_ATTRS.rel}
               class="inline-flex items-center gap-3 px-10 py-5 bg-white text-gray-950 rounded-2xl font-black text-lg hover:bg-yellow-400 hover:text-black hover:scale-105 active:scale-95 transition-all shadow-xl shadow-white/10">
                {mag.campaign}で読んでみる
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
            {
                type !== "card" && (
                    <span class="hidden md:inline-block text-xs font-bold text-white/40 italic">
                        ※ 本ページにはプロモーションが含まれます
                    </span>
                )
            }
        </div>
    </div>

    <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-white/5 rounded-full blur-3xl group-hover:bg-yellow-400/10 transition-colors"></div>
</div>
