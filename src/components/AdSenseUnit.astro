---
interface Props {
    slot: string;
    format?: "auto" | "fluid" | "rectangle";
    class?: string;
    responsive?: "true" | "false";
}

const { 
    slot, 
    format = "auto", 
    class: className = "", 
    responsive = "true" 
} = Astro.props;

const AD_CLIENT = "ca-pub-7526742711058970";
---

<div class={`adsense-container my-8 overflow-hidden flex justify-center ${className}`}>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={AD_CLIENT}
         data-ad-slot={slot}
         data-ad-format={format}
         data-full-width-responsive={responsive}></ins>
    <script is:inline>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
</div>
