---
/**
 * PlayerAvatar.astro
 * 選手アバター（06、P4-4で完成形）。表示優先順:
 *   ① data/manual/instagram_accounts.json に登録がある → Instagram公式埋め込み
 *   ② public/illustrations/{playerId}.webp が存在する → AIイラスト
 *   ③ どちらも無い → イニシャル＋チームカラーのプレースホルダーSVG（追加アセット不要）
 * 上位が無ければ下位へ自動フォールバックする（ファイル/登録の存在で判定）。
 *
 * playerId を渡さない呼び出しは③のみで動作する（後方互換）。
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import InstagramEmbed from "./InstagramEmbed.astro";
import instagramAccounts from "../../data/manual/instagram_accounts.json";

interface Props {
  name: string | null;
  /** チームカラー（hex）。無ければ名前ハッシュから決定的に色を選ぶ。 */
  color?: string | null;
  size?: number;
  class?: string;
  /** master の player.id。① Instagram登録 / ② イラスト配置の判定に使う。省略時は③のみ。 */
  playerId?: string | null;
}

const { name, color = null, size = 128, class: className = "", playerId = null } = Astro.props;

type InstagramAccount = { username: string; post_url: string };
const accounts = instagramAccounts as Record<string, InstagramAccount>;
const instagramEntry: InstagramAccount | null =
  playerId != null ? (accounts[playerId] ?? null) : null;

const illustrationPath =
  playerId != null
    ? join(process.cwd(), "public", "illustrations", `${playerId}.webp`)
    : null;
const hasIllustration = illustrationPath != null && existsSync(illustrationPath);

/** 表示イニシャル: ラテン名は各語頭、日本語等は先頭1〜2文字。 */
function initials(n: string | null): string {
  if (!n) return "?";
  const s = n.trim();
  if (!s) return "?";
  if (/^[\x00-\x7F\s.'-]+$/.test(s)) {
    const words = s.split(/\s+/).filter(Boolean);
    const out = words
      .slice(0, 2)
      .map((w) => w[0])
      .join("")
      .toUpperCase();
    return out || "?";
  }
  const chars = Array.from(s.replace(/[\s・･]/g, ""));
  return chars.slice(0, 2).join("") || "?";
}

/** 名前から決定的に背景色を選ぶ（チームカラー未設定時のフォールバック）。 */
function colorFromName(n: string | null): string {
  const palette = [
    "#1f2937",
    "#374151",
    "#0f766e",
    "#1e3a8a",
    "#7c2d12",
    "#3f3f46",
    "#5b21b6",
    "#065f46",
  ];
  let h = 0;
  for (const ch of n ?? "") h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return palette[h % palette.length];
}

const hex = color && /^#?[0-9a-fA-F]{6}$/.test(color)
  ? color.startsWith("#")
    ? color
    : `#${color}`
  : colorFromName(name);
const label = initials(name);
---

{
  instagramEntry ? (
    <InstagramEmbed
      postUrl={instagramEntry.post_url}
      username={instagramEntry.username}
      class={className}
    />
  ) : hasIllustration ? (
    <img
      src={`/illustrations/${playerId}.webp`}
      width={size}
      height={size}
      alt={name ?? "選手"}
      class={className}
      style="object-fit: cover;"
    />
  ) : (
    <svg
      viewBox="0 0 100 100"
      width={size}
      height={size}
      class={className}
      role="img"
      aria-label={name ?? "選手"}
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect width="100" height="100" rx="18" fill={hex}></rect>
      <text
        x="50"
        y="50"
        dy="0.35em"
        text-anchor="middle"
        font-size="38"
        font-weight="800"
        fill="#ffffff"
        font-family="system-ui, -apple-system, sans-serif">{label}</text>
    </svg>
  )
}
