---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "RUGBY PICKS（ラグビーピックス）は、世界中のラグビー選手情報を爆速で検索できる日本最大級の名鑑データベースです。リーグワン、TOP 14、SUPER RUGBY、URCの全選手を網羅。年齢・身長・体重等でのソートも可能。",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@100..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="selection:bg-yellow-400 selection:text-black">
		<nav class="bg-black text-white p-4 sticky top-0 z-50 shadow-lg">
			<div class="container mx-auto flex justify-between items-center">
				<a
					href="/"
					class="flex flex-col leading-tight pr-2 flex-shrink-0"
				>
					<span
						class="text-[16px] md:text-2xl font-black font-display italic text-white uppercase tracking-tighter"
						>RUGBY</span
					>
					<span
						class="text-[18px] md:text-2xl font-black font-display italic text-yellow-400 uppercase tracking-tighter -mt-1 md:mt-0 md:ml-1.5"
						>PICKS</span
					>
				</a>
				<div
					class="flex-1 flex justify-end gap-3 md:gap-8 font-bold text-[10px] md:text-sm items-center"
				>
					<a
						href="/leagues"
						class="text-white hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap"
						>リーグ一覧</a
					>
					<a
						href="/players"
						class="text-white hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap"
						>選手名鑑</a
					>
					<a
						href="/results"
						class="text-white hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap"
						>戦績</a
					>
				</div>
			</div>
		</nav>
		<slot />
		<footer
			class="bg-gray-900 text-gray-400 py-16 border-t border-gray-800 mt-auto"
		>
			<div class="container mx-auto px-4 text-center">
				<div
					class="text-2xl font-black font-display italic text-white mb-4 uppercase"
				>
					RUGBY&nbsp;<span class="text-yellow-400">PICKS</span>
				</div>
				<div
					class="text-[10px] md:text-xs flex flex-wrap justify-center gap-x-8 gap-y-3 mb-8 font-bold uppercase tracking-widest text-gray-500"
				>
					<a
						href="/privacy"
						class="hover:text-yellow-400 transition-colors"
						>プライバシーポリシー</a
					>
					<a
						href="/terms"
						class="hover:text-yellow-400 transition-colors"
						>免責事項・利用規約</a
					>
					<a
						href="/contact"
						class="hover:text-yellow-400 transition-colors"
						>お問い合わせ</a
					>
					<a
						href="/sitemap"
						class="hover:text-yellow-400 transition-colors"
						>サイトマップ</a
					>
				</div>
				<p class="font-bold mb-2">© 2026 RUGBY PICKS PLAYER DATABASE</p>
				<p class="text-xs text-gray-600">
					爆速選手名鑑 powered by Astro + React + Tailwind CSS
				</p>
			</div>
		</footer>
	</body>
</html>
