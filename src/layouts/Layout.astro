---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle";
import RightSidebar from "../components/RightSidebar.astro";

interface Props {
	title: string;
	description?: string;
	sidebarType?: "default" | "results";
	activeLeague?: string;
	activeRound?: number | "all";
}

const {
	title,
	description = "RUGBY PICKS（ラグビーピックス）は、世界中のラグビー選手情報を爆速で検索できる日本最大級の名鑑データベースです。リーグワン、TOP 14、SUPER RUGBY、URCの全選手を網羅。年齢・身長・体重等でのソートも可能。",
	sidebarType = "default",
	activeLeague,
	activeRound
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL("/ogp-image.png", Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL("/ogp-image.png", Astro.url)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<!-- Google Analytics (GA4) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-3QYR0XFW1Q"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-3QYR0XFW1Q');
		</script>
		<!-- Google AdSense -->
		<meta name="google-adsense-account" content="ca-pub-7526742711058970" />
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7526742711058970"
			crossorigin="anonymous"></script>
		<script is:inline>
			const theme = (() => {
				const saved = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
				if (saved === 'dark' || saved === 'light') return saved;
				return 'auto';
			})();
		
			const applyTheme = (t) => {
				const root = document.documentElement;
				if (t === 'auto') {
					const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					root.classList.toggle('dark', isDark);
				} else {
					root.classList.toggle('dark', t === 'dark');
				}
			};

			applyTheme(theme);

			// OS設定変更の監視
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				const currentSaved = localStorage.getItem('theme');
				if (!currentSaved || currentSaved === 'auto') {
					applyTheme('auto');
				}
			});
		</script>
	</head>
	<body id="top" class="selection:bg-yellow-400 selection:text-black overflow-x-hidden">
		<nav class="bg-card text-foreground p-3 sm:p-4 sticky top-0 z-50 shadow-lg border-b border-border-dim w-full">
			<div class="max-w-[1400px] mx-auto flex flex-col xs:flex-row justify-between items-center gap-3 sm:gap-4">
				<div class="flex justify-between items-center w-full xs:w-auto px-1">
					<a
						href="/"
						class="flex flex-col leading-none sm:leading-tight pr-1 sm:pr-2 flex-shrink-0"
					>
						<span
							class="text-[14px] xs:text-[16px] md:text-2xl font-black font-display italic text-foreground uppercase tracking-tighter"
							>RUGBY</span
						>
						<span
							class="text-[16px] xs:text-[18px] md:text-2xl font-black font-display italic text-yellow-400 uppercase tracking-tighter -mt-1 md:mt-0 md:ml-1.5"
							>PICKS</span
						>
					</a>
					<div class="xs:hidden">
						<ThemeToggle client:load />
					</div>
				</div>
				<div
					class="flex-1 flex flex-wrap justify-center xs:justify-end items-center gap-x-3 gap-y-2.5 xs:gap-4 sm:gap-8 md:gap-12 lg:gap-16 font-black tracking-widest text-[11px] xs:text-[14px] sm:text-[15px]"
				>
					<a
						href="/leagues"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap flex-shrink-0"
						>リーグ</a
					>
					<a
						href="/standings"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap flex-shrink-0"
						>順位表</a
					>
					<a
						href="/world-rankings"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap flex-shrink-0"
						>世界ランキング</a
					>
					<a
						href="/players"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap flex-shrink-0"
						>名鑑</a
					>
					<a
						href="/national-teams"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap flex-shrink-0"
						>各国代表</a
					>
					<a
						href="/results"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5 whitespace-nowrap flex-shrink-0"
						>戦績</a
					>
					<div class="hidden xs:block flex-shrink-0 ml-1">
						<ThemeToggle client:load />
					</div>
				</div>
			</div>
		</nav>

		<div class="max-w-[1400px] mx-auto px-4 py-8 lg:py-16 overflow-x-hidden">
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 xl:gap-20">
				<main class="min-w-0 w-full">
					<slot />
				</main>
				<div class="hidden lg:block space-y-8">
					<RightSidebar 
						type={sidebarType} 
						activeLeague={activeLeague} 
						activeRound={activeRound} 
					/>
					<!-- Sidebar Ad -->
					<div class="sticky top-24">
						<ins class="adsbygoogle"
							 style="display:block"
							 data-ad-client="ca-pub-7526742711058970"
							 data-ad-slot="sidebar-ad-slot"
							 data-ad-format="auto"
							 data-full-width-responsive="true"></ins>
						<script is:inline>
							 (adsbygoogle = window.adsbygoogle || []).push({});
						</script>
					</div>
				</div>
			</div>
		</div>
		<footer
			class="bg-card text-foreground/60 py-16 border-t border-border-dim mt-auto"
		>
			<div class="container mx-auto px-4 text-center">
				<div
					class="text-2xl font-black font-display italic text-foreground mb-4 uppercase"
				>
					RUGBY&nbsp;<span class="text-yellow-400">PICKS</span>
				</div>
				<div
					class="text-[10px] md:text-xs flex flex-wrap justify-center gap-x-8 gap-y-3 mb-8 font-bold uppercase tracking-widest text-foreground/40"
				>
					<a
						href="/privacy"
						class="hover:text-yellow-400 transition-colors"
						>プライバシーポリシー</a
					>
					<a
						href="/terms"
						class="hover:text-yellow-400 transition-colors"
						>免責事項・利用規約</a
					>
					<a
						href="/contact"
						class="hover:text-yellow-400 transition-colors"
						>お問い合わせ</a
					>
					<a
						href="/sitemap"
						class="hover:text-yellow-400 transition-colors"
						>サイトマップ</a
					>
				</div>
			</div>
		</footer>

		{/* スクレイピング対策用ハニーポットリンク（人間には見えません） */}
		<div style="display: none;" aria-hidden="true">
			<a href="/api/v1/hidden-dataset.json" rel="nofollow">全選手データ一括ダウンロード (Full Player Data Download)</a>
		</div>

		<style is:global></style>
	</body>
</html>
