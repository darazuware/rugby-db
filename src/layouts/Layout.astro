---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "ラグビー選手名鑑。世界各国の主要リーグ（リーグワン、TOP 14、SUPER RUGBY、URC）所属選手を爆速検索。年齢・身長・体重・ポジション・チームなどでソート・抽出可能。",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class="selection:bg-yellow-400 selection:text-black">
		<nav class="bg-black text-white p-4 sticky top-0 z-50 shadow-lg">
			<div class="container mx-auto flex justify-between items-center">
				<a
					href="/"
					class="text-2xl font-black italic tracking-tighter hover:text-yellow-400 transition-colors"
				>
					RUGBY<span class="text-yellow-400">PICKS</span>
				</a>
				<div class="flex gap-8 font-bold text-sm">
					<a
						href="/leagues"
						class="hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-1"
						>リーグ一覧</a
					>
					<a
						href="/players"
						class="hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-1"
						>選手名鑑</a
					>
					<a
						href="/results"
						class="hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-1"
						>戦績</a
					>
				</div>
			</div>
		</nav>
		<slot />
		<footer
			class="bg-gray-900 text-gray-400 py-16 border-t border-gray-800 mt-auto"
		>
			<div class="container mx-auto px-4 text-center">
				<div
					class="text-2xl font-black italic tracking-tighter text-white mb-4"
				>
					RUGBY<span class="text-yellow-400">PICKS</span>
				</div>
				<p class="font-bold mb-2">© 2026 RUGBYPICK PLAYER DATABASE</p>
				<p class="text-xs text-gray-600">
					爆速選手名鑑 powered by Astro + React + Tailwind CSS
				</p>
			</div>
		</footer>
		<style is:global>
			@import "tailwindcss";
			html,
			body {
				margin: 0;
				width: 100%;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}
		</style>
	</body>
</html>
