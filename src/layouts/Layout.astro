---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle";
import RightSidebar from "../components/RightSidebar.astro";

interface Props {
	title: string;
	description?: string;
	sidebarType?: "default" | "results";
	activeLeague?: string;
	activeRound?: number | "all";
}

const {
	title,
	description = "RUGBY PICKS（ラグビーピックス）は、世界中のラグビー選手情報を爆速で検索できる日本最大級の名鑑データベースです。リーグワン、TOP 14、SUPER RUGBY、URCの全選手を網羅。年齢・身長・体重等でのソートも可能。",
	sidebarType = "default",
	activeLeague,
	activeRound
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<!-- Google AdSense -->
		<meta name="google-adsense-account" content="ca-pub-7526742711058970" />
		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7526742711058970"
			crossorigin="anonymous"></script>
		<script is:inline>
			const theme = (() => {
				try {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
				} catch (e) {}
				if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			try {
				if (typeof localStorage !== 'undefined') {
					localStorage.setItem('theme', theme);
				}
			} catch (e) {}
		</script>
	</head>
	<body id="top" class="selection:bg-yellow-400 selection:text-black">
		<nav class="bg-card text-foreground p-4 sticky top-0 z-50 shadow-lg border-b border-border-dim">
			<div class="container mx-auto flex justify-between items-center">
				<a
					href="/"
					class="mobile-logo flex flex-col leading-tight pr-2 flex-shrink-0"
				>
					<span
						class="text-[16px] md:text-2xl font-black font-display italic text-foreground uppercase tracking-tighter"
						>RUGBY</span
					>
					<span
						class="text-[18px] md:text-2xl font-black font-display italic text-yellow-400 uppercase tracking-tighter -mt-1 md:mt-0 md:ml-1.5"
						>PICKS</span
					>
				</a>
				<div
					class="mobile-nav-links flex-1 flex justify-end items-center gap-4 md:gap-16 lg:gap-20 font-black tracking-widest text-[14px] md:text-[15px]"
				>
					<a
						href="/leagues"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5"
						>リーグ一覧</a
					>
					<a
						href="/standings"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5"
						>順位表</a
					>
					<a
						href="/players"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5"
						>選手名鑑</a
					>
					<a
						href="/results"
						class="text-foreground hover:text-yellow-400 transition-colors border-b-2 border-transparent hover:border-yellow-400 pb-0.5"
						>戦績</a
					>
					<ThemeToggle client:load />
				</div>
			</div>
		</nav>

		<div class="container mx-auto px-4 py-8 lg:py-16">
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12 xl:gap-20 items-start">
				<main class="min-w-0">
					<slot />
				</main>
				<RightSidebar 
					type={sidebarType} 
					activeLeague={activeLeague} 
					activeRound={activeRound} 
				/>
			</div>
		</div>
		<footer
			class="bg-card text-foreground/60 py-16 border-t border-border-dim mt-auto"
		>
			<div class="container mx-auto px-4 text-center">
				<div
					class="text-2xl font-black font-display italic text-foreground mb-4 uppercase"
				>
					RUGBY&nbsp;<span class="text-yellow-400">PICKS</span>
				</div>
				<div
					class="text-[10px] md:text-xs flex flex-wrap justify-center gap-x-8 gap-y-3 mb-8 font-bold uppercase tracking-widest text-foreground/40"
				>
					<a
						href="/privacy"
						class="hover:text-yellow-400 transition-colors"
						>プライバシーポリシー</a
					>
					<a
						href="/terms"
						class="hover:text-yellow-400 transition-colors"
						>免責事項・利用規約</a
					>
					<a
						href="/contact"
						class="hover:text-yellow-400 transition-colors"
						>お問い合わせ</a
					>
					<a
						href="/sitemap"
						class="hover:text-yellow-400 transition-colors"
						>サイトマップ</a
					>
				</div>
				<p class="font-bold mb-2">© 2026 RUGBY PICKS PLAYER DATABASE</p>
				<p class="text-xs text-foreground/30">
					爆速選手名鑑 powered by Astro + React + Tailwind CSS
				</p>
			</div>
		</footer>
		<style is:global>
			/* モバイルナビゲーションの強制調整 */
			@media (max-width: 767px) {
				.mobile-logo {
					display: flex !important;
					flex-direction: column !important;
					line-height: 1.1 !important;
				}
				.mobile-nav-links {
					display: flex !important;
					justify-content: flex-end !important;
					gap: 1.25rem !important; /* さらに少し広げる */
					font-size: 18px !important; /* 14pxから18pxへ（当初の約2倍近く） */
					font-weight: 900 !important; /* 太くして視認性アップ */
				}
				.mobile-nav-links a {
					white-space: nowrap !important;
					flex-shrink: 0 !important;
				}
			}
		</style>
	</body>
</html>
