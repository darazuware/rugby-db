---
import fs from "fs";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JSONLD from "../../components/JSONLD.astro";
import PRNotice from "../../components/PRNotice.astro";
import OverseasTravelButtons from "../../components/OverseasTravelButtons.astro";

const rwc = JSON.parse(fs.readFileSync(new URL("../../../data/manual/rwc2027.json", import.meta.url), "utf-8"));
// 出場国名（プール表の日本語短縮名）→ 各国ハブページの slug。
// national_teams_config の name（「◯◯代表」）から「代表」を除いた短縮名で対応づける。
const nationalTeamsConfig = JSON.parse(fs.readFileSync(new URL("../../../data/national_teams_config.json", import.meta.url), "utf-8"));
const teamSlugByName: Record<string, string> = {};
for (const t of nationalTeamsConfig as Array<{ name: string; slug: string }>) {
  teamSlugByName[t.name.replace(/代表$/, "").trim()] = t.slug;
}

export const prerender = true;

// 開催都市ガイド用: host_cities（州名等の地理情報）と venues（会場・収容人数）を都市名で結合
interface Venue { city_ja: string; stadium_ja: string; capacity: number }
interface HostCity { city_ja: string; state_ja: string; is_japan_match_city: boolean }
const venuesByCity = new Map<string, Venue[]>();
for (const v of rwc.venues as Venue[]) {
  if (!venuesByCity.has(v.city_ja)) venuesByCity.set(v.city_ja, []);
  venuesByCity.get(v.city_ja)!.push(v);
}
const cityGuides = (rwc.host_cities as HostCity[]).map((c) => ({
  ...c,
  stadiums: venuesByCity.get(c.city_ja) ?? [],
}));

// Format date to "2027年10月3日（日）" style
function formatDate(dateStr: string): string {
  const date = new Date(dateStr + "T00:00:00Z");
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth() + 1;
  const day = date.getUTCDate();
  const dayOfWeekNames = ["日", "月", "火", "水", "木", "金", "土"];
  const dayOfWeek = dayOfWeekNames[date.getUTCDay()];
  return `${year}年${month}月${day}日（${dayOfWeek}）`;
}

const durationDays =
  Math.round(
    (new Date(rwc.tournament.end_date + "T00:00:00Z").getTime() -
      new Date(rwc.tournament.start_date + "T00:00:00Z").getTime()) /
      86400000
  ) + 1;

const pageTitle = "ラグビーワールドカップ2027 日程・組み合わせ・日本代表試合日｜完全ガイド";
const pageDescription = `${formatDate(rwc.tournament.start_date)}〜${formatDate(rwc.tournament.end_date)}開催。オーストラリアでの大会に日本はプールEで、フランス・アメリカ・サモアと同じプールで戦います。全試合日程・会場・組み合わせを完全網羅。`;

// JSON-LD schema for SportsEvent
const jsonLdData = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": rwc.tournament.name_ja,
  "startDate": rwc.tournament.start_date,
  "endDate": rwc.tournament.end_date,
  "location": {
    "@type": "Place",
    "name": rwc.tournament.host_country_ja,
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "AU"
    }
  },
  "url": "https://rugbypick.com/rwc2027",
  "description": pageDescription,
  "image": ["https://rugbypick.com/ogp-image.png"],
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "organizer": {
    "@type": "Organization",
    "name": "World Rugby",
    "url": "https://www.world.rugby/"
  },
  "offers": {
    "@type": "Offer",
    "url": "https://rugbypick.com/rwc2027",
    "availability": "https://schema.org/InStock",
    "validFrom": rwc.scraped_at
  }
};
---

<Layout title={pageTitle} description={pageDescription} lastmod={rwc.scraped_at}>
  <Breadcrumbs items={[
    { label: "RWC 2027" }
  ]} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdData)} />

  <main class="min-h-screen bg-background">
    <div class="pt-8 pb-16 px-4">
      <div class="max-w-7xl mx-auto">
        {/* H1 Title */}
        <h1 class="text-4xl md:text-6xl font-black text-foreground italic tracking-tighter mb-4 leading-tight">
          {rwc.tournament.name_ja}
        </h1>
        <p class="text-foreground/60 font-bold tracking-[0.05em] text-sm md:text-base mb-4">
          {formatDate(rwc.tournament.start_date)}〜{formatDate(rwc.tournament.end_date)}開催
        </p>
        <PRNotice />

        {/* Tournament Overview */}
        <section class="mb-16">
          <h2 class="text-2xl md:text-3xl font-black text-foreground mb-6 uppercase tracking-tight">
            大会概要
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-card border border-border-dim rounded-lg p-6">
              <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-2">
                開催国
              </div>
              <div class="text-2xl font-black text-foreground">
                {rwc.tournament.host_country_ja}
              </div>
            </div>
            <div class="bg-card border border-border-dim rounded-lg p-6">
              <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-2">
                出場チーム数
              </div>
              <div class="text-2xl font-black text-foreground">
                {rwc.tournament.teams}チーム
              </div>
            </div>
            <div class="bg-card border border-border-dim rounded-lg p-6">
              <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-2">
                総試合数
              </div>
              <div class="text-2xl font-black text-foreground">
                {rwc.tournament.matches}試合
              </div>
            </div>
            <div class="bg-card border border-border-dim rounded-lg p-6">
              <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-2">
                期間
              </div>
              <div class="text-2xl font-black text-foreground">
                {durationDays}日間
              </div>
            </div>
          </div>
          <div class="bg-card border border-border-dim rounded-lg p-6 mb-6">
            <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-3">
              フォーマット
            </div>
            <p class="text-foreground leading-relaxed">
              {rwc.tournament.format_ja}
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-card border border-border-dim rounded-lg p-6">
              <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-2">
                開幕戦
              </div>
              <p class="text-foreground leading-relaxed">
                {rwc.tournament.opening_match_ja}
              </p>
            </div>
            <div class="bg-card border border-border-dim rounded-lg p-6">
              <div class="text-sm font-bold text-foreground/60 uppercase tracking-wider mb-2">
                決勝
              </div>
              <p class="text-foreground leading-relaxed">
                {rwc.tournament.final_ja}
              </p>
            </div>
          </div>
        </section>

        {/* Japan Matches */}
        <section class="mb-16">
          <h2 class="text-2xl md:text-3xl font-black text-foreground mb-6 uppercase tracking-tight">
            日本代表の試合日程（プールE）
          </h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-yellow-400/10 border-b-2 border-yellow-400">
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    試合日
                  </th>
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    対戦相手
                  </th>
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    会場
                  </th>
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    都市
                  </th>
                </tr>
              </thead>
              <tbody>
                {rwc.japan_matches.map((match) => (
                  <tr class="border-b border-border-dim hover:bg-card/50 transition-colors">
                    <td class="px-4 py-4 text-foreground font-bold">
                      {formatDate(match.date)}
                    </td>
                    <td class="px-4 py-4 text-foreground font-bold">
                      vs {match.opponent_ja}
                    </td>
                    <td class="px-4 py-4 text-foreground/80">
                      {match.venue_ja}
                    </td>
                    <td class="px-4 py-4 text-foreground/80">
                      {match.city_ja}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {/* All Pools */}
        <section class="mb-16">
          <h2 class="text-2xl md:text-3xl font-black text-foreground mb-6 uppercase tracking-tight">
            全プール一覧
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {Object.entries(rwc.pools).map(([poolName, teams]) => (
              <div class={`bg-card border-2 rounded-lg p-6 transition-all ${
                poolName === rwc.japan_pool
                  ? "border-yellow-400 shadow-lg shadow-yellow-400/20"
                  : "border-border-dim"
              }`}>
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-2xl font-black text-foreground uppercase">
                    プール{poolName}
                  </h3>
                  {poolName === rwc.japan_pool && (
                    <span class="text-xs font-black bg-yellow-400 text-black px-3 py-1 rounded-full uppercase tracking-widest">
                      日本
                    </span>
                  )}
                </div>
                <div class="space-y-2">
                  {teams.map((team: string) => (
                    teamSlugByName[team] ? (
                      <a
                        href={`/national-teams/${teamSlugByName[team]}/`}
                        class="flex items-center gap-2 text-foreground/80 hover:text-yellow-400 font-bold text-sm transition-colors group"
                      >
                        <span class="w-1.5 h-1.5 bg-yellow-400 rounded-full"></span>
                        <span class="group-hover:underline">{team}</span>
                        <span class="text-[10px] opacity-40 group-hover:opacity-100">記事・選手 ›</span>
                      </a>
                    ) : (
                      <div class="flex items-center gap-2 text-foreground/80 font-bold text-sm">
                        <span class="w-1.5 h-1.5 bg-yellow-400 rounded-full"></span>
                        {team}
                      </div>
                    )
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* Knockout Schedule */}
        <section class="mb-16">
          <h2 class="text-2xl md:text-3xl font-black text-foreground mb-6 uppercase tracking-tight">
            決勝トーナメント日程
          </h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-yellow-400/10 border-b-2 border-yellow-400">
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    ラウンド
                  </th>
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    予定日
                  </th>
                </tr>
              </thead>
              <tbody>
                {rwc.knockout.map((round) => (
                  <tr class="border-b border-border-dim hover:bg-card/50 transition-colors">
                    <td class="px-4 py-4 text-foreground font-bold">
                      {round.round_ja}
                    </td>
                    <td class="px-4 py-4 text-foreground/80">
                      {round.dates_ja}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {/* Venues */}
        <section class="mb-16">
          <h2 class="text-2xl md:text-3xl font-black text-foreground mb-6 uppercase tracking-tight">
            開催会場一覧
          </h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-yellow-400/10 border-b-2 border-yellow-400">
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    都市
                  </th>
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    スタジアム
                  </th>
                  <th class="px-4 py-3 text-left font-black text-foreground uppercase text-xs tracking-wider">
                    収容人数
                  </th>
                </tr>
              </thead>
              <tbody>
                {rwc.venues.map((venue) => (
                  <tr class="border-b border-border-dim hover:bg-card/50 transition-colors">
                    <td class="px-4 py-4 text-foreground font-bold">
                      {venue.city_ja}
                    </td>
                    <td class="px-4 py-4 text-foreground/80">
                      {venue.stadium_ja}
                    </td>
                    <td class="px-4 py-4 text-foreground/80 font-bold">
                      {venue.capacity.toLocaleString('ja-JP')}人
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {/* Host City Guide */}
        <section class="mb-16">
          <h2 class="text-2xl md:text-3xl font-black text-foreground mb-2 uppercase tracking-tight">
            開催都市ガイド
          </h2>
          <p class="text-foreground/50 text-xs font-bold mb-6">
            {rwc.host_cities_note}
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {cityGuides.map((c) => (
              <div class={`bg-card border-2 rounded-lg p-6 transition-all ${
                c.is_japan_match_city
                  ? "border-yellow-400 shadow-lg shadow-yellow-400/20"
                  : "border-border-dim"
              }`}>
                <div class="flex items-center justify-between mb-1">
                  <h3 class="text-xl font-black text-foreground">
                    {c.city_ja}
                  </h3>
                  {c.is_japan_match_city && (
                    <span class="text-xs font-black bg-yellow-400 text-black px-3 py-1 rounded-full uppercase tracking-widest">
                      日本代表試合
                    </span>
                  )}
                </div>
                <p class="text-foreground/50 text-xs font-bold mb-4">
                  {c.state_ja}
                </p>
                <div class="space-y-1 mb-4">
                  {c.stadiums.map((s) => (
                    <p class="text-foreground/80 text-sm font-bold">
                      {s.stadium_ja}（収容{s.capacity.toLocaleString('ja-JP')}人）
                    </p>
                  ))}
                </div>
                <OverseasTravelButtons city={c.city_ja} compact />
              </div>
            ))}
          </div>
        </section>

        {/* Notice */}
        <section class="mb-16">
          <div class="bg-yellow-400/10 border-l-4 border-yellow-400 rounded-r-lg p-6">
            <p class="text-foreground/70 font-bold text-sm leading-relaxed">
              情報は判明次第更新します。日程・会場・対戦相手は予定のため、変更される可能性があります。宿泊・航空券の空き状況や価格は変動するため、渡航計画は公式発表・各予約サービスで最新情報をご確認ください。
            </p>
          </div>
        </section>

      </div>
    </div>
  </main>

  <style>
    main {
      background-image:
        radial-gradient(circle at 50% -20%, rgba(250, 204, 21, 0.05), transparent),
        radial-gradient(circle at 0% 50%, rgba(250, 204, 21, 0.02), transparent);
    }
  </style>
</Layout>
