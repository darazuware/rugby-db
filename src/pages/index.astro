---
import Layout from "../layouts/Layout.astro";
import AffiliateBanner from "../components/AffiliateBanner.astro";
import StandingsWidget from "../components/StandingsWidget";
import standingsData from "../../data/standings.json";
import teamsData from "../../data/teams.json";
import teamNamesJp from "../../data/team_names_jp.json";

// チーム情報のマッピングを取得する共通関数
const getTeamMapping = (leagueId: string, teamName: string) => {
    const leagueMapping = (teamNamesJp as any)[leagueId || ""] || {};
    // 1. 正式名で直接検索
    if (leagueMapping[teamName]) return leagueMapping[teamName];
    // 2. エイリアス、日本語名、または短縮日本語名で全体検索
    for (const formalName in leagueMapping) {
        const data = leagueMapping[formalName];
        const shortJp = data.jp.includes("（") ? data.jp.split("（")[0] : data.jp;
        if (
            data.jp === teamName ||
            shortJp === teamName ||
            (data.aliases && data.aliases.includes(teamName)) ||
            formalName.includes(teamName) ||
            teamName.includes(formalName) ||
            data.jp.includes(teamName) ||
            teamName.includes(data.jp)
        ) {
            return data;
        }
    }
    return null;
};

const mapStandings = (leagueId: string) => {
    const raw = (standingsData as any)[leagueId]?.standings || [];
    const leagueTeams = (teamsData as any[]).filter(t => t.league === (leagueId === 'league-one' ? 'league-one' : leagueId));
    
    return raw.slice(0, 4).map((s: any) => {
        const mapping = getTeamMapping(leagueId, s.team_name);
        const teamInTeams = leagueTeams.find((t: any) => 
            t.team_name === s.team_name || 
            t.team_name_jp === s.team_name || 
            (mapping && t.team_name === mapping.jp)
        );
        return {
            ...s,
            slug: teamInTeams?.slug || s.slug,
            display_name: s.display_name || mapping?.jp || s.team_name,
            flag: s.flag || mapping?.flag || "",
        };
    });
};

const leagueStandings = [
	{
		id: "league-one",
		name: "LEAGUE ONE",
		name_jp: "リーグワン",
		fullName: "ジャパンラグビー リーグワン",
		title: "Japan Rugby League One",
		accentColor: "bg-[#E60012]",
		teams: mapStandings("league-one"),
	},
	{
		id: "super-rugby",
		name: "SUPER RUGBY",
		name_jp: "スーパーラグビー",
		fullName: "Super Rugby Pacific",
		title: "Super Rugby Pacific",
		accentColor: "bg-[#0055A4]",
		teams: mapStandings("super-rugby"),
	},
	{
		id: "top14",
		name: "TOP 14",
		name_jp: "トップ14",
		fullName: "Top 14 France",
		title: "Top 14 France",
		accentColor: "bg-[#C5A059]",
		teams: mapStandings("top14"),
	},
	{
		id: "urc",
		name: "URC",
		name_jp: "URC",
		fullName: "United Rugby Championship",
		title: "United Rugby Championship",
		accentColor: "bg-[#003366]",
		teams: mapStandings("urc"),
	},
	{
		id: "premiership",
		name: "PREM",
		name_jp: "プレミアシップ",
		fullName: "Gallagher Premiership",
		title: "Gallagher Premiership",
		accentColor: "bg-[#FE5000]",
		teams: mapStandings("premiership"),
	},
];
---

<Layout
	title="RUGBY PICKS | 世界のラグビーを日本語で爆速検索・名鑑データベース"
>
    {/* ヒーローセクション - サイドバーの横でも見栄えが良いように調整 */}
    <section class="relative overflow-hidden mb-16 rounded-[2.5rem] bg-card/30 border border-border-dim/50 p-8 md:p-16">
        <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
        
        <div class="relative z-10">
            <span class="inline-block px-4 py-1.5 bg-yellow-400 text-black font-black text-[10px] rounded-full mb-6 tracking-widest uppercase italic">
                Next Generation Database
            </span>
            <h1 class="text-5xl md:text-7xl font-black font-display italic mb-6 leading-none uppercase tracking-tighter">
                Rugby <span class="text-yellow-400">Picks</span>
            </h1>
            <p class="text-base md:text-lg text-foreground/40 font-bold mb-10 max-w-xl leading-relaxed">
                世界中のラグビー選手情報を一瞬で引き出す。<br class="hidden md:block" />
                国内・海外全2,000名以上の選手を網羅した最強の名鑑サイト。
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="/players" class="px-8 py-4 bg-yellow-400 text-black font-black text-sm rounded-xl hover:bg-white hover:scale-105 transition-all shadow-xl shadow-yellow-400/20 group flex items-center gap-2">
                    選手検索 <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
            </div>
        </div>

        {/* 装飾用背景テキスト */}
        <div class="absolute -bottom-10 -right-10 text-9xl font-black font-display italic opacity-[0.02] select-none whitespace-nowrap pointer-events-none uppercase">
            RUGBY
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
        {leagueStandings.map(league => (
            <div class="group p-6 bg-card backdrop-blur-sm border border-border-dim rounded-2xl hover:border-yellow-400/50 transition-all text-left">
                <div class="flex items-center gap-3 mb-4">
                    <div class={`w-1 h-6 ${league.accentColor} rounded-full`}></div>
                    <h3 class="text-xs font-black text-foreground uppercase tracking-widest italic flex items-center gap-2">
									<span>{league.name}</span>
									<span class="text-[10px] text-foreground/40 not-italic">{league.name_jp}</span>
								</h3>
                </div>
                <h3 class="text-xl font-black font-display text-foreground tracking-tighter italic mb-6 flex items-baseline gap-2">
                    {league.name}
                    <span class="text-[10px] not-italic text-foreground/30 font-bold uppercase tracking-widest">{league.fullName}</span>
                </h3>
                <div class="grid grid-cols-2 gap-2">
                    <a href={`/teams/${league.id === 'league-one' ? 'league-one' : league.id}`} 
                       class="py-3 bg-yellow-400 text-black text-center font-black text-[10px] rounded-xl hover:bg-white transition-all shadow-lg uppercase tracking-widest">
                        PLAYERS
                    </a>
                    <a href={`/results?league=${league.id}`}
                       class="py-3 bg-foreground/5 text-foreground/40 text-center font-black text-[10px] rounded-xl hover:bg-foreground hover:text-background transition-all border border-border-dim uppercase tracking-widest">
                        RESULTS
                    </a>
                </div>
            </div>
        ))}
    </div>

    <section class="mb-16">
        <StandingsWidget client:load leagueStandings={leagueStandings} />
    </section>

    <section class="mb-12">
        <AffiliateBanner />
    </section>
</Layout>
