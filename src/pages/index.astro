---
import Layout from "../layouts/Layout.astro";
import AffiliateBanner from "../components/AffiliateBanner.astro";
import StandingsWidget from "../components/StandingsWidget";
import standingsData from "../../data/standings.json";

const leagueStandings = [
	{
		id: "league-one",
		name: "League One",
		fullName: "JAPAN RUGBY LEAGUE ONE",
		accentColor: "bg-[#E60012]",
		teams: ((standingsData["league-one"] as any)?.standings || []).slice(
			0,
			3
		),
	},
	{
		id: "super-rugby",
		name: "Super Rugby",
		fullName: "SUPER RUGBY PACIFIC",
		accentColor: "bg-[#0055A4]",
		teams: ((standingsData["super-rugby"] as any)?.standings || []).slice(
			0,
			3
		),
	},
	{
		id: "top14",
		name: "Top 14",
		fullName: "TOP 14 FRANCE",
		accentColor: "bg-[#C5A059]",
		teams: ((standingsData["top14"] as any)?.standings || []).slice(0, 3),
	},
];
---

<Layout title="RUGBYPICK | ラグビー選手名鑑データベース">
	<main>
		<section class="relative bg-black text-white py-32 overflow-hidden">
			<div
				class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"
			>
			</div>
			<div class="container mx-auto px-4 relative z-10 text-center">
				<span
					class="inline-block px-4 py-1 bg-yellow-400 text-black font-black text-sm rounded-full mb-6 animate-bounce"
				>
					NEW START: ASTRO + REACT
				</span>
				<h1
					class="text-6xl md:text-8xl font-black italic tracking-tighter mb-8 leading-none"
				>
					EXPLORE THE<br /><span class="text-yellow-400"
						>NEXT GEN</span
					> DATABASE
				</h1>
				<p
					class="text-xl md:text-2xl text-gray-400 font-bold mb-12 max-w-2xl mx-auto"
				>
					リーグワン所属選手を中心に、詳細なスタッツとキャリアを網羅した爆速・高機能な日本最大級のラグビー選手名鑑。
				</p>
				<div class="flex flex-wrap justify-center gap-6">
					<a
						href="/players"
						class="px-10 py-5 bg-yellow-400 text-black font-black text-xl rounded-2xl hover:bg-white hover:scale-105 transition-all shadow-2xl shadow-yellow-400/20"
					>
						選手名鑑を見る
					</a>
				</div>

				<div
					class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto"
				>
					<a
						href="/teams/league-one"
						class="group p-6 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl hover:bg-yellow-400 hover:border-yellow-400 transition-all text-left"
					>
						<span
							class="block text-xs font-black text-yellow-400 group-hover:text-black mb-2 uppercase tracking-widest"
							>国内リーグ</span
						>
						<h3
							class="text-2xl font-black group-hover:text-black tracking-tighter italic"
						>
							LEAGUE ONE<br />
							<span
								class="text-sm not-italic group-hover:text-black"
								>ジャパンラグビー リーグワン</span
							>
						</h3>
					</a>
					<a
						href="/teams/super-rugby"
						class="group p-6 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl hover:bg-yellow-400 hover:border-yellow-400 transition-all text-left"
					>
						<span
							class="block text-xs font-black text-yellow-400 group-hover:text-black mb-2 uppercase tracking-widest"
							>南半球強豪クラブ</span
						>
						<h3
							class="text-2xl font-black group-hover:text-black tracking-tighter italic"
						>
							SUPER RUGBY<br />
							<span
								class="text-sm not-italic group-hover:text-black"
								>スーパーラグビー</span
							>
						</h3>
					</a>
					<a
						href="/teams/top14"
						class="group p-6 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl hover:bg-yellow-400 hover:border-yellow-400 transition-all text-left"
					>
						<span
							class="block text-xs font-black text-yellow-400 group-hover:text-black mb-2 uppercase tracking-widest"
							>フランス プロリーグ</span
						>
						<h3
							class="text-2xl font-black group-hover:text-black tracking-tighter italic"
						>
							TOP 14<br />
							<span
								class="text-sm not-italic group-hover:text-black"
								>トップ14</span
							>
						</h3>
					</a>

					<a
						href="/teams/urc"
						class="group p-6 bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl hover:bg-yellow-400 hover:border-yellow-400 transition-all text-left"
					>
						<span
							class="block text-xs font-black text-yellow-400 group-hover:text-black mb-2 uppercase tracking-widest"
							>欧州・南アフリカ</span
						>
						<h3
							class="text-2xl font-black group-hover:text-black tracking-tighter italic"
						>
							URC<br />
							<span
								class="text-sm not-italic group-hover:text-black"
								>ユナイテッド・ラグビー・チャンピオンシップ</span
							>
						</h3>
					</a>
				</div>
			</div>
		</section>

		<section class="relative -mt-24 pb-20 z-20">
			<div class="container mx-auto px-4 max-w-6xl">
				<StandingsWidget
					client:load
					leagueStandings={leagueStandings}
				/>
			</div>
		</section>

		<section class="py-12 bg-gray-50">
			<div class="container mx-auto px-4 max-w-5xl">
				<AffiliateBanner />
			</div>
		</section>
	</main>
</Layout>
