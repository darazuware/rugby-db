---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import AffiliateBanner from "../components/AffiliateBanner.astro";
import PRNotice from "../components/PRNotice.astro";
import StandingsWidget from "../components/StandingsWidget";
import standingsData from "../../data/standings.json";
import { getLeagueStandings, type LeagueId } from "../lib/safeStandings";
import teamsData from "../../data/teams.json";
import teamNamesJp from "../../data/team_names_jp.json";
import { getLiveNews } from "../lib/news";

const allNews = await getLiveNews();
const latestNews = allNews.slice(0, 5);
// ランダム表示用のプール（クライアント側でシャッフル）
const newsPool = allNews.map(n => ({
	slug: n.slug,
	title: n.data.title,
	description: (n.data.description || "").slice(0, 120),
	category: n.data.category || "NEWS",
	date: n.data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }),
}));
const pickupInitial = newsPool.slice(0, 6);

// チーム情報のマッピングを取得する共通関数
const getTeamMapping = (leagueId: string, teamName: string) => {
    const leagueMapping = (teamNamesJp as any)[leagueId || ""] || {};
    // 1. 正式名で直接検索
    if (leagueMapping[teamName]) return leagueMapping[teamName];
    // 2. エイリアス、日本語名、または短縮日本語名で全体検索
    for (const formalName in leagueMapping) {
        const data = leagueMapping[formalName];
        const shortJp = data.jp.includes("（") ? data.jp.split("（")[0] : data.jp;
        if (
            data.jp === teamName ||
            shortJp === teamName ||
            (data.aliases && data.aliases.includes(teamName)) ||
            formalName.includes(teamName) ||
            teamName.includes(formalName) ||
            data.jp.includes(teamName) ||
            teamName.includes(data.jp)
        ) {
            return data;
        }
    }
    return null;
};

const mapStandings = (leagueId: string) => {
    const raw = getLeagueStandings(standingsData, leagueId as LeagueId);
    const leagueTeams = (teamsData as any[]).filter(t => t.league === (leagueId === 'league-one' ? 'league-one' : leagueId));
    
    return raw.slice(0, 4).map((s: any) => {
        const mapping = getTeamMapping(leagueId, s.team_name);
        const teamInTeams = leagueTeams.find((t: any) => 
            t.team_name === s.team_name || 
            t.team_name_jp === s.team_name || 
            (mapping && t.team_name === mapping.jp)
        );
        return {
            ...s,
            slug: teamInTeams?.slug || s.slug,
            display_name: s.display_name || mapping?.jp || s.team_name,
            flag: s.flag || mapping?.flag || "",
        };
    });
};

const leagueStandings = [
	{
		id: "league-one",
		name: "LEAGUE ONE",
		name_jp: "リーグワン",
		fullName: "ジャパンラグビー リーグワン",
		title: "Japan Rugby League One",
		accentColor: "bg-[#E60012]",
		teams: mapStandings("league-one"),
	},
	{
		id: "super-rugby",
		name: "SUPER RUGBY",
		name_jp: "スーパーラグビー",
		fullName: "Super Rugby Pacific",
		title: "Super Rugby Pacific",
		accentColor: "bg-[#0055A4]",
		teams: mapStandings("super-rugby"),
	},
	{
		id: "top14",
		name: "TOP 14",
		name_jp: "トップ14",
		fullName: "Top 14 France",
		title: "Top 14 France",
		accentColor: "bg-[#C5A059]",
		teams: mapStandings("top14"),
	},
	{
		id: "urc",
		name: "URC",
		name_jp: "URC",
		fullName: "United Rugby Championship",
		title: "United Rugby Championship",
		accentColor: "bg-[#003366]",
		teams: mapStandings("urc"),
	},
	{
		id: "premiership",
		name: "PREM",
		name_jp: "プレミアシップ",
		fullName: "Gallagher Premiership",
		title: "Gallagher Premiership",
		accentColor: "bg-[#FE5000]",
		teams: mapStandings("premiership"),
	},
	{
		id: "high-school",
		name: "HIGH SCHOOL",
		name_jp: "高校ラグビー",
		fullName: "National High School Rugby",
		title: "High School Rugby",
		accentColor: "bg-yellow-400",
		teams: [],
	},
	{
		id: "university",
		name: "UNIVERSITY",
		name_jp: "大学ラグビー",
		fullName: "National University Rugby",
		title: "University Rugby",
		accentColor: "bg-emerald-500",
		teams: [],
	},
];
---

<Layout
	title="RUGBY PICKS | 世界のラグビーを日本語で高速検索・名鑑データベース"
>
    {/* ヒーローセクション - サイドバーの横でも見栄えが良いように調整 */}
    <section class="relative overflow-hidden mb-16 rounded-[2.5rem] bg-card/30 border border-border-dim/50 p-8 md:p-16">
        <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
        
        <div class="relative z-10">
            <span class="inline-block px-4 py-1.5 bg-yellow-400 text-black font-black text-[10px] rounded-full mb-6 tracking-widest uppercase italic">
                Next Generation Database
            </span>
            <h1 class="text-5xl md:text-7xl font-black font-display italic mb-6 leading-none uppercase tracking-tighter">
                Rugby <span class="text-yellow-400">Picks</span>
            </h1>
            <p class="text-base md:text-lg text-foreground/40 font-bold mb-10 max-w-xl leading-relaxed">
                世界中のラグビー選手情報を一瞬で引き出す。<br class="hidden md:block" />
                国内・海外全4,600名以上の選手を網羅した最強の名鑑サイト。
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="/players" class="px-8 py-4 bg-yellow-400 text-black font-black text-sm rounded-xl hover:bg-white hover:scale-105 transition-all shadow-xl shadow-yellow-400/20 group flex items-center gap-2">
                    選手検索 <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
            </div>
        </div>

        {/* 装飾用背景テキスト */}
        <div class="absolute -bottom-10 -right-10 text-9xl font-black font-display italic opacity-[0.02] select-none whitespace-nowrap pointer-events-none uppercase">
            RUGBY
        </div>
    </section>

    {/* ピックアップ記事（読み込みごとにランダム入れ替え） */}
    <section class="mb-16">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
            <div>
                <h2 class="text-3xl md:text-4xl font-black font-display italic tracking-tighter uppercase">
                    Pick <span class="text-yellow-400">Up</span>
                </h2>
                <p class="text-sm text-foreground/40 font-bold mt-2">
                    全{newsPool.length}本の記事からランダムで6本。
                </p>
            </div>
            <div class="flex items-center gap-3">
                <button
                    type="button"
                    id="pickup-shuffle"
                    class="px-5 py-3 bg-foreground/5 border border-border-dim text-foreground/60 font-black text-[11px] rounded-xl uppercase tracking-widest hover:bg-yellow-400 hover:text-black hover:border-yellow-400 transition-all"
                >
                    ↻ Shuffle
                </button>
                <a href="/news/" class="px-5 py-3 bg-yellow-400 text-black font-black text-[11px] rounded-xl uppercase tracking-widest hover:bg-white transition-all">
                    全記事を見る →
                </a>
            </div>
        </div>

        <div id="pickup-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {pickupInitial.map(item => (
                <a
                    href={`/news/${item.slug}/`}
                    class="group bg-card rounded-[2rem] border border-border-dim p-6 hover:border-yellow-400 transition-all flex flex-col h-full"
                >
                    <div class="flex items-center gap-3 mb-4">
                        <span class="bg-yellow-400 text-black text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-widest">{item.category}</span>
                        <time class="text-xs text-foreground/40 font-bold font-mono">{item.date}</time>
                    </div>
                    <h3 class="text-lg font-black text-foreground group-hover:text-yellow-400 transition-colors mb-3 leading-tight">{item.title}</h3>
                    <p class="text-sm text-foreground/60 line-clamp-3 mb-6">{item.description}</p>
                    <div class="mt-auto flex items-center justify-between text-[11px] font-black uppercase tracking-widest text-foreground/20 group-hover:text-yellow-400/60 transition-colors">
                        <span>Read More</span><span>→</span>
                    </div>
                </a>
            ))}
        </div>

        <script type="application/json" id="pickup-data" set:html={JSON.stringify(newsPool)} is:inline />
        <script is:inline>
            (() => {
                const grid = document.getElementById("pickup-grid");
                const raw = document.getElementById("pickup-data");
                const btn = document.getElementById("pickup-shuffle");
                if (!grid || !raw) return;
                let pool = [];
                try { pool = JSON.parse(raw.textContent || "[]"); } catch { return; }
                if (pool.length < 7) return;

                const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
                const card = (item) => `
                    <a href="/news/${esc(item.slug)}/" class="group bg-card rounded-[2rem] border border-border-dim p-6 hover:border-yellow-400 transition-all flex flex-col h-full">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="bg-yellow-400 text-black text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-widest">${esc(item.category)}</span>
                            <time class="text-xs text-foreground/40 font-bold font-mono">${esc(item.date)}</time>
                        </div>
                        <h3 class="text-lg font-black text-foreground group-hover:text-yellow-400 transition-colors mb-3 leading-tight">${esc(item.title)}</h3>
                        <p class="text-sm text-foreground/60 line-clamp-3 mb-6">${esc(item.description)}</p>
                        <div class="mt-auto flex items-center justify-between text-[11px] font-black uppercase tracking-widest text-foreground/20 group-hover:text-yellow-400/60 transition-colors">
                            <span>Read More</span><span>→</span>
                        </div>
                    </a>`;

                const shuffle = () => {
                    const picks = [];
                    const used = new Set();
                    while (picks.length < 6) {
                        const i = Math.floor(Math.random() * pool.length);
                        if (used.has(i)) continue;
                        used.add(i);
                        picks.push(pool[i]);
                    }
                    grid.innerHTML = picks.map(card).join("");
                };

                shuffle();
                btn?.addEventListener("click", shuffle);
            })();
        </script>
    </section>

    {/* 最新ニュース */}
    <section class="mb-16">
        <h2 class="text-3xl md:text-4xl font-black font-display italic tracking-tighter uppercase mb-8">
            Latest <span class="text-yellow-400">News</span>
        </h2>
        <div class="divide-y divide-border-dim border-y border-border-dim">
            {latestNews.map((item, i) => (
                <a href={`/news/${item.slug}/`} class="group flex items-start gap-5 py-5 hover:bg-foreground/[0.03] transition-colors px-2">
                    <span class="text-2xl font-black font-display italic text-yellow-400/40 w-10 shrink-0 leading-none pt-0.5">
                        {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="min-w-0">
                        <h3 class="font-black text-foreground group-hover:text-yellow-400 transition-colors leading-tight mb-2">
                            {item.data.title}
                        </h3>
                        <div class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-widest text-foreground/30">
                            <span>{item.data.category || "NEWS"}</span>
                            <time class="font-mono">{item.data.pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })}</time>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {leagueStandings.map(league => (
            <div class={`group p-6 bg-card backdrop-blur-sm border-2 ${league.id === 'high-school' || league.id === 'university' ? 'border-yellow-400/20' : 'border-border-dim'} rounded-[2.5rem] hover:border-yellow-400 transition-all text-left relative overflow-hidden`}>
                <div class="absolute top-0 right-0 p-6 opacity-[0.03] pointer-events-none">
                    <span class="text-6xl font-black italic tracking-tighter uppercase">{league.name.split(' ')[0]}</span>
                </div>
                
                <div class="flex items-center gap-3 mb-4">
                    <div class={`w-1.5 h-6 ${league.accentColor} rounded-full`}></div>
                    <h3 class="text-[10px] font-black text-foreground/40 uppercase tracking-widest italic flex items-center gap-2">
									<span>{league.name}</span>
									<span class="not-italic opacity-50">{league.name_jp}</span>
								</h3>
                </div>
                <h3 class="text-2xl font-black font-display text-foreground tracking-tighter italic mb-8 leading-tight">
                    {league.name_jp}
                </h3>
                <div class="grid grid-cols-2 gap-3">
                    <a href={league.id === 'high-school' || league.id === 'university' ? `/players?league=${league.id}` : `/teams/${league.id === 'league-one' ? 'league-one' : league.id}`} 
                       class="py-4 bg-yellow-400 text-black text-center font-black text-[11px] rounded-2xl hover:bg-white transition-all shadow-xl shadow-yellow-400/10 uppercase tracking-widest">
                        PLAYER LIST
                    </a>
                    <a href={league.id === 'high-school' || league.id === 'university' ? "/results/highschool" : `/results?league=${league.id}`}
                       class="py-4 bg-foreground/5 text-foreground/60 text-center font-black text-[11px] rounded-2xl hover:bg-foreground hover:text-background transition-all border border-border-dim uppercase tracking-widest whitespace-nowrap overflow-hidden text-ellipsis">
                        {league.id === 'high-school' || league.id === 'university' ? 'MATCHES' : 'RESULTS'}
                    </a>
                </div>
            </div>
        ))}
    </div>

    <section class="mb-16">
        <StandingsWidget client:load leagueStandings={leagueStandings} />
    </section>

    <section class="mb-12">
        <PRNotice />
        <AffiliateBanner />
    </section>
</Layout>
