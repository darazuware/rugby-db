---
import Layout from "../layouts/Layout.astro";

const categories = [
    {
        title: "メインコンテンツ",
        links: [
            { name: "ホーム", href: "/" },
            { name: "リーグ一覧", href: "/leagues" },
            { name: "全選手名鑑", href: "/players" },
            { name: "試合結果・戦績一覧", href: "/results" },
            { name: "順位表", href: "/standings" },
            { name: "世界ランキング", href: "/world-rankings" },
            { name: "ニュース", href: "/news" },
        ],
    },
    {
        title: "リーグ別情報",
        links: [
            {
                name: "League One (ジャパンラグビー リーグワン)",
                href: "/teams/league-one",
            },
            {
                name: "Super Rugby Pacific (スーパーラグビー)",
                href: "/teams/super-rugby",
            },
            { name: "TOP 14 (フランス・トップ14)", href: "/teams/top14" },
            {
                name: "URC (ユナイテッド・ラグビー・チャンピオンシップ)",
                href: "/teams/urc",
            },
            {
                name: "Premiership (イングランド・プレミアシップ)",
                href: "/teams/premiership",
            },
            { name: "TOP WEST A (トップウェストA)", href: "/teams/top-west-a" },
            { name: "TOP EAST A (トップイーストA)", href: "/teams/top-east-a" },
            { name: "TOP KYUSHU (トップ九州)", href: "/teams/top-kyushu" },
        ],
    },
    {
        title: "RWC2027 / 選手名鑑",
        links: [
            { name: "RWC2027大会情報", href: "/rwc2027" },
            { name: "RWC2027出場国一覧", href: "/national-teams" },
            { name: "高校ラグビー選手名鑑", href: "/players?league=high-school" },
            { name: "大学ラグビー選手名鑑", href: "/players?league=university" },
        ],
    },
    {
        title: "サイト運営・法的情報",
        links: [
            { name: "プライバシーポリシー", href: "/privacy" },
            { name: "免責事項・利用規約", href: "/terms" },
            { name: "お問い合わせ", href: "/contact" },
        ],
    },
];
---

<Layout title="サイトマップ | RUGBY PICKS">
    <main class="bg-background min-h-screen pt-20 pb-20">
        <div class="container mx-auto px-4 max-w-4xl font-sans text-foreground/80">
            <header class="mb-12 border-b border-border-dim pb-8 text-center">
                <h1
                    class="text-5xl font-black text-foreground italic tracking-tighter mb-4 uppercase"
                >
                    SITE <span class="text-yellow-400">MAP</span>
                </h1>
                <p class="text-foreground/40 font-bold">
                    RUGBY PICKS のすべてのコンテンツをご案内します。
                </p>
            </header>

            <div class="grid md:grid-cols-2 gap-12">
                {
                    categories.map((cat) => (
                        <div class="bg-card/30 border border-border-dim p-8 rounded-3xl">
                            <h2 class="text-xl font-bold text-foreground mb-6 flex items-center gap-3">
                                <span class="w-1.5 h-6 bg-yellow-400" />
                                {cat.title}
                            </h2>
                            <ul class="space-y-4">
                                {cat.links.map((link) => (
                                    <li>
                                        <a
                                            href={link.href}
                                            class="text-foreground/40 hover:text-yellow-400 transition-colors flex items-center gap-2 group"
                                        >
                                            <span class="text-yellow-400 opacity-0 group-hover:opacity-100 transition-opacity">
                                                »
                                            </span>
                                            {link.name}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>

            <section
                class="mt-20 p-8 bg-card/50 border border-yellow-400/20 rounded-3xl"
            >
                <h2 class="text-xl font-bold text-foreground mb-4">
                    免責事項（簡易版）
                </h2>
                <p class="text-sm text-foreground/30 leading-relaxed">
                    当サイトに掲載されている選手データ、試合結果、チーム情報等は、各公式サイトより取得したデータを加工・抽出したものです。情報の正確性には最大限配慮しておりますが、内容を保証するものではありません。最新かつ正確な情報は必ず各リーグまたはチームの公式サイトをご確認ください。当サイトの利用により生じた損害について、運営者は一切の責任を負いません。詳細は「<a
                        href="/terms"
                        class="text-yellow-400 underline">免責事項・利用規約</a
                    >」をご覧ください。
                </p>
            </section>
        </div>
    </main>
</Layout>

<style>
    main {
        background: radial-gradient(circle at 50% 0%, var(--background) 0%, var(--card) 100%);
    }
</style>
