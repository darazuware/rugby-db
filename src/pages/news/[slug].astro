---
import Layout from "../../layouts/Layout.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { isLive } from "../../lib/news";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MagazineBanner from "../../components/MagazineBanner.astro";
import AffiliateSlot from "../../components/AffiliateSlot.astro";

export const prerender = true;

export async function getStaticPaths() {
  // 公開判定は lib/news.ts の isLive に統一（一覧・トップと同じ基準）
  const news = await getCollection("news", isLive);
  return news.map((entry: CollectionEntry<"news">) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const entry = await getEntry("news", slug);

if (!entry || entry.data.draft) {
  return Astro.redirect("/404");
}

const { Content } = await entry.render();
const articleDescription =
  entry.data.description ?? `${entry.data.title}に関するRUGBY PICKSのニュース記事です。`;
const articlePublishedAt = entry.data.pubDate.toISOString();
const articleModifiedAt = (entry.data.updatedDate ?? entry.data.pubDate).toISOString();

// 試合レビュー記事（slugが -review で終わる）には配信サービス枠を自動挿入
const isMatchReview = /-review$/.test(slug);
const slotKind = isMatchReview || /^how-to-watch/.test(slug) ? "watch" : /^rwc2027-travel/.test(slug) ? "travel" : /^rugby-gear/.test(slug) ? "gear" : null;

// 本文に Instagram 埋め込みがあるときだけ embed.js を読み込む
const hasInstagram = /instagram-media/.test(entry.body ?? "");

const formatDate = (date: Date) => {
  return date.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
};
---

<Layout
  title={`${entry.data.title} | ニュース | RUGBY PICKS`}
  description={articleDescription}
  lastmod={articleModifiedAt}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: entry.data.title,
    description: articleDescription,
    datePublished: articlePublishedAt,
    dateModified: articleModifiedAt,
    mainEntityOfPage: Astro.url.href,
    publisher: {
      "@type": "Organization",
      name: "RUGBY PICKS",
      url: Astro.site?.href,
    },
    author: { "@type": "Person", name: "RUGBY PICKS 運営者", url: new URL("/about", Astro.site).href },
  })} />
  <div class="py-4">
    <Breadcrumbs
      items={[
        { label: "ニュース", href: "/news" },
        { label: entry.data.title },
      ]}
    />

    <article
      class="bg-card rounded-3xl shadow-2xl overflow-hidden border border-border-dim"
    >
      <header class="bg-gray-900 p-5 sm:p-8 md:p-12 text-white relative">
        <div class="relative z-10 max-w-3xl">
          <div class="flex items-center gap-4 mb-6">
            <span class="bg-yellow-400 text-black text-[11px] font-black px-3 py-1 rounded uppercase tracking-widest">
              {entry.data.category || "NEWS"}
            </span>
            <time datetime={articlePublishedAt} class="text-sm text-gray-400 font-bold font-mono">
              {formatDate(entry.data.pubDate)}
            </time>
          </div>
          <h1 class="text-2xl md:text-4xl lg:text-5xl font-black mb-6 leading-tight tracking-tighter break-words">
            {entry.data.title}
          </h1>
          {
            entry.data.tags && (
              <div class="flex flex-wrap gap-2">
                {entry.data.tags.map((tag: string) => (
                  <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400 border border-gray-700 px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="p-5 sm:p-8 md:p-12">
        <div
          class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-black prose-headings:text-foreground prose-a:text-yellow-400 hover:prose-a:text-yellow-500 transition-colors prose-table:w-full prose-th:bg-gray-800 prose-th:text-white prose-th:font-bold prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-gray-700 prose-tr:border-b prose-tr:border-gray-700 prose-thead:border-b prose-thead:border-gray-600"
        >
          <Content />
        </div>

        {slotKind && <AffiliateSlot kind={slotKind} ids={isMatchReview ? ["jsports", "dazn"] : undefined} />}

        <AuthorBox />

        <div class="mt-16">
          <MagazineBanner />
        </div>

        <footer class="mt-16 pt-8 border-t border-border-dim text-center">
          <a
            href="/news"
            class="inline-flex items-center gap-2 text-yellow-400 font-bold hover:translate-x-[-4px] transition-transform"
          >
            ← 記事一覧に戻る
          </a>
        </footer>
      </div>
    </article>
  </div>
  {hasInstagram && <script async src="https://www.instagram.com/embed.js"></script>}
</Layout>

<style is:global>
  /* 本文中のリンク（選手・チーム・代表ページ）を平文と明確に区別する。
     色＋下線＋太字。テーマに依存しない下線を主要な手がかりにする。 */
  article .prose a[href^="/players/"],
  article .prose a[href^="/teams/"],
  article .prose a[href^="/national-teams/"] {
    color: #ca8a04;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #facc15;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  article .prose a[href^="/players/"]:hover,
  article .prose a[href^="/teams/"]:hover,
  article .prose a[href^="/national-teams/"]:hover {
    color: #eab308;
  }
  :root.dark article .prose a[href^="/players/"],
  :root.dark article .prose a[href^="/teams/"],
  :root.dark article .prose a[href^="/national-teams/"] {
    color: #fde047;
  }
</style>
