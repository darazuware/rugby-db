---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getTeamSlug } from "../../utils/team_utils";
import AffiliateBanner from "../../components/AffiliateBanner.astro";

export async function getStaticPaths() {
  const players = await getCollection("players");
  return players.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const isLeagueOne =
  entry.data.league === "league-one" || entry.data.league === "leagueone";
---

<Layout
  title={`${isLeagueOne ? entry.data.title : entry.data.name_en} (${
    isLeagueOne ? entry.data.name_en : entry.data.title
  }) | ラグビー選手名鑑 | RUGBY PICKS`}
  description={`${entry.data.team}所属、${entry.data.position}。身長${
    entry.data.height
  }cm、体重${
    entry.data.weight
  }kg。${entry.data.league?.toUpperCase()} の注目選手、${entry.data.title}（${
    entry.data.name_en
  }）のプロフィールと詳細スタッツ。`}
>
  <main class="bg-background min-h-screen py-12 px-4">
    <div
      class="max-w-4xl mx-auto bg-card rounded-3xl shadow-2xl overflow-hidden border border-border-dim"
    >
      <div class="bg-gray-900 p-8 text-white relative">
        <div class="absolute top-0 right-0 p-8 opacity-10">
          <span class="text-9xl font-black">{entry.data.position}</span>
        </div>

        <div class="relative z-10">
          <a
            href="/players"
            class="inline-flex items-center text-yellow-400 font-bold mb-6 hover:translate-x-1 transition-transform"
          >
            ← 選手一覧に戻る
          </a>
          {
            isLeagueOne ? (
              <>
                <h1 class="text-5xl font-black mb-2">{entry.data.title}</h1>
                {entry.data.name_en &&
                  entry.data.name_en !== entry.data.title && (
                    <p class="text-xl text-gray-400 font-bold uppercase tracking-widest">
                      {entry.data.name_en}
                    </p>
                  )}
              </>
            ) : (
              <>
                <h1 class="text-6xl md:text-7xl font-black mb-2 uppercase tracking-tighter">
                  {entry.data.name_en || entry.data.title}
                </h1>
                {entry.data.title &&
                  entry.data.title !== entry.data.name_en && (
                    <p class="text-2xl text-gray-400 font-bold tracking-widest italic">
                      {entry.data.title}
                    </p>
                  )}
              </>
            )
          }
        </div>
      </div>

      <div class="p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <div class="space-y-6">
            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">ポジション</span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >POSITION</span
                >
              </div>
              <a
                href={`/players?position=${entry.data.position}`}
                class="font-black text-foreground text-xl tracking-tighter hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4"
              >
                {entry.data.position}
              </a>
            </div>

            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">所属チーム</span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >CURRENT TEAM</span
                >
              </div>
              <a
                href={`/teams/${
                  entry.data.league || "league-one"
                }/${getTeamSlug(entry.data.team)}/`}
                class="font-black text-yellow-600 text-lg tracking-tight text-right ml-4 leading-tight hover:text-foreground transition-colors underline decoration-yellow-50 dark:decoration-yellow-900/30 hover:decoration-foreground decoration-2 underline-offset-4"
              >
                {entry.data.team}
              </a>
            </div>

            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">年齢</span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >AGE</span
                >
              </div>
              <a
                href={`/players?search=${encodeURIComponent(
                  entry.data.age + "歳"
                )}`}
                class="font-black text-foreground text-xl tracking-tighter hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4"
              >
                {entry.data.age}<span class="text-xs ml-1">歳</span>
              </a>
            </div>

            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">生年月日</span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >BIRTH DATE</span
                >
              </div>
              <span class="font-black text-foreground text-lg tracking-tighter"
                >{entry.data.birth_date}</span
              >
            </div>
          </div>

          <div class="space-y-6">
            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">身長 / 体重</span
                >
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >HEIGHT / WEIGHT</span
                >
              </div>
              <div class="flex gap-2">
                <a
                  href={`/players?search=${encodeURIComponent(
                    entry.data.height + "cm"
                  )}`}
                  class="font-black text-foreground text-xl tracking-tighter hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4"
                >
                  {entry.data.height}<span class="text-xs mx-0.5 text-foreground/20"
                    >cm</span
                  >
                </a>
                <span class="text-foreground/10">/</span>
                <a
                  href={`/players?search=${encodeURIComponent(
                    entry.data.weight + "kg"
                  )}`}
                  class="font-black text-foreground text-xl tracking-tighter hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4"
                >
                  {entry.data.weight}<span class="text-xs ml-0.5 text-foreground/20"
                    >kg</span
                  >
                </a>
              </div>
            </div>

            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">出身高校</span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >HIGH SCHOOL</span
                >
              </div>
              <a
                href={`/players?search=${encodeURIComponent(
                  entry.data.high_school
                )}`}
                class="font-black text-foreground text-base text-right leading-tight ml-4 hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4"
              >
                {entry.data.high_school || "---"}
              </a>
            </div>

            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">出身大学</span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                  >UNIVERSITY</span
                >
              </div>
              <a
                href={`/players?search=${encodeURIComponent(
                  entry.data.university
                )}`}
                class="font-black text-foreground text-base text-right leading-tight ml-4 hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4"
              >
                {entry.data.university || "---"}
              </a>
            </div>

            <div
              class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3 group/item"
            >
              <div class="flex flex-col">
                <span class="font-black text-foreground text-sm">
                  {
                    isLeagueOne
                      ? "代表キャップ数（リーグワン）"
                      : "代表キャップ数"
                  }
                </span>
                <span
                  class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                >
                  {isLeagueOne ? "TEST CAPS (LEAGUE ONE)" : "TEST CAPS"}
                </span>
              </div>
              <span class="font-black text-foreground text-lg tracking-tighter">
                {entry.data.caps || "0"}
                {
                  isLeagueOne && (
                    <span class="text-xs text-foreground/40 mx-1 ml-2">
                      ({entry.data.league_one_caps || "0"})
                    </span>
                  )
                }
              </span>
            </div>
          </div>
        </div>

        {/* アフィリエイトセクション */}
        <div class="mb-12 px-8">
          <AffiliateBanner league={entry.data.league} />
        </div>

        <div
          class="prose dark:prose-invert max-w-none prose-headings:font-black prose-headings:text-foreground bg-background p-8 rounded-2xl border border-border-dim"
        >
          <h2 class="text-2xl font-black mb-6">キャリア遍歴・詳細</h2>
          <Content />
        </div>
      </div>
    </div>
  </main>
</Layout>
