---
/**
 * /players/[slug] — master (SSOT) 駆動の選手ページ（04, 06）。
 *
 * データ源は data/master/players/*.json のみ。master.ts 経由で取得し、
 * player_merges を適用済み（重複人物は1ページに統合、getStaticPaths から除外）。
 * 本文は playerText.ts のテンプレ生成文のみ（自由記述禁止・null項目は出さない）。
 */
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JSONLD from "../../components/JSONLD.astro";
import AdSenseUnit from "../../components/AdSenseUnit.astro";
import AffiliateBanner from "../../components/AffiliateBanner.astro";
import PlayerAvatar from "../../components/PlayerAvatar.astro";
import { getTeamSlug } from "../../utils/team_utils";
import {
  canHaveIndividualPlayerPage,
  getAllPlayers,
  getTeamById,
  teamDisplayName,
  type Player,
  type Team,
} from "../../lib/master";
import { buildPlayerBioSentences, calcAge } from "../../lib/playerText";
import { positionJa } from "../../lib/positions";

export async function getStaticPaths() {
  const players = await getAllPlayers();
  // 10のポリシー: 高校生（league="highschool"）の個別ページは生成しない。
  // 学校ページ（P5-4）内の一覧行のみで表示する。
  return players.filter(canHaveIndividualPlayerPage).map((player) => ({
    params: { slug: player.slug },
    props: { player },
  }));
}

const { player } = Astro.props as { player: Player };

const team: Team | undefined = player.team_id
  ? await getTeamById(player.team_id)
  : undefined;
const teamName = teamDisplayName(team);
const teamColor: string | null =
  (team?.colors?.primary as string | undefined) ??
  (team?.colors?.main as string | undefined) ??
  null;

const posJa = positionJa(player.position);
const age = calcAge(player.birthdate);
const bioSentences = buildPlayerBioSentences(player, { teamName });

// 表示名: 日本語優先。サブは読み仮名 or 英語表記（メインと異なる場合のみ）。
const mainName = player.name_ja || player.name_en || player.slug;
const subCandidate = player.name_kana || player.name_en || null;
const subName = subCandidate && subCandidate !== mainName ? subCandidate : null;
const prefersJa = !!player.name_ja;

// 出典表示名（信頼性の明示: 04）
const SOURCE_LABEL: Record<string, string> = {
  "league-one.jp": "リーグワン公式",
  "all.rugby": "all.rugby",
  jrfu: "日本ラグビーフットボール協会",
};
const sourceLabel = SOURCE_LABEL[player.source] ?? player.source;
const updatedDate = (player.scraped_at || "").slice(0, 10);

// チームページ遷移（teams ルートは P2-3 で master 化予定。現行の [league]/[slug] に合わせる）
const leagueSegment = player.league.startsWith("league-one")
  ? "league-one"
  : player.league;
const teamHref =
  teamName != null ? `/teams/${leagueSegment}/${getTeamSlug(teamName)}/` : null;

// 国旗（nationality 表示用）
const FLAG_MAP: Record<string, string> = {
  日本: "🇯🇵",
  Japan: "🇯🇵",
  オーストラリア: "🇦🇺",
  Australia: "🇦🇺",
  ニュージーランド: "🇳🇿",
  "New Zealand": "🇳🇿",
  南アフリカ: "🇿🇦",
  "South Africa": "🇿🇦",
  フィジー: "🇫🇯",
  Fiji: "🇫🇯",
  トンガ: "🇹🇴",
  Tonga: "🇹🇴",
  サモア: "🇼🇸",
  Samoa: "🇼🇸",
  フランス: "🇫🇷",
  France: "🇫🇷",
  イングランド: "🏴󠁧󠁢󠁥󠁮󠁧󠁿",
  England: "🏴󠁧󠁢󠁥󠁮󠁧󠁿",
  ウェールズ: "🏴󠁧󠁢󠁷󠁬󠁳󠁿",
  Wales: "🏴󠁧󠁢󠁷󠁬󠁳󠁿",
  スコットランド: "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
  Scotland: "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
  アイルランド: "🇮🇪",
  Ireland: "🇮🇪",
  イタリア: "🇮🇹",
  Italy: "🇮🇹",
  アルゼンチン: "🇦🇷",
  Argentina: "🇦🇷",
  ジョージア: "🇬🇪",
  Georgia: "🇬🇪",
};
const flagFor = (c: string): string => FLAG_MAP[c] ?? "";

// 統計行（値が null のものは出さない = 04「null項目の文は出さない」）
interface StatRow {
  label: string;
  sub: string;
  value: string | null;
  href?: string | null;
  accent?: boolean;
}
const allStats: StatRow[] = [
  {
    label: "ポジション",
    sub: "POSITION",
    value: posJa ?? player.position,
    href: player.position
      ? `/players?position=${encodeURIComponent(player.position)}`
      : null,
  },
  {
    label: "所属チーム",
    sub: "CURRENT TEAM",
    value: teamName,
    href: teamHref,
    accent: true,
  },
  { label: "年齢", sub: "AGE", value: age != null ? `${age}歳` : null },
  { label: "生年月日", sub: "BIRTH DATE", value: player.birthdate },
  {
    label: "身長",
    sub: "HEIGHT",
    value: player.height_cm != null ? `${player.height_cm}cm` : null,
  },
  {
    label: "体重",
    sub: "WEIGHT",
    value: player.weight_kg != null ? `${player.weight_kg}kg` : null,
  },
  {
    label: "リーグ通算",
    sub: "LEAGUE CAPS",
    value: player.league_caps != null ? `${player.league_caps}` : null,
  },
  {
    label: "代表キャップ",
    sub: "CAPS",
    value: player.caps ? `${player.caps.team} ${player.caps.count}` : null,
  },
  {
    label: "国籍",
    sub: "NATIONALITY",
    value: player.nationality.length ? player.nationality.join("・") : null,
  },
];
const stats = allStats.filter((s) => s.value != null && s.value !== "");
const half = Math.ceil(stats.length / 2);
const statsLeft = stats.slice(0, half);
const statsRight = stats.slice(half);

// キャリア（career[] があれば所属チームを列挙表示。事実のみ）
const careerEntries = player.career.filter((c) => !!c.team);

// JSONLD 互換データ
const jsonldData = {
  title: mainName,
  name_en: player.name_en,
  team: teamName,
  position: posJa ?? player.position,
  height: player.height_cm,
  weight: player.weight_kg,
  birth_date: player.birthdate,
  nationality: player.nationality[0] ?? null,
};

const metaDesc = [
  teamName ? `${teamName}所属` : null,
  posJa ?? player.position,
  player.height_cm != null ? `身長${player.height_cm}cm` : null,
  player.weight_kg != null ? `体重${player.weight_kg}kg` : null,
]
  .filter(Boolean)
  .join("、");
---

<Layout
  title={`${mainName}${subName ? ` (${subName})` : ""} | ラグビー選手名鑑 | RUGBY PICKS`}
  description={`${mainName}のプロフィール。${metaDesc}。出典データに基づく正確な選手情報。`}
>
  <JSONLD type="SportsPlayer" data={jsonldData} />
  <div class="py-4">
    <Breadcrumbs items={[{ label: "選手名鑑", href: "/players" }, { label: mainName }]} />

    <div class="bg-card rounded-3xl shadow-2xl overflow-hidden border border-border-dim">
      {/* ヘッダー */}
      <div class="bg-gray-900 p-8 text-white relative">
        {player.position && (
          <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
            <span class="text-9xl font-black">{player.position}</span>
          </div>
        )}

        <div class="relative z-10">
          <a
            href="/players"
            class="inline-flex items-center text-yellow-400 font-bold mb-6 hover:translate-x-1 transition-transform"
          >
            ← 選手一覧に戻る
          </a>

          <div class="flex items-center gap-6">
            <PlayerAvatar
              name={mainName}
              color={teamColor}
              size={96}
              class="rounded-2xl shadow-xl shrink-0"
              playerId={player.id}
              isMinor={player.is_minor}
            />
            <div>
              <h1 class="text-4xl md:text-5xl font-black mb-2">{mainName}</h1>
              {subName && (
                <p
                  class={
                    prefersJa
                      ? "text-xl text-gray-400 font-bold uppercase tracking-widest"
                      : "text-xl text-gray-300 font-bold tracking-widest italic"
                  }
                >
                  {subName}
                </p>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* 本体 */}
      <div class="p-8">
        {/* 統計グリッド */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          {[statsLeft, statsRight].map((col) => (
            <div class="space-y-6">
              {col.map((s) => (
                <div class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3">
                  <div class="flex flex-col">
                    <span class="font-black text-foreground text-sm">{s.label}</span>
                    <span
                      class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                    >
                      {s.sub}
                    </span>
                  </div>
                  {s.href ? (
                    <a
                      href={s.href}
                      class={`font-black tracking-tighter hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4 text-right ml-4 ${
                        s.accent ? "text-yellow-600 text-lg" : "text-foreground text-xl"
                      }`}
                    >
                      {s.value}
                    </a>
                  ) : (
                    <span
                      class={`font-black tracking-tighter text-right ml-4 ${
                        s.accent ? "text-yellow-600 text-lg" : "text-foreground text-xl"
                      }`}
                    >
                      {s.value}
                    </span>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>

        {/* 国旗（国籍があれば） */}
        {player.nationality.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {player.nationality.map((c) => (
              <span
                class="inline-flex items-center gap-2 bg-border-dim/10 rounded-full px-3 py-1 text-sm font-bold text-foreground"
              >
                {flagFor(c) && <span class="text-lg leading-none">{flagFor(c)}</span>}
                {c}
              </span>
            ))}
          </div>
        )}

        {/* 本文（テンプレ生成・自由記述なし） */}
        {bioSentences.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">プロフィール</h2>
            <p class="text-foreground/80 leading-relaxed">{bioSentences.join("")}</p>
          </section>
        )}

        {/* キャリア（career[] があれば） */}
        {careerEntries.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">これまでの所属</h2>
            <ul class="space-y-2">
              {careerEntries.map((c) => (
                <li class="flex items-center gap-3 border-b border-border-dim/20 pb-2">
                  <span class="font-bold text-foreground">{c.team}</span>
                  {(c.from != null || c.to != null) && (
                    <span class="text-sm text-foreground/50 font-mono">
                      {c.from ?? "?"}–{c.to ?? "現在"}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        <div class="my-8">
          <AffiliateBanner />
        </div>
        <div class="my-8">
          <AdSenseUnit />
        </div>

        {/* 最終更新 / 出典（信頼性の明示: 04） */}
        <div class="mt-8 pt-4 border-t border-border-dim/20 text-[11px] text-foreground/40 font-bold">
          {updatedDate && <span>最終更新: {updatedDate}</span>}
          {updatedDate && <span class="mx-2">/</span>}
          <span>出典: </span>
          <a
            href={player.source_url}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="underline hover:text-yellow-600"
          >
            {sourceLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
