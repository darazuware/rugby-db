---
/**
 * /players/[slug] — master (SSOT) 駆動の選手ページ（04, 06）。
 *
 * データ源は data/master/players/*.json のみ。master.ts 経由で取得し、
 * player_merges を適用済み（重複人物は1ページに統合、getStaticPaths から除外）。
 * 本文は playerText.ts のテンプレ生成文のみ（自由記述禁止・null項目は出さない）。
 */
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JSONLD from "../../components/JSONLD.astro";
import AdSenseUnit from "../../components/AdSenseUnit.astro";
import AffiliateBanner from "../../components/AffiliateBanner.astro";
import MagazineBanner from "../../components/MagazineBanner.astro";
import PlayerAvatar from "../../components/PlayerAvatar.astro";
import { getTeamSlug } from "../../utils/team_utils";
import { kanjiVariants } from "../../utils/kanjiVariants";
import {
  canHaveIndividualPlayerPage,
  getAllPlayers,
  getAllSchools,
  getPlayerEpisodes,
  getTeamById,
  teamDisplayName,
  type Player,
  type School,
  type Team,
} from "../../lib/master";
import { buildPlayerBioSentences, calcAge, isEnrolled } from "../../lib/playerText";
import { positionJa } from "../../lib/positions";
import { getSchoolmates, playerBadges, type SchoolmateRelation } from "../../lib/connections";
import { getRelatedNews } from "../../lib/relatedNews";
import igEmbeds from "../../../data/manual/instagram_embeds.json";

export async function getStaticPaths() {
  const players = await getAllPlayers();

  // カタカナ読みの補完用（読み取り専用）。
  // data/master の name_ja/name_kana は海外選手の多くで null のため、
  // 旧レガシーコレクション(src/content/players/**/*.md)に残るカタカナ表記を
  // slug一致で補完的に参照する。data/master 自体は書き換えない。
  const legacyPlayerEntries = await getCollection("players");
  const legacyKanaBySlug = new Map<string, string>();
  for (const entry of legacyPlayerEntries) {
    // Note: frontmatter `slug` is a reserved content-collection key — Astro
    // uses it to override `entry.slug` and strips it out of `entry.data`.
    const slug = entry.slug;
    const kana = entry.data.name_ja;
    if (slug && kana && !legacyKanaBySlug.has(slug)) {
      legacyKanaBySlug.set(slug, kana);
    }
  }

  // 10のポリシー: 高校生（league="highschool"）の個別ページは生成しない。
  // 学校ページ（P5-4）内の一覧行のみで表示する。
  return players.filter(canHaveIndividualPlayerPage).map((player) => ({
    params: { slug: player.slug },
    props: { player, legacyKana: legacyKanaBySlug.get(player.slug) ?? null },
  }));
}

const { player, legacyKana } = Astro.props as { player: Player; legacyKana: string | null };

const team: Team | undefined = player.team_id
  ? await getTeamById(player.team_id)
  : undefined;
const teamName = teamDisplayName(team);
const teamColor: string | null =
  (team?.colors?.primary as string | undefined) ??
  (team?.colors?.main as string | undefined) ??
  null;

// 出身校（education から高校/大学を1件ずつ。is_minor は出さない: 10のポリシー）
const eduHs = !player.is_minor
  ? player.education.find((e) => e.type === "hs")
  : undefined;
const eduUniv = !player.is_minor
  ? player.education.find((e) => e.type === "univ")
  : undefined;

const posJa = positionJa(player.position);
const age = calcAge(player.birthdate);
const bioSentences = buildPlayerBioSentences(player, { teamName });

// エピソード（JRFU公式/チーム公式/リーグワン公式/主要メディアからのスクレイピング事実のみ。
// 出典は本文に表示しない: feedback_hide_sources）
const episodes = await getPlayerEpisodes(player.id);
const episodeCategoryOrder = ["経歴", "プレースタイル", "人物像", "名言"] as const;
const episodesByCategory = episodeCategoryOrder
  .map((category) => ({
    category,
    facts: (episodes?.facts ?? []).filter((f) => f.category === category),
  }))
  .filter((g) => g.facts.length > 0);

// 検証済み公式Instagram（本人アカウントのみ・data/manual/instagram_embeds.json）
const igEmbed = (igEmbeds as Record<string, { account?: string; permalink?: string }>)[player.slug];

// つながりグラフ（P5-4, 10）: 出身校ベースの同期/先輩後輩 + 年代別/セブンズ代表バッジ。
// 学校→選手インデックスはビルド中一度だけ構築される（lib/connections.ts）。
const badges = playerBadges(player);
const schoolGroups = await getSchoolmates(player);
// 関連ニュース（公開済み記事本文の /players/{slug}/ リンクを逆引き。新規文章生成なし）
const relatedNews = await getRelatedNews(player.slug);
// バナー疲れ防止: 視聴サービス/雑誌バナーは同時表示せず、選手ごとに固定で出し分ける
const showMagazineBanner =
  player.slug.split("").reduce((acc, c) => acc + c.charCodeAt(0), 0) % 2 === 0;
const formatNewsDate = (d: Date) =>
  d.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" });
const allSchools: School[] = schoolGroups.length > 0 ? await getAllSchools() : [];
const schoolById = new Map(allSchools.map((s) => [s.id, s]));
const RELATION_LABEL: Record<SchoolmateRelation, string> = {
  senior: "先輩",
  junior: "後輩",
  sync: "同期",
  unknown: "同校",
};

// 表示名ロジック。
// 1. 漢字の日本語名（name_ja）があればそれを最優先でメイン表示（従来通り）。
// 2. 漢字名が無く、カタカナ表記が判明している場合（name_kana、または
//    片仮名のname_ja、無ければ旧レガシーコレクションの補完データ）は
//    「カタカナ（English Name）」の形式でメイン表示する。
// 3. どちらも無ければ英語表記→slugへフォールバック（従来通り）。
const KATAKANA_RE = /^[゠-ヿー・\s]+$/;
const isKatakana = (s: string | null | undefined): s is string =>
  !!s && KATAKANA_RE.test(s);

const hasKanjiJaName = !!player.name_ja && !isKatakana(player.name_ja);
const kanaName =
  (isKatakana(player.name_kana) ? player.name_kana : null) ??
  (isKatakana(player.name_ja) ? player.name_ja : null) ??
  (isKatakana(legacyKana) ? legacyKana : null);
const englishName = player.name_en || null;

let mainName: string;
let subName: string | null;
// schema.org Person の name には英語表記を含めずカタカナ/漢字のみを渡す。
let schemaName: string;

if (hasKanjiJaName) {
  mainName = player.name_ja as string;
  const subCandidate = player.name_kana || player.name_en || null;
  subName = subCandidate && subCandidate !== mainName ? subCandidate : null;
  schemaName = mainName;
} else if (kanaName) {
  mainName =
    englishName && englishName !== kanaName ? `${kanaName}（${englishName}）` : kanaName;
  subName = null;
  schemaName = kanaName;
} else {
  mainName = englishName || player.slug;
  subName = null;
  schemaName = mainName;
}
const prefersJa = hasKanjiJaName || !!kanaName;

const updatedDate = (player.scraped_at || "").slice(0, 10);

// チームページ遷移（teams ルートは P2-3 で master 化予定。現行の [league]/[slug] に合わせる）
const leagueSegment = player.league.startsWith("league-one")
  ? "league-one"
  : player.league;
// MLR はチーム詳細ページ（legacy data/teams.json 駆動）を持たないため、
// チーム名はテキスト表示にとどめてリンク切れを避ける（選手個別ページは master から生成）。
const HAS_TEAM_PAGES = leagueSegment !== "mlr";
const teamHref =
  teamName != null && HAS_TEAM_PAGES
    ? `/teams/${leagueSegment}/${getTeamSlug(teamName)}/`
    : null;

// 国旗（nationality 表示用）
const FLAG_MAP: Record<string, string> = {
  日本: "🇯🇵",
  Japan: "🇯🇵",
  オーストラリア: "🇦🇺",
  Australia: "🇦🇺",
  ニュージーランド: "🇳🇿",
  "New Zealand": "🇳🇿",
  南アフリカ: "🇿🇦",
  "South Africa": "🇿🇦",
  フィジー: "🇫🇯",
  Fiji: "🇫🇯",
  トンガ: "🇹🇴",
  Tonga: "🇹🇴",
  サモア: "🇼🇸",
  Samoa: "🇼🇸",
  フランス: "🇫🇷",
  France: "🇫🇷",
  イングランド: "🏴󠁧󠁢󠁥󠁮󠁧󠁿",
  England: "🏴󠁧󠁢󠁥󠁮󠁧󠁿",
  ウェールズ: "🏴󠁧󠁢󠁷󠁬󠁳󠁿",
  Wales: "🏴󠁧󠁢󠁷󠁬󠁳󠁿",
  スコットランド: "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
  Scotland: "🏴󠁧󠁢󠁳󠁣󠁴󠁿",
  アイルランド: "🇮🇪",
  Ireland: "🇮🇪",
  イタリア: "🇮🇹",
  Italy: "🇮🇹",
  アルゼンチン: "🇦🇷",
  Argentina: "🇦🇷",
  ジョージア: "🇬🇪",
  Georgia: "🇬🇪",
};
const flagFor = (c: string): string => FLAG_MAP[c] ?? "";

// 統計行（値が null のものは出さない = 04「null項目の文は出さない」）
interface StatRow {
  label: string;
  sub: string;
  value: string | null;
  href?: string | null;
  accent?: boolean;
}
const allStats: StatRow[] = [
  {
    label: "ポジション",
    sub: "POSITION",
    value: posJa ?? player.position,
    href: player.position
      ? `/players?position=${encodeURIComponent(player.position)}`
      : null,
  },
  {
    label: "所属チーム",
    sub: "CURRENT TEAM",
    value: teamName,
    href: teamHref,
    accent: true,
  },
  { label: "年齢", sub: "AGE", value: age != null ? `${age}歳` : null },
  { label: "生年月日", sub: "BIRTH DATE", value: player.birthdate },
  {
    label: "身長",
    sub: "HEIGHT",
    value: player.height_cm != null ? `${player.height_cm}cm` : null,
  },
  {
    label: "体重",
    sub: "WEIGHT",
    value: player.weight_kg != null ? `${player.weight_kg}kg` : null,
  },
  {
    label: "リーグ通算",
    sub: "LEAGUE CAPS",
    value: player.league_caps != null ? `${player.league_caps}` : null,
  },
  {
    label: "代表キャップ",
    sub: "CAPS",
    value: player.caps ? `${player.caps.team} ${player.caps.count}` : null,
  },
  {
    label: "国籍",
    sub: "NATIONALITY",
    value: player.nationality.length ? player.nationality.join("・") : null,
  },
  {
    label: eduHs && isEnrolled(eduHs.grad_year) ? "在学高校" : "出身高校",
    sub: "HIGH SCHOOL",
    value: eduHs?.name_raw ?? null,
    href: eduHs?.school_id ? `/schools/${eduHs.school_id}` : null,
  },
  {
    label: eduUniv && isEnrolled(eduUniv.grad_year) ? "在学大学" : "出身大学",
    sub: "UNIVERSITY",
    value: eduUniv?.name_raw ?? null,
    href: eduUniv?.school_id ? `/schools/${eduUniv.school_id}` : null,
  },
];
const stats = allStats.filter((s) => s.value != null && s.value !== "");
const half = Math.ceil(stats.length / 2);
const statsLeft = stats.slice(0, half);
const statsRight = stats.slice(half);

// キャリア（career[] があれば所属チームを列挙表示。事実のみ）
const careerEntries = player.career.filter((c) => !!c.team);

// JSONLD 互換データ
const jsonldData = {
  title: schemaName,
  name_en: player.name_en,
  team: teamName,
  position: posJa ?? player.position,
  height: player.height_cm,
  weight: player.weight_kg,
  birth_date: player.birthdate,
  nationality: player.nationality[0] ?? null,
};

const metaDesc = [
  teamName ? `${teamName}所属` : null,
  posJa ?? player.position,
  player.height_cm != null ? `身長${player.height_cm}cm` : null,
  player.weight_kg != null ? `体重${player.weight_kg}kg` : null,
]
  .filter(Boolean)
  .join("、");

// 検索・IME変換ミスからの流入を拾うための表記バリエーション（スペース有無・異体字）。
// 事実の創作ではなく同一人物の別表記のみを併記する。
const nameVariants = [
  schemaName.includes(" ") ? schemaName.replace(/\s+/g, "") : null,
  ...kanjiVariants(schemaName),
].filter((v): v is string => !!v && v !== mainName);
const nameVariantsText = nameVariants.length
  ? `（${nameVariants.join("、")}）`
  : "";
---

<Layout
  title={`${mainName}${subName ? ` (${subName})` : ""} | ラグビー選手名鑑 | RUGBY PICKS`}
  description={`${mainName}${nameVariantsText}のプロフィール。${metaDesc}。正確な選手情報をお届けします。`}
>
  <JSONLD type="SportsPlayer" data={jsonldData} />
  <div class="py-4">
    <Breadcrumbs items={[{ label: "選手名鑑", href: "/players" }, { label: mainName }]} />

    {player.slug === "saimoni-vunilagi-484310" && (
      <a
        href="/notice/saimoni-vunilagi"
        class="group flex items-center justify-between gap-4 mb-4 px-6 py-4 bg-card/50 border border-border-dim/50 rounded-2xl hover:border-yellow-400/50 transition-all"
      >
        <span class="text-sm font-bold text-foreground/60 group-hover:text-foreground transition-colors">
          サイモニ・ヴニランギ選手のご逝去に際し、謹んでお悔やみを申し上げます。
        </span>
        <span class="text-xs font-black uppercase tracking-widest text-foreground/30 group-hover:text-yellow-400 transition-colors shrink-0">詳細 →</span>
      </a>
    )}

    <div class="bg-card rounded-3xl shadow-2xl overflow-hidden border border-border-dim">
      {/* ヘッダー */}
      <div class="bg-gray-900 p-8 text-white relative">
        {player.position && (
          <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
            <span class="text-9xl font-black">{player.position}</span>
          </div>
        )}

        <div class="relative z-10">
          <a
            href="/players"
            class="inline-flex items-center text-yellow-400 font-bold mb-6 hover:translate-x-1 transition-transform"
          >
            ← 選手一覧に戻る
          </a>

          <div class="flex items-center gap-6">
            <PlayerAvatar
              name={mainName}
              color={teamColor}
              size={96}
              class="rounded-2xl shadow-xl shrink-0"
              playerId={player.id}
              isMinor={player.is_minor}
            />
            <div>
              <h1 class="text-4xl md:text-5xl font-black mb-2">{mainName}</h1>
              {subName && (
                <p
                  class={
                    prefersJa
                      ? "text-xl text-gray-400 font-bold uppercase tracking-widest"
                      : "text-xl text-gray-300 font-bold tracking-widest italic"
                  }
                >
                  {subName}
                </p>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* 本体 */}
      <div class="p-8">
        {/* 統計グリッド */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
          {[statsLeft, statsRight].map((col) => (
            <div class="space-y-6">
              {col.map((s) => (
                <div class="flex justify-between items-end border-b-2 border-border-dim/20 pb-3">
                  <div class="flex flex-col">
                    <span class="font-black text-foreground text-sm">{s.label}</span>
                    <span
                      class="font-bold text-foreground/40 uppercase text-[10px] tracking-widest leading-none"
                    >
                      {s.sub}
                    </span>
                  </div>
                  {s.href ? (
                    <a
                      href={s.href}
                      class={`font-black tracking-tighter hover:text-yellow-600 transition-colors underline decoration-border-dim/50 hover:decoration-yellow-400 decoration-2 underline-offset-4 text-right ml-4 ${
                        s.accent ? "text-yellow-600 text-lg" : "text-foreground text-xl"
                      }`}
                    >
                      {s.value}
                    </a>
                  ) : (
                    <span
                      class={`font-black tracking-tighter text-right ml-4 ${
                        s.accent ? "text-yellow-600 text-lg" : "text-foreground text-xl"
                      }`}
                    >
                      {s.value}
                    </span>
                  )}
                </div>
              ))}
            </div>
          ))}
        </div>

        {/* バッジ（年代別代表・セブンズ代表・代表キャップ。squad/caps 由来のみ） */}
        {badges.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {badges.map((b) => (
              <span class="inline-flex items-center bg-yellow-400/10 text-yellow-600 rounded-full px-3 py-1 text-xs font-black uppercase tracking-widest">
                {b.label}
              </span>
            ))}
          </div>
        )}

        {/* 国旗（国籍があれば） */}
        {player.nationality.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {player.nationality.map((c) => (
              <span
                class="inline-flex items-center gap-2 bg-border-dim/10 rounded-full px-3 py-1 text-sm font-bold text-foreground"
              >
                {flagFor(c) && <span class="text-lg leading-none">{flagFor(c)}</span>}
                {c}
              </span>
            ))}
          </div>
        )}

        {/* 関連ニュース（公開済み記事へのリンクのみ。要約・トピック文の新規生成なし） */}
        {relatedNews.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">注目トピックス</h2>
            <ul class="space-y-2">
              {relatedNews.map((n) => (
                <li>
                  <a
                    href={`/news/${n.slug}/`}
                    class="flex items-center justify-between gap-4 p-4 rounded-xl bg-background border border-border-dim hover:border-yellow-400/50 transition-colors group"
                  >
                    <span class="font-bold text-foreground group-hover:text-yellow-600 transition-colors leading-snug">
                      {n.title}
                    </span>
                    <span class="text-xs text-foreground/40 font-mono shrink-0">
                      {formatNewsDate(n.pubDate)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* 本文（テンプレ生成・自由記述なし） */}
        {bioSentences.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">プロフィール</h2>
            <p class="text-foreground/80 leading-relaxed">{bioSentences.join("")}</p>
          </section>
        )}

        {/* エピソード（公式・主要メディア取材ベース。出典は非掲載） */}
        {episodesByCategory.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">エピソード</h2>
            {episodesByCategory.map((group) => (
              <div class="mb-5 last:mb-0">
                <h3 class="text-sm font-bold text-foreground/60 mb-2">{group.category}</h3>
                <ul class="space-y-2">
                  {group.facts.map((f) => (
                    <li class="text-foreground/80 leading-relaxed text-sm before:content-['・'] before:mr-1 before:text-foreground/40">
                      {f.fact}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )}

        {/* 公式Instagram（検証済み本人アカウントのみ） */}
        {igEmbed?.permalink && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">Instagram</h2>
            {igEmbed.account && (
              <p class="text-foreground/60 text-sm mb-3">
                公式アカウント{" "}
                <a
                  href={`https://www.instagram.com/${igEmbed.account}/`}
                  class="text-yellow-600 font-bold hover:text-yellow-500"
                  target="_blank"
                  rel="noopener"
                >@{igEmbed.account}</a>
              </p>
            )}
            <blockquote
              class="instagram-media"
              data-instgrm-permalink={igEmbed.permalink}
              data-instgrm-version="14"
              style="max-width:540px;width:100%;margin:0 auto;"
            ></blockquote>
            <script async src="https://www.instagram.com/embed.js"></script>
          </section>
        )}

        {/* キャリア（career[] があれば） */}
        {careerEntries.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">これまでの所属</h2>
            <ul class="space-y-2">
              {careerEntries.map((c) => (
                <li class="flex items-center gap-3 border-b border-border-dim/20 pb-2">
                  <span class="font-bold text-foreground">{c.team}</span>
                  {(c.from != null || c.to != null) && (
                    <span class="text-sm text-foreground/50 font-mono">
                      {c.from ?? "?"}–{c.to ?? "現在"}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* つながりグラフ（P5-4, 10）: 出身校の同期・先輩後輩 */}
        {schoolGroups.length > 0 && (
          <section class="mb-10">
            <h2 class="text-lg font-black text-foreground mb-3">同じ出身校の選手</h2>
            <div class="space-y-6">
              {schoolGroups.map((group) => {
                const school = schoolById.get(group.schoolId);
                if (!school || group.mates.length === 0) return null;
                return (
                  <div>
                    <a
                      href={`/schools/${group.schoolId}`}
                      class="inline-block text-sm font-black text-foreground/70 hover:text-yellow-600 transition-colors mb-3 underline decoration-border-dim/50 decoration-2 underline-offset-4"
                    >
                      {school.name}
                    </a>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {group.mates.map((mate) => {
                        const mateName = mate.player.name_ja || mate.player.name_en || mate.player.slug;
                        const mateBadges = playerBadges(mate.player);
                        const relationLabel = RELATION_LABEL[mate.relation];
                        const content = (
                          <>
                            <span class="px-2 py-0.5 bg-border-dim/20 text-foreground/60 rounded-full text-[9px] font-black uppercase tracking-widest shrink-0">
                              {relationLabel}
                            </span>
                            <span class="font-bold text-foreground truncate">{mateName}</span>
                            {mateBadges.map((b) => (
                              <span class="px-2 py-0.5 bg-yellow-400/10 text-yellow-600 rounded-full text-[9px] font-black uppercase tracking-widest shrink-0">
                                {b.label}
                              </span>
                            ))}
                          </>
                        );
                        return (
                          <li class="flex items-center gap-2 p-3 rounded-xl bg-background border border-border-dim">
                            {canHaveIndividualPlayerPage(mate.player) ? (
                              <a
                                href={`/players/${mate.player.slug}`}
                                class="flex items-center gap-2 min-w-0 hover:text-yellow-600 transition-colors flex-1"
                              >
                                {content}
                              </a>
                            ) : (
                              <div class="flex items-center gap-2 min-w-0 flex-1">{content}</div>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                );
              })}
            </div>
          </section>
        )}

        <div class="my-8">
          {showMagazineBanner ? <MagazineBanner /> : <AffiliateBanner />}
        </div>
        <div class="my-8">
          <AdSenseUnit />
        </div>

        {/* 最終更新 */}
        {updatedDate && (
          <div class="mt-8 pt-4 border-t border-border-dim/20 text-[11px] text-foreground/40 font-bold">
            <span>最終更新: {updatedDate}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
