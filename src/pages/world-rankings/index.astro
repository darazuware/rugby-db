---
import Layout from "../../layouts/Layout.astro";
import WorldRankingsComponent from "../../components/WorldRankings";
import { getWorldRankings } from "../../lib/worldRankings";

// BFF経由でデータ取得。失敗時はキャッシュJSONにフォールバック。
const rankingsData = await getWorldRankings();
---

<Layout 
    title="世界ランキング | RUGBY PICKS" 
    description="最新のワールドラグビー世界ランキング。男子（Men's）および女子（Women's）の全加盟国・地域の順位、レーティングポイント、順位変動を詳しくチェックできます。"
>
    <div class="py-8 md:py-12">
        <header class="mb-16 relative">
            {/* Background elements */}
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-yellow-400/5 blur-[120px] rounded-full pointer-events-none"></div>
            
            <span class="inline-block px-4 py-1.5 bg-yellow-400 text-black font-black text-[10px] rounded-full mb-8 uppercase tracking-[0.2em] italic shadow-xl shadow-yellow-400/20">
                World Rugby Rankings
            </span>
            <h1 class="text-6xl md:text-8xl font-black italic tracking-tighter mb-8 uppercase text-foreground leading-[0.9] flex flex-col">
                Global <span class="text-yellow-400 drop-shadow-[0_0_30px_rgba(250,204,21,0.15)]">Standings</span>
            </h1>
            <p class="text-lg md:text-xl text-foreground/50 font-bold max-w-2xl italic leading-relaxed border-l-4 border-yellow-400 pl-6">
                ラグビー界の頂点を目指す。世界中の代表チームの最新の強さを可視化。
            </p>
        </header>

        <WorldRankingsComponent 
            client:load 
            mens={rankingsData.mens} 
            womens={rankingsData.womens}
            updatedAt={rankingsData.updated_at}
        />
    </div>
</Layout>
