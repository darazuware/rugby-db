---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import StandingsTable from "../../components/StandingsTable";
import standingsData from "../../../data/standings.json";

const leagueData = [
    {
        id: "league-one",
        name: "LEAGUE ONE",
        title_jp: "ジャパンラグビー リーグワン",
        color: "bg-[#E60012]",
        accent: "text-[#E60012]",
        standings: (standingsData["league-one"] as any)?.standings || []
    },
    {
        id: "super-rugby",
        name: "SUPER RUGBY PACIFIC",
        title_jp: "スーパーラグビー・パシフィック",
        color: "bg-[#0055A4]",
        accent: "text-[#0055A4]",
        standings: (standingsData["super-rugby"] as any)?.standings || []
    },
    {
        id: "top14",
        name: "TOP 14",
        title_jp: "トップ14",
        color: "bg-[#C5A059]",
        accent: "text-[#C5A059]",
        standings: (standingsData["top14"] as any)?.standings || []
    },
    {
        id: "urc",
        name: "URC",
        title_jp: "ユナイテッド・ラグビー・チャンピオンシップ",
        color: "bg-[#003366]",
        accent: "text-[#003366]",
        standings: (standingsData["urc"] as any)?.standings || []
    },
    {
        id: "premiership",
        name: "PREMIERSHIP",
        title_jp: "プレミアシップ",
        color: "bg-[#FE5000]",
        accent: "text-[#FE5000]",
        standings: (standingsData["premiership"] as any)?.standings || []
    },
    {
        id: "mlr",
        name: "MLR",
        title_jp: "メジャーリーグ・ラグビー",
        color: "bg-[#002B54]",
        accent: "text-[#002B54]",
        standings: (standingsData["mlr"] as any)?.standings || []
    }
];
---

<Layout title="順位表 | RUGBY PICKS" description="世界各国の主要ラグビーリーグ（リーグワン、スーパーラグビー、Top 14、URC、プレミアシップ）の最新順位表。詳細な勝敗データや得失点差をチェックできます。">
    <div class="py-8 md:py-12">
        <header class="mb-12">
            <span class="inline-block px-4 py-1 bg-yellow-400 text-black font-black text-xs rounded-full mb-6 uppercase tracking-widest italic">
                Tournament Standings
            </span>
            <h1 class="text-5xl md:text-7xl font-black italic tracking-tighter mb-6 uppercase text-foreground leading-none">
                League <span class="text-yellow-400">Standings</span>
            </h1>
            <p class="text-base md:text-lg text-foreground/50 font-bold max-w-2xl italic">
                最新の戦績に基づいた、各リーグの詳細な順位表です。
            </p>
        </header>

        <div class="space-y-24">
            {leagueData.map((league) => (
                <section id={league.id} class="relative scroll-mt-32">
                    <div class="flex items-center gap-4 mb-8">
                        <div class={`w-2 h-10 ${league.color} rounded-full shadow-lg`}></div>
                        <div>
                            <h2 class="text-3xl md:text-4xl font-black italic tracking-tighter uppercase text-foreground leading-none">
                                {league.name}
                            </h2>
                            <p class={`text-xs font-black uppercase tracking-[0.3em] ${league.accent} mt-1`}>
                                {league.title_jp}
                            </p>
                        </div>
                    </div>

                    <div class="bg-card/30 backdrop-blur-xl border border-border-dim rounded-[2rem] overflow-hidden shadow-2xl">
                        <StandingsTable 
                            client:load 
                            leagueId={league.id} 
                            standings={league.standings} 
                        />
                    </div>
                    
                    <div class="mt-8 flex justify-end gap-4">
                        <a href={`/teams/${league.id}`} class="px-6 py-3 bg-foreground/5 border border-border-dim text-foreground/40 hover:text-foreground hover:bg-foreground/10 transition-all rounded-xl font-black text-[10px] uppercase tracking-widest">
                            選手名鑑をみる
                        </a>
                        <a href={`/results?league=${league.id}`} class="px-6 py-3 bg-yellow-400 text-black hover:bg-white transition-all rounded-xl font-black text-[10px] uppercase tracking-widest shadow-xl shadow-yellow-400/10">
                            戦績詳細をみる
                        </a>
                    </div>
                </section>
            ))}
        </div>
    </div>
</Layout>
