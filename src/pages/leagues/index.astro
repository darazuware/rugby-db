---
import Layout from "../../layouts/Layout.astro";
import AffiliateBanner from "../../components/AffiliateBanner.astro";

const leagues = [
    {
        id: "league-one",
        name: "LEAGUE ONE",
        name_jp: "リーグワン",
        fullName: "ジャパンラグビー リーグワン",
        title: "Japan Rugby League One",
        description:
            "日本最高峰のプロリーグ。世界トップクラスの選手が続々と参戦し、急速にレベルアップを遂げている。",
        color: "bg-[#E60012]",
        accent: "text-[#E60012]",
        border: "border-[#E60012]",
        image: "https://league-one.jp/img/logo.png", // 仮
        href: "/teams/league-one",
        tag: "日本 / 国内リーグ",
    },
    {
        id: "super-rugby",
        name: "SUPER RUGBY",
        name_jp: "スーパーラグビー",
        fullName: "Super Rugby Pacific",
        title: "Super Rugby Pacific",
        description:
            "ニュージーランド、オーストラリア、フィジー、パシフィック諸島のチームが参戦する、世界で最もエキサイティングなラグビーリーグ。",
        color: "bg-[#0055A4]",
        accent: "text-[#0055A4]",
        border: "border-[#0055A4]",
        image: "https://super.rugby/img/logo.png", // 仮
        href: "/teams/super-rugby",
        tag: "南半球 / ニュージーランド・オーストラリア他",
    },
    {
        id: "top14",
        name: "TOP 14",
        name_jp: "トップ14",
        fullName: "Top 14 France",
        title: "Top 14 France",
        description:
            "フランスが世界に誇る最強の国内リーグ。莫大な資金力と情熱を背景に、世界中から超豪華スター選手が集結するラグビー界の銀河系軍団。",
        color: "bg-[#C5A059]",
        accent: "text-[#C5A059]",
        border: "border-[#C5A059]",
        image: "https://top14.lnr.fr/img/logo.png", // 仮
        href: "/teams/top14",
        tag: "フランス / 欧州最高峰",
    },
    {
        id: "urc",
        name: "URC",
        name_jp: "ユナイテッド・ラグビー・チャンピオンシップ",
        fullName: "United Rugby Championship",
        title: "United Rugby Championship",
        description:
            "南アフリカ、アイルランド、ウェールズ、スコットランド、イタリアの5カ国の精鋭たちがぶつかり合う多国籍リーグ。",
        color: "bg-[#0097D7]",
        accent: "text-[#0097D7]",
        border: "border-[#0097D7]",
        image: "https://www.unitedrugby.com/assets/images/logo.png", // 仮
        href: "/teams/urc",
        tag: "欧州 / 南アフリカ",
    },
    {
        id: "premiership",
        name: "PREM",
        name_jp: "プレミアシップ",
        fullName: "Gallagher Premiership",
        title: "Gallagher Premiership",
        description:
            "100年以上の歴史を誇るイングランドの伝統ある国内リーグ。激しいフィジカルバトルと緻密な戦術が交錯する世界屈指の激戦区。",
        color: "bg-[#FE5000]",
        accent: "text-[#FE5000]",
        border: "border-[#FE5000]",
        image: "https://www.premiershiprugby.com/logo.png", // 仮
            href: "/teams/premiership",
        tag: "イングランド / 伝統の国内リーグ",
    },
    {
        id: "mlr",
        name: "MLR",
        name_jp: "メジャーリーグ・ラグビー",
        fullName: "Major League Rugby",
        title: "Major League Rugby",
        description:
            "北米最高峰のプロリーグ。近年急速に発展を遂げており、世界各国のスター選手や若手有望株が集うエキサイティングな新興リーグ。",
        color: "bg-[#002B54]",
        accent: "text-[#002B54]",
        border: "border-[#002B54]",
        image: "https://www.majorleaguerugby.com/logo.png", // 仮
        href: "/teams/mlr",
        tag: "アメリカ・カナダ / 北米プロリーグ",
    },
];
---

<Layout title="リーグ・大会一覧 | RUGBY PICKS">
    <div class="py-12">
        <header class="mb-16">
            <span
                class="inline-block px-4 py-1 bg-yellow-400 text-black font-black text-sm rounded-full mb-6 uppercase tracking-widest italic"
            >
                World Leagues
            </span>
            <h1
                class="text-6xl md:text-7xl font-black italic tracking-tighter mb-8 leading-none uppercase text-foreground"
            >
                Explore<br /><span class="text-yellow-400">The Leagues</span
                >
            </h1>
            <p
                class="text-lg text-foreground/60 font-bold max-w-2xl italic"
            >
                世界各国の主要ラグビーリーグを網羅。各リーグの所属チーム、順位、選手情報をチェックできます。
            </p>
        </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                {
                    leagues.map((league) => (
                        <div class="group relative bg-card border border-border-dim rounded-[3rem] p-12 overflow-hidden hover:shadow-2xl transition-all">
                            <div
                                class={`absolute top-0 right-0 w-32 h-32 translate-x-16 -translate-y-16 rotate-45 ${league.color} opacity-10 group-hover:opacity-100 transition-opacity`}
                            />

                            <div class="relative z-10 flex flex-col h-full">
                                <span
                                    class={`text-xs font-black uppercase tracking-widest mb-4 ${league.accent} group-hover:text-white transition-colors`}
                                >
                                    {league.tag}
                                </span>

                                <h2 class="text-3xl font-black text-foreground italic flex items-baseline gap-3">
                                    <span class="uppercase tracking-tighter">{league.name}</span>
                                    <span class="text-lg text-foreground/40 not-italic tracking-tight">{league.name_jp}</span>
                                </h2>
                                <p class="text-lg font-bold text-foreground/40 mb-8 group-hover:text-white/80 transition-colors">
                                    {league.title}
                                </p>

                                <p class="text-foreground/80 font-medium leading-relaxed group-hover:text-white transition-colors mb-12 flex-grow">
                                    {league.description}
                                </p>

                                <div class="flex flex-col sm:flex-row gap-4">
                                    <a
                                        href={league.href}
                                        class={`px-8 py-4 ${league.color} text-white text-center font-black text-lg rounded-2xl group-hover:bg-card group-hover:text-foreground transition-all shadow-xl hover:scale-105`}
                                    >
                                        チーム一覧・選手名鑑をみる
                                    </a>
                                    <a
                                        href={`/results?league=${league.id}`}
                                        class="px-8 py-4 bg-background text-foreground text-center font-black text-lg rounded-2xl group-hover:bg-black/20 group-hover:text-white transition-all hover:scale-105 border border-transparent group-hover:border-white/20"
                                    >
                                        戦績をみる
                                    </a>
                                </div>
                            </div>

                            {/* ホバー時のオーバーレイ背景 */}
                            <div
                                class={`absolute inset-0 ${league.color} -z-10 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out`}
                            />
                        </div>
                    ))
                }
            </div>

            <section
                class="mt-32 p-16 bg-gray-900 rounded-[4rem] text-center overflow-hidden relative"
            >
                <div
                    class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"
                >
                </div>
                <div class="relative z-10">
                    <h2
                        class="text-4xl font-black text-white italic tracking-tighter mb-8"
                    >
                        ALL PLAYERS <span class="text-yellow-400">DATABASE</span
                        >
                    </h2>
                    <p class="text-gray-400 font-bold mb-12 max-w-2xl mx-auto">
                        リーグの垣根を超えて、全2,000名以上の選手から一括検索が可能です。
                    </p>
                    <a
                        href="/players"
                        class="inline-block px-12 py-5 bg-yellow-400 text-black font-black text-xl rounded-2xl hover:bg-white hover:scale-105 transition-all shadow-2xl shadow-yellow-400/20"
                    >
                        選手名鑑（全体検索）へ
                    </a>
                </div>
            </section>
    </div>
</Layout>
