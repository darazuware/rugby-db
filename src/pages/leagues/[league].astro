---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PlayerList from "../../components/PlayerList";

export async function getStaticPaths() {
    return [
        {
            params: { league: "league-one" },
            props: { title: "LEAGUE ONE 選手名鑑" },
        },
        {
            params: { league: "super-rugby" },
            props: { title: "SUPER RUGBY 選手名鑑" },
        },
        { params: { league: "top14" }, props: { title: "TOP 14 選手名鑑" } },
    ];
}

const { league } = Astro.params;
const { title } = Astro.props;

if (!league) {
    return Astro.redirect("/404");
}

const leagueMap: Record<string, string> = {
    "league-one": "league-one",
    "super-rugby": "super-rugby",
    top14: "top14",
};

const targetLeague = (leagueMap[league] || league).toLowerCase().trim();
const allPlayers = await getCollection("players");
---

<Layout
    title={`${title} | ラグビー選手名鑑 | RUGBY PICKS`}
    description={`${title}。${league
        ?.replace("-", " ")
        .toUpperCase()} に登録されている全選手の身長、体重、年齢、ポジション別の検索・ソートが可能です。`}
>
    <main class="bg-gray-50 min-h-screen pt-12">
        <div class="container mx-auto px-4 mb-8">
            <div
                class="flex items-center gap-4 text-sm font-black text-gray-400 uppercase tracking-widest mb-4"
            >
                <a href="/" class="hover:text-yellow-400 transition-colors"
                    >HOME</a
                >
                <span>/</span>
                <a
                    href="/players"
                    class="hover:text-yellow-400 transition-colors">PLAYERS</a
                >
                <span>/</span>
                <span class="text-gray-900">{league?.replace("-", " ")}</span>
            </div>
        </div>

        <PlayerList
            client:load
            initialPlayers={allPlayers as any}
            leagueContext={targetLeague}
        />
    </main>
</Layout>
