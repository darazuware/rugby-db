---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PlayerList from "../../components/PlayerList";
import teamsData from "../../../data/teams.json";

export async function getStaticPaths() {
    return [
        {
            params: { league: "league-one" },
            props: { title: "LEAGUE ONE 選手名鑑" },
        },
        {
            params: { league: "super-rugby" },
            props: { title: "SUPER RUGBY 選手名鑑" },
        },
        { params: { league: "top14" }, props: { title: "TOP 14 選手名鑑" } },
    ];
}

const { league } = Astro.params;
const { title } = Astro.props;

if (!league) {
    return Astro.redirect("/404");
}

const targetLeague = (league || "").toLowerCase().trim();

// 全選手データの取得とディビジョン情報の補完
const allPlayersRaw = await getCollection("players");
const teamToDivision: Record<string, string> = {};
(teamsData as any[]).forEach((t: any) => {
    if (t.team_name && t.division) {
        teamToDivision[t.team_name] = t.division;
    }
});

// Reactコンポーネントに渡すためにシリアライズ可能なデータにクレンジング
const initialPlayers = allPlayersRaw.map((p) => {
    const division =
        (p.data.team ? teamToDivision[p.data.team] : "") ||
        p.data.division ||
        "";
    return {
        slug: p.slug,
        data: {
            ...p.data,
            division: division,
        },
    };
});
---

<Layout
    title={`${title} | ラグビー選手名鑑 | RUGBY PICKS`}
    description={`${title}。${league
        ?.replace("-", " ")
        .toUpperCase()} に登録されている全選手の身長、体重、年齢、ポジション別の検索・ソートが可能です。`}
>
    <!-- DEBUG: LEAGUES-PAGE-SYNCED-20260310-2345 -->
    <main class="bg-gray-50 min-h-screen pt-12">
        <div class="container mx-auto px-4 mb-8">
            <div
                class="flex items-center gap-4 text-sm font-black text-gray-400 uppercase tracking-widest mb-4"
            >
                <a href="/" class="hover:text-yellow-400 transition-colors"
                    >HOME</a
                >
                <span>/</span>
                <a
                    href="/players"
                    class="hover:text-yellow-400 transition-colors">PLAYERS</a
                >
                <span>/</span>
                <span class="text-gray-900">{league?.replace("-", " ")}</span>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4">
            <PlayerList
                client:load
                initialPlayers={initialPlayers as any}
                leagueContext={targetLeague}
            />
        </div>
    </main>
</Layout>
