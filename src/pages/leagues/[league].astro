---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PlayerList from "../../components/PlayerList";
import teamsData from "../../../data/teams.json";

export async function getStaticPaths() {
    return [
        {
            params: { league: "league-one" },
            props: { title: "LEAGUE ONE 選手名鑑" },
        },
        {
            params: { league: "super-rugby" },
            props: { title: "SUPER RUGBY 選手名鑑" },
        },
        { params: { league: "top14" }, props: { title: "TOP 14 選手名鑑" } },
    ];
}

const { league } = Astro.params;
const { title } = Astro.props;

if (!league) {
    return Astro.redirect("/404");
}

const targetLeague = (league || "").toLowerCase().trim();

// 全選手データの取得とディビジョン情報の補完
const allPlayersRaw = await getCollection("players");
const teamToDivision: Record<string, string> = {};
(teamsData as any[]).forEach((t: any) => {
    if (t.team_name && t.division) {
        teamToDivision[t.team_name] = t.division;
    }
});

// Reactコンポーネントに渡すためにシリアライズ可能なデータにクレンジング
const initialPlayers = allPlayersRaw.map((p) => {
    const division =
        (p.data.team ? teamToDivision[p.data.team] : "") ||
        p.data.division ||
        "";
    return {
        slug: p.slug,
        data: {
            ...p.data,
            division: division,
        },
    };
});
---

<Layout
    title={`${title} | ラグビー選手名鑑 | RUGBY PICKS`}
    description={`${title}。${league
        ?.replace("-", " ")
        .toUpperCase()} に登録されている全選手の身長、体重、年齢、ポジション別の検索・ソートが可能です。`}
>
    <!-- DEBUG: LEAGUES-PAGE-SYNCED-20260310-2345 -->
    <main class="bg-gray-50 min-h-screen pt-12">
        <div class="container mx-auto px-4 mb-8">
            <div
                class="flex items-center gap-4 text-sm font-black text-gray-400 uppercase tracking-widest mb-4"
            >
                <a href="/" class="hover:text-yellow-400 transition-colors"
                    >HOME</a
                >
                <span>/</span>
                <a
                    href="/players"
                    class="hover:text-yellow-400 transition-colors">PLAYERS</a
                >
                <span>/</span>
                <span class="text-gray-900">{league?.replace("-", " ")}</span>
            </div>
        </div>

        <div id="players" class="max-w-7xl mx-auto px-4">
            <PlayerList
                client:load
                initialPlayers={initialPlayers as any}
                leagueContext={targetLeague}
            />
        </div>
    </main>

    {/* 固定クイックナビゲーション (PC & スマホ) */}
    <nav
        class="fixed right-4 bottom-8 xl:right-8 xl:top-1/2 xl:-translate-y-1/2 z-50 flex flex-col gap-3 animate-in fade-in slide-in-from-right-4 duration-500"
    >
        {/* トップへ戻る */}
        <a
            href="#top"
            class="w-12 h-12 md:w-14 md:h-14 bg-white/90 backdrop-blur-md border border-gray-200 rounded-2xl shadow-xl flex items-center justify-center text-gray-400 hover:text-yellow-500 hover:border-yellow-200 transition-all hover:-translate-y-1 group"
            title="トップへ戻る"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="m18 15-6-6-6 6"></path>
            </svg>
            <span
                class="absolute right-full mr-3 px-2 py-1 bg-gray-900 text-white text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block"
                >TOPへ戻る</span
            >
        </a>

        {/* 選手検索へ */}
        <a
            href="#players"
            class="w-12 h-12 md:w-14 md:h-14 bg-yellow-400 border border-yellow-500 rounded-2xl shadow-xl shadow-yellow-400/20 flex items-center justify-center text-black hover:scale-110 transition-all group"
            title="選手検索"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
                ></path>
            </svg>
            <span
                class="absolute right-full mr-3 px-2 py-1 bg-gray-900 text-white text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block"
                >選手検索</span
            >
        </a>
    </nav>
</Layout>
