---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PlayerList from "../../components/PlayerList";
import teamsData from "../../../data/teams.json";

const { league } = Astro.params;
const LEAGUE_TITLE_MAP: Record<string, string> = {
  "league-one": "LEAGUE ONE 選手名鑑",
  "super-rugby": "SUPER RUGBY 選手名鑑",
  "top14": "TOP 14 選手名鑑",
};
const title = LEAGUE_TITLE_MAP[league as string] || "ラグビー選手名鑑";

if (!league || !LEAGUE_TITLE_MAP[league as string]) {
    return Astro.redirect("/404");
}

const targetLeague = (league || "").toLowerCase().trim();

// 全選手データの取得とディビジョン情報の補完
const allPlayersRaw = await getCollection("players");
const teamToDivision: Record<string, string> = {};
(teamsData as any[]).forEach((t: any) => {
    if (t.team_name && t.division) {
        teamToDivision[t.team_name] = t.division;
    }
});

// Reactコンポーネントに渡すためにシリアライズ可能なデータにクレンジング
const initialPlayers = allPlayersRaw.map((p) => {
    const division =
        (p.data.team ? teamToDivision[p.data.team] : "") ||
        p.data.division ||
        "";
    return {
        slug: p.slug,
        data: {
            ...p.data,
            division: division,
        },
    };
});

// 試合結果データの取得 (results_2026.json)
import resultsData from "../../../data/results_2026.json";
// 順位表データの取得 (standings.json)
import standingsData from "../../../data/standings.json";
import StandingsTable from "../../components/StandingsTable";
import LeagueMatchResults from "../../components/LeagueMatchResults";

const leagueStandingsRaw = (standingsData as any)[targetLeague];
const leagueStandings = leagueStandingsRaw && 'standings' in leagueStandingsRaw 
  ? leagueStandingsRaw.standings 
  : (Array.isArray(leagueStandingsRaw) ? leagueStandingsRaw : []);

const leagueResultsAll = (resultsData as any)[targetLeague] || [];
// 重複排除
const seenResults = new Set();
const leagueResults = leagueResultsAll.filter((m: any) => {
  const key = `${m.date}-${m.home}-${m.away}`;
  if (seenResults.has(key)) return false;
  seenResults.add(key);
  return true;
});
---

<Layout
    title={`${title} | ラグビー選手名鑑 | RUGBY PICKS`}
    description={`${title}。${league
        ?.replace("-", " ")
        .toUpperCase()} に登録されている全選手の身長、体重、年齢、ポジション別の検索・ソートが可能です。`}
>
    <!-- DEBUG: LEAGUES-PAGE-COMBINED-20260312 -->
    <main class="bg-background min-h-screen pt-12 pb-24">
        <div class="container mx-auto px-4 mb-12">
            <div
                class="flex items-center gap-4 text-xs font-black text-foreground/30 uppercase tracking-[0.3em] mb-8"
            >
                <a href="/" class="hover:text-yellow-400 transition-colors"
                    >HOME</a
                >
                <span class="text-foreground/10">/</span>
                <span class="text-yellow-400">{league?.replace("-", " ")}</span>
            </div>

            <h1 class="text-5xl md:text-7xl font-black text-white italic tracking-tighter mb-12 uppercase">
                {league?.replace("-", " ")}
            </h1>

            {/* 順位表セクション */}
            {leagueStandings && (
                <div class="mb-20">
                    <div class="flex items-center gap-4 mb-8">
                        <h2 class="text-2xl font-black text-foreground italic tracking-tight uppercase">Standings</h2>
                        <div class="h-px flex-1 bg-border-dim"></div>
                    </div>
                    <StandingsTable client:load standings={leagueStandings} leagueId={targetLeague} />
                </div>
            )}

            {/* 戦績セクション */}
            {leagueResults.length > 0 && (
                <div class="mb-20">
                    <LeagueMatchResults client:load matches={leagueResults} leagueId={targetLeague} />
                </div>
            )}
        </div>

        <div id="players" class="max-w-7xl mx-auto px-4 mt-24 border-t border-border-dim pt-24">
            <div class="flex items-center gap-4 mb-12">
                <h2 class="text-2xl font-black text-foreground italic tracking-tight uppercase">Player Directory</h2>
                <div class="h-px flex-1 bg-border-dim"></div>
            </div>
            <PlayerList
                client:load
                initialPlayers={initialPlayers as any}
                leagueContext={targetLeague}
            />
        </div>
    </main>

    {/* 固定クイックナビゲーション (PC & スマホ) */}
    <nav
        class="fixed right-4 bottom-8 xl:right-8 xl:top-1/2 xl:-translate-y-1/2 z-50 flex flex-col gap-3 animate-in fade-in slide-in-from-right-4 duration-500"
    >
        {/* トップへ戻る */}
        <a
            href="#top"
            class="w-12 h-12 md:w-14 md:h-14 bg-card/90 backdrop-blur-md border border-border-dim rounded-2xl shadow-xl flex items-center justify-center text-foreground/40 hover:text-yellow-500 hover:border-yellow-200 transition-all hover:-translate-y-1 group"
            title="トップへ戻る"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="m18 15-6-6-6 6"></path>
            </svg>
            <span
                class="absolute right-full mr-3 px-2 py-1 bg-card text-foreground text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block"
                >TOPへ戻る</span
            >
        </a>

        {/* 選手検索へ */}
        <a
            href="#players"
            class="w-12 h-12 md:w-14 md:h-14 bg-yellow-400 border border-yellow-500 rounded-2xl shadow-xl shadow-yellow-400/20 flex items-center justify-center text-black hover:scale-110 transition-all group"
            title="選手検索"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
                ></path>
            </svg>
            <span
                class="absolute right-full mr-3 px-2 py-1 bg-card text-foreground text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block"
                >選手検索</span
            >
        </a>
    </nav>
</Layout>
