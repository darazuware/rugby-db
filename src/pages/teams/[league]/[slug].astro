---
export const prerender = true;
import teamsData from "../../../../data/teams.json";
export async function getStaticPaths() {
    return (teamsData as any[])
        .filter((team) => team.slug && team.slug !== '')
        .map((team) => ({
            params: {
                league: team.league,
                slug: team.slug
            },
        }));
}
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import srTeams from "../../../../data/super_rugby_teams.json";
import t14Teams from "../../../../data/top14_teams_detailed.json";
import urcTeams from "../../../../data/urc_teams.json";
import TeamPlayerList from "../../../components/TeamPlayerList";
import teamNamesJp from "../../../../data/team_names_jp.json";
import { getTeamSlug } from "../../../utils/team_utils";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { findMasterTeamBySlug, getTeamRosterLegacyShape } from "../../../lib/masterAdapters";

const { league: leagueParam, slug } = Astro.params;
const team: any = teamsData.find((t: any) => t.league === leagueParam && t.slug === slug);

if (!team) {
    return Astro.redirect("/404");
}
const league = team.league;

// チーム情報のマッピングを取得する共通関数
const getTeamMapping = (teamName: string) => {
    const leagueMapping = (teamNamesJp as any)[league || ""] || {};
    // 1. 正式名（English Key）で直接検索
    if (leagueMapping[teamName]) return { ...leagueMapping[teamName], formalName: teamName };
    // 2. エイリアス、日本語名、または短縮日本語名で全体検索
    for (const formalName in leagueMapping) {
        const data = leagueMapping[formalName];
        const shortJp = data.jp.includes("（")
            ? data.jp.split("（")[0]
            : data.jp;
        if (
            data.jp === teamName ||
            shortJp === teamName ||
            (data.aliases && data.aliases.includes(teamName)) ||
            formalName.includes(teamName) ||
            teamName.includes(formalName)
        ) {
            return { ...data, formalName };
        }
    }
    return null;
};

// 日本語名・旗の取得
const mapping = getTeamMapping(team.team_name);
const teamNameDisplay = mapping?.jp || team.team_name;
const teamFlag = mapping?.flag || "";

const TEAM_EN_NAME_MAP: Record<string, string> = {
    // ... Existing map remains for League One
    静岡ブルーレヴズ: "SHIZUOKA BLUE REVS",
    東京サントリーサンゴリアス: "TOKYO SUNTORY SUNGOLIATH",
    "浦安D-Rocks": "URAYASU D-ROCKS",
    コベルコ神戸スティーラーズ: "KOBELCO KOBE STEELERS",
    埼玉パナソニックワイルドナイツ: "SAITAMA PANASONIC WILDKNIGHTS",
    東芝ブレイブルーパス東京: "TOSHIBA BRAVE LUPUS TOKYO",
    トヨタヴェルブリッツ: "TOYOTA VERBLITZ",
    三重ホンダヒート: "MIE HONDA HEAT",
    三菱重工相模原ダイナボアーズ: "MITSUBISHI SAGAMIHARA DYNABOARS",
    横浜キヤノンイーグルス: "YOKOHAMA CANON EAGLES",
    リコーブラックラムズ東京: "RICOH BLACKRAMS TOKYO",
    NECグリーンロケッツ東葛: "NEC GREEN ROCKETS TOKATSU",
    九州電力キューデンヴォルテクス: "KYUSHU ELECTRIC KYUDEN VOLTEX",
    清水建設江東ブルーシャークス: "SHIMIZU KOTO BLUE SHARKS",
    豊田自動織機シャトルズ愛知: "TOYOTA SHOKKI SHUTTLES AICHI",
    日本製鉄釜石シーウェイブス: "KAMAISHI SEAWAVES",
    花園近鉄ライナーズ: "HANAZONO KINTETSU LINERS",
    日野レッドドルフィンズ: "HINO RED DOLPHINS",
    レッドハリケーンズ大阪: "RED HURRICANES OSAKA",
    クリタウォーターガッシュ昭島: "KURITA WATERGUSH AKISHIMA",
    狭山セコムラガッツ: "SECOM RUGGUTS",
    中国電力レッドレグリオンズ: "CHUGOKU ELECTRIC RED REGULIONS",
    マツダスカイアクティブズ広島: "MAZDA SKYACTIVS HIROSHIMA",
    ヤクルトレビンズ戸田: "YAKULT LEVINS TODA",
    "クボタスピアーズ船橋・東京ベイ": "KUBOTA SPEARS FUNABASHI TOKYO BAY",
    ルリーロ福岡: "LERIRO FUKUOKA",
};

const teamEnName =
    team.team_en_name ||
    TEAM_EN_NAME_MAP[team.team_name] ||
    team.team_name.toUpperCase();

const { slug: paramSlug } = Astro.params; // Rename to avoid conflict with team.slug
const isLeagueOne = league === "league-one";
// The 'team' prop is already available from getStaticPaths, so no need to find it again unless it's missing.
// const team = Astro.props.team || teamsData.find((t: any) => t.slug === paramSlug);

// 所属選手の取得
// master (SSOT) にチームが存在する場合は roster_ids ベースの厳密な突合を使う（04/P2-3）。
// 表記揺れによる文字列部分一致（誤爆しうる）は master 未対応チームのみのフォールバックとする。
// 対応リーグは masterAdapters.ts の LEGACY_LEAGUE_MASTER_KEYS 参照（現時点: league-one のみ）。
const masterTeam = await findMasterTeamBySlug(league, slug || "");

let allPlayers: any[] = [];
let uniqueTeamPlayers: any[];
let squadPlayers: any[];

if (masterTeam) {
    const roster = await getTeamRosterLegacyShape(masterTeam);
    uniqueTeamPlayers = Array.from(new Map(roster.map((p) => [p.slug, p])).values());
    squadPlayers = uniqueTeamPlayers;
} else {
    allPlayers = await getCollection("players");
    const teamPlayers = allPlayers
        .filter((p: any) => {
            const normalize = (s: any) =>
                String(s || "")
                    .normalize("NFC")
                    .trim();
            const pLeague = normalize(p.data.league);
            const tLeague = normalize(league);

            // 1. リーグ一致を確認 (プレイヤー側のリーグタグが空の場合は例外的に許可)
            if (pLeague !== "" && pLeague !== tLeague) return false;

            const pTeamRaw = p.data.team;
            if (!pTeamRaw) return false;

            const pTeam = normalize(pTeamRaw);
            const tName = normalize(team.team_name);
            const tEnName = normalize(team.team_en_name);
            const tDisplay = normalize(teamNameDisplay);
            const formalName = mapping ? normalize(mapping.formalName) : "";
            const aliases = (mapping?.aliases || []).map((a: string) => normalize(a));

            // 2. 正規化後の完全一致 (日本語名、英語名、正式名、マッピング表示名、エイリアス)
            if (
                pTeam === tName ||
                pTeam === tEnName ||
                pTeam === tDisplay ||
                pTeam === formalName ||
                aliases.includes(pTeam)
            ) return true;

            // 3. 部分一致による補完（特に海外リーグの表記揺れ対応）
            if (tName && (pTeam.includes(tName) || tName.includes(pTeam)))
                return true;
            if (
                tEnName &&
                tEnName.length > 5 &&
                (pTeam.includes(tEnName) || tEnName.includes(pTeam))
            )
                return true;
            if (tDisplay && (pTeam.includes(tDisplay) || tDisplay.includes(pTeam)))
                return true;
            if (formalName && formalName.length > 5 && (pTeam.includes(formalName) || formalName.includes(pTeam)))
                return true;

            return false;
        })
        .map((p: any) => ({
            slug: p.slug,
            data: p.data,
        }));

    // スラッグによる重複排除 (データソースの問題による重複表示をフロントエンドで防止)
    uniqueTeamPlayers = Array.from(
        new Map(teamPlayers.map((p: any) => [p.slug, p])).values()
    );

    // 当該チームの注目選手 (キャップ数順) 用データ（master 未対応チームのみ）
    squadPlayers = allPlayers.filter((p: any) => {
        const pTeam = p.data.team || "";
        return pTeam.includes(team.team_name) ||
               pTeam.includes(teamNameDisplay) ||
               (mapping?.formalName && pTeam.includes(mapping.formalName));
    });
}
const teamPlayers = uniqueTeamPlayers;

// 共通の戦績データ取得
import resultsData from "../../../../data/results_2026.json";

// 日本時間(JST)での「今日」を取得 (フィルタ用)
const jstToday = new Intl.DateTimeFormat('en-CA', { 
    timeZone: 'Asia/Tokyo', 
    year: 'numeric', 
    month: '2-digit', 
    day: '2-digit' 
}).format(new Date());

const getTeamResults = () => {
    // 全リーグの試合データをフラット化
    const allMatches = Object.values(resultsData).flat();
    const tName = team.team_name;
    const tEnName = team.team_en_name;
    const tDisplay = teamNameDisplay;

    return allMatches
        .filter((m: any) => {
            if (!m.home || !m.away) return false;
            
            // チーム名判定 (部分一致も含めて確実にマッチさせる)
            const isHome = (tName && m.home.includes(tName)) || 
                           (tEnName && m.home.includes(tEnName)) || 
                           (tDisplay && m.home.includes(tDisplay)) ||
                           (m.home && tName && tName.includes(m.home));
            
            const isAway = (tName && m.away.includes(tName)) || 
                           (tEnName && m.away.includes(tEnName)) || 
                           (tDisplay && m.away.includes(tDisplay)) ||
                           (m.away && tName && tName.includes(m.away));

            const isMatch = isHome || isAway;
            
            // 未来の試合やVSを除外 (JSTベース)
            return isMatch && m.date && m.date <= jstToday && m.score !== "VS";
        })
        .sort((a: any, b: any) => (b.date || "").localeCompare(a.date || "")) // 最新順
        .slice(0, 5); // 直近5試合
};

const matchResults = getTeamResults();

// 当該チームの注目選手 (キャップ数順) — squadPlayers は上の if/else で解決済み
// (master 対応チームは roster_ids ベース、未対応チームは従来の文字列一致)
const getCapCount = (capStr: string) => {
    if (!capStr) return 0;
    const match = capStr.match(/\((\d+)\)/);
    return match ? parseInt(match[1], 10) : 0;
};

const popularPlayers = squadPlayers
    .sort((a, b) => getCapCount(b.data.caps || "") - getCapCount(a.data.caps || ""))
    .slice(0, 5)
    .map((p, index) => ({
        id: p.slug || p.id,
        name: p.data.name_en || p.data.title,
        name_jp: p.data.title,
        team: team.team_name,
        team_jp: teamNameDisplay,
        rank: index + 1
    }));

// 代表経験者（全員）
const isDiv3 = team.division === "Division 3";

const hasNationalCap = (caps: string) => {
    // 国代表 or 州代表のみ: "代表(\d+)" or "Country (N)" パターン
    return /代表\(\d+\)/.test(caps) || /[A-Za-z ]+\s*\(\d+\)/.test(caps);
};

const internationalPlayers = isLeagueOne ? squadPlayers
    .filter(p => {
        const caps = String(p.data.caps || "").trim();
        if (!caps) return false;
        return isDiv3 ? true : hasNationalCap(caps);
    })
    .sort((a, b) => getCapCount(b.data.caps || "") - getCapCount(a.data.caps || ""))
    .map(p => ({
        id: p.slug || p.id,
        name_jp: p.data.title,
        caps: p.data.caps,
        position: p.data.position || "",
    })) : [];
// チーム紹介記事の取得
const teamArticles = await getCollection('teams');
// id は "super-rugby/moana-pasifika.md" 形式
const teamArticle = teamArticles.find(
    (a: any) => a.id === `${league}/${slug}.md` && !a.data.draft
);
const { Content: TeamArticleContent } = teamArticle ? await teamArticle.render() : { Content: null };

// 記事本文に登場する選手名を検出（クライアントサイドリンク挿入用）
type PlayerLink = { name: string; slug: string };
const articleMentions: PlayerLink[] = [];
if (teamArticle?.body) {
    const body = teamArticle.body;
    const seen = new Set<string>();
    for (const p of allPlayers) {
        const pSlug: string = p.slug || (p as any).id;
        if (seen.has(pSlug)) continue;
        // 日本語名（スペース除去・中点バリアント）
        if (p.data.name_ja) {
            const noSpace = String(p.data.name_ja).replace(/[\s　]/g, '');
            const dotVariant = String(p.data.name_ja).trim().replace(/[\s　]/g, '・');
            if (noSpace.length >= 2 && (body.includes(noSpace) || body.includes(dotVariant))) {
                articleMentions.push({ name: body.includes(noSpace) ? noSpace : dotVariant, slug: pSlug });
                seen.add(pSlug);
                continue;
            }
        }
        // 英語名
        const en = p.data.name_en ? String(p.data.name_en).trim() : '';
        if (en.includes(' ') && body.includes(en)) {
            articleMentions.push({ name: en, slug: pSlug });
            seen.add(pSlug);
            continue;
        }
        // エイリアス
        if (p.data.aliases) {
            for (const alias of p.data.aliases) {
                if (alias && body.includes(alias)) {
                    articleMentions.push({ name: alias, slug: pSlug });
                    seen.add(pSlug);
                    break;
                }
            }
        }
    }
    // 長い名前を先に処理（部分一致による二重置換を防ぐ）
    articleMentions.sort((a, b) => b.name.length - a.name.length);
}

// 順位データの取得
import standingsData from "../../../../data/standings.json";
import { getLeagueStandings, type LeagueId } from "../../../lib/safeStandings";
const leagueStandings = getLeagueStandings(standingsData, (league || "") as LeagueId);
const teamStanding = leagueStandings.find((s: any) => 
    s.display_name === teamNameDisplay || 
    s.team_name === team.team_name || 
    (s.slug && (s.slug === team.slug || s.slug === String(team.id)))
);
---

<Layout
    title={`${isLeagueOne ? teamNameDisplay : teamEnName} (${
        isLeagueOne ? teamEnName : teamNameDisplay
    }) | チーム詳細 | RUGBY PICKS`}
    description={isLeagueOne
        ? `${teamNameDisplay}（${teamEnName}）の選手・成績・歴史を徹底解説。${team.home_ground ? team.home_ground + 'を本拠地とする' : ''}${team.host_area ? team.host_area + 'の' : ''}リーグワン${team.division === 'Division 1' ? 'Div.1' : team.division === 'Division 2' ? 'Div.2' : 'Div.3'}クラブの全情報。`
        : `${teamEnName} (${teamNameDisplay}) の選手・成績・最新情報。RUGBY PICKS で世界のラグビーチームを探索。`
    }
>
    <main class="bg-background min-h-screen py-8 md:py-12 px-0 sm:px-4 text-foreground relative overflow-hidden w-full">
        {/* 背景の装飾的なぼかし要素 */}
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-yellow-400/5 rounded-full blur-[128px] -z-10 animate-pulse"></div>
        <div class="absolute bottom-0 right-1/4 w-[32rem] h-[32rem] bg-indigo-500/5 rounded-full blur-[160px] -z-10"></div>

        <div class="w-full max-w-7xl mx-auto relative z-10 px-4 sm:px-0" id="top">
            <Breadcrumbs items={[
                { label: league.toUpperCase().replace("-", " "), href: `/teams/${league}` },
                { label: teamNameDisplay }
            ]} />
            {/* クイックナビゲーション (Sticky Nav) */}
            <div class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 p-1.5 bg-black/40 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl scale-90 sm:scale-100">
                <a href="#info" class="px-4 py-2 hover:bg-white/10 rounded-xl transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2 group">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 group-hover:scale-125 transition-transform"></span>
                    INFO
                </a>
                {matchResults.length > 0 && (
                    <a href="#results" class="px-4 py-2 hover:bg-white/10 rounded-xl transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2 group">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 group-hover:scale-125 transition-transform"></span>
                        RESULTS
                    </a>
                )}
                {TeamArticleContent && (
                    <a href="#about" class="px-4 py-2 hover:bg-white/10 rounded-xl transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2 group">
                        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 group-hover:scale-125 transition-transform"></span>
                        ABOUT
                    </a>
                )}
                {internationalPlayers.length > 0 && (
                    <a href="#internationals" class="px-4 py-2 hover:bg-white/10 rounded-xl transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2 group">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 group-hover:scale-125 transition-transform"></span>
                        INTL
                    </a>
                )}
                <a href="#players" class="px-4 py-2 hover:bg-white/10 rounded-xl transition-all text-[10px] font-black uppercase tracking-widest flex items-center gap-2 group">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400 group-hover:scale-125 transition-transform"></span>
                    PLAYERS
                </a>
                <div class="w-px h-4 bg-white/10 mx-1"></div>
                <a href="#top" class="w-8 h-8 flex items-center justify-center hover:bg-yellow-400 hover:text-black rounded-xl transition-all group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
                </a>
            </div>

            {/* チームヘッダー */}
            <div
                class="bg-card rounded-3xl shadow-xl overflow-hidden border border-border-dim mb-12"
            >
                <div class="bg-gray-900 p-8 md:p-12 text-white relative">
                    <div class="absolute top-0 right-0 p-10 opacity-10 hidden md:block">
                        <span
                            class="text-7xl font-black italic break-all text-right block max-w-xl uppercase"
                            >{teamEnName}</span
                        >
                    </div>
                    <div class="relative z-10">
                        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                            <a
                                href={`/teams/${league}`}
                                class="inline-flex items-center text-yellow-400 font-bold hover:translate-x-1 transition-transform"
                            >
                                ← {league.toUpperCase().replace("-", " ")} チーム一覧
                            </a>
                            {teamStanding && (
                                <a href="/standings" class="bg-yellow-400 text-black px-4 py-1.5 rounded-full font-black text-[10px] uppercase tracking-[0.2em] shadow-lg hover:bg-white transition-colors flex items-center gap-2">
                                    <span class="opacity-60">現在の順位</span>
                                    <span class="text-sm italic">{teamStanding.rank}</span>
                                </a>
                            )}
                        </div>
                        {
                            isLeagueOne ? (
                                <>
                                    <h1 class="text-5xl md:text-7xl font-black mb-4 tracking-tighter flex items-center gap-6 flex-wrap">
                                        {teamFlag && (
                                            <span class="text-7xl md:text-8xl drop-shadow-2xl animate-in fade-in zoom-in duration-700">
                                                {teamFlag}
                                            </span>
                                        )}
                                        <span class="leading-none">{teamNameDisplay}</span>
                                    </h1>
                                    {teamEnName &&
                                        teamEnName !== teamNameDisplay && (
                                            <div class="text-2xl font-bold text-foreground/40 mb-6 italic tracking-tight uppercase">
                                                {teamEnName}
                                            </div>
                                        )}
                                </>
                            ) : (
                                <>
                                    <h1 class="text-6xl md:text-8xl font-black mb-2 tracking-tighter flex items-center gap-6 flex-wrap uppercase">
                                        {teamFlag && (
                                            <span class="text-7xl md:text-9xl drop-shadow-2xl animate-in fade-in zoom-in duration-700">
                                                {teamFlag}
                                            </span>
                                        )}
                                        <span class="leading-none">{teamEnName}</span>
                                    </h1>
                                    {teamNameDisplay &&
                                        teamNameDisplay !== teamEnName && (
                                            <div class="text-2xl font-bold text-foreground/40 mb-6 italic tracking-tight uppercase">
                                                {teamNameDisplay}
                                            </div>
                                        )}
                                </>
                            )
                        }
                        <div class="flex gap-4">
                            <span
                                class="bg-yellow-400 text-black px-4 py-1 rounded-full font-black text-xs uppercase tracking-widest leading-none flex items-center"
                                >{team.division}</span
                            >
                            <span
                                class="bg-white/10 backdrop-blur-md px-4 py-1 rounded-full font-bold text-xs flex items-center"
                                >{team.host_area}</span
                            >
                        </div>
                    </div>
                </div>

                <div class="p-10" id="info">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                        <div class="space-y-8">
                            <h2
                                class="text-xl font-black border-l-4 border-yellow-400 pl-4"
                            >
                                TEAM INFORMATION
                            </h2>
                            <dl class="space-y-6">
                                {team.former_name && team.renamed_year && (
                                    <div>
                                        <dt class="text-[10px] font-black text-foreground/40 uppercase tracking-widest mb-1">
                                            旧チーム名
                                        </dt>
                                        <dd class="text-lg font-bold text-foreground">
                                            {team.former_name} <span class="text-xs text-foreground/60 font-medium">({team.renamed_year}年改称)</span>
                                        </dd>
                                    </div>
                                )}
                                <div>
                                    <dt
                                        class="text-[10px] font-black text-foreground/40 uppercase tracking-widest mb-1"
                                    >
                                        運営法人
                                    </dt>
                                    <dd class="text-lg font-bold text-foreground">
                                        {team.legal_entity}
                                    </dd>
                                </div>
                                <div>
                                    <dt
                                        class="text-[10px] font-black text-foreground/40 uppercase tracking-widest mb-1"
                                    >
                                        ホームグラウンド
                                    </dt>
                                    <dd class="text-lg font-black text-foreground leading-tight">
                                        {team.home_ground || "---"}
                                    </dd>
                                    {team.home_ground_address && (
                                        <dd class="text-[11px] text-foreground/60 mt-1 leading-relaxed">
                                            {team.home_ground_address}
                                        </dd>
                                    )}
                                </div>
                                <div>
                                    <dt
                                        class="text-[10px] font-black text-foreground/40 uppercase tracking-widest mb-1"
                                    >
                                        ホストエリア
                                    </dt>
                                    <dd class="text-lg font-bold text-foreground">
                                        {team.host_area}
                                    </dd>
                                </div>
                                {
                                    team.official_site && (
                                        <div>
                                            <dt class="text-[10px] font-black text-foreground/40 uppercase tracking-widest mb-1">
                                                公式サイト
                                            </dt>
                                            <dd>
                                                <a
                                                    href={team.official_site}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-lg font-bold text-yellow-600 hover:text-foreground transition-colors underline underline-offset-4 decoration-2"
                                                >
                                                    {team.official_site.replace(
                                                        /^https?:\/\//,
                                                        ""
                                                    )}{" "}
                                                    ↗
                                                </a>
                                            </dd>
                                        </div>
                                    )
                                }
                            </dl>
                        </div>

                            {/* [NEW] チーム内注目選手 (Star Players) */}
                            <div class="space-y-6">
                                <h2 class="text-xl font-black border-l-4 border-yellow-400 pl-4 uppercase tracking-wider">
                                    注目選手
                                </h2>
                                {popularPlayers.length > 0 ? (
                                    <div class="space-y-3">
                                        {popularPlayers.map(p => (
                                            <a href={`/players/${p.id}`} class="flex items-center gap-4 p-3 rounded-2xl bg-background border border-border-dim hover:border-yellow-400/50 transition-all group">
                                                <div class="w-10 h-10 bg-gray-900 rounded-lg flex items-center justify-center text-foreground/20 font-black italic border border-border-dim group-hover:border-yellow-400/30 transition-colors">
                                                    {p.name[0]}
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="text-[10px] font-black text-yellow-400/60 uppercase tracking-widest mb-0.5">TOP {p.rank}</div>
                                                    <div class="text-xs font-black text-foreground group-hover:text-yellow-400 transition-colors truncate">{p.name_jp}</div>
                                                </div>
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-foreground/20 group-hover:text-yellow-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                            </a>
                                        ))}
                                    </div>
                                ) : (
                                    <div class="bg-background rounded-2xl p-6 border border-border-dim text-center">
                                         <p class="text-[10px] text-foreground/40 font-bold">データ収集中...</p>
                                    </div>
                                )}
                                <div class="bg-yellow-400/5 rounded-2xl p-4 border border-yellow-400/10">
                                    <p class="text-[9px] text-yellow-400/60 font-black italic text-center uppercase tracking-widest leading-relaxed">
                                        Team Stats / Featured Players
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {/* 代表経験者セクション (リーグワンのみ) */}
                {internationalPlayers.length > 0 && (
                    <section class="mb-16 scroll-mt-32 px-10 pb-2" id="internationals">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="flex items-center gap-3">
                                <div class="w-1.5 h-8 bg-red-500 rounded-full"></div>
                                <h2 class="text-2xl font-black text-foreground uppercase tracking-tight italic">
                                    代表経験選手
                                </h2>
                            </div>
                            <div class="flex-grow h-px bg-linear-to-r from-border-dim to-transparent"></div>
                            <span class="px-3 py-1 bg-card border border-border-dim rounded-lg text-[10px] font-black text-foreground/40 uppercase tracking-widest">
                                {internationalPlayers.length} 名
                            </span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                            {internationalPlayers.map(p => (
                                <a href={`/players/${p.id}`} class="flex items-center gap-4 p-4 rounded-2xl bg-background border border-border-dim hover:border-red-500/50 transition-all group">
                                    <div class="w-10 h-10 bg-gray-900 rounded-lg flex items-center justify-center text-foreground/20 font-black italic border border-border-dim group-hover:border-red-500/30 transition-colors shrink-0">
                                        {p.name_jp ? p.name_jp[0] : "?"}
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="text-xs font-black text-foreground group-hover:text-red-400 transition-colors truncate">{p.name_jp}</div>
                                        {p.position && <div class="text-[9px] text-foreground/40 font-bold uppercase tracking-widest">{p.position}</div>}
                                        <div class="text-[9px] text-red-400/70 font-black mt-0.5">{p.caps}</div>
                                    </div>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-foreground/20 group-hover:text-red-400 transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {/* チーム紹介記事 */}
                {TeamArticleContent && (
                    <section class="mb-16 scroll-mt-32 px-10 pb-10" id="about">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="flex items-center gap-3">
                                <div class="w-1.5 h-8 bg-purple-400 rounded-full"></div>
                                <h2 class="text-2xl font-black text-foreground uppercase tracking-tight italic">
                                    About
                                </h2>
                            </div>
                            <div class="flex-grow h-px bg-linear-to-r from-border-dim to-transparent"></div>
                        </div>
                        <div id="about-content" class="prose prose-invert prose-sm max-w-none
                            prose-headings:font-black prose-headings:tracking-tight prose-headings:text-foreground
                            prose-h2:text-xl prose-h2:border-l-4 prose-h2:border-yellow-400 prose-h2:pl-3 prose-h2:mt-10 prose-h2:mb-4
                            prose-p:text-foreground/70 prose-p:leading-relaxed
                            prose-strong:text-foreground prose-strong:font-black
                            prose-table:w-full prose-table:text-sm
                            prose-th:text-left prose-th:text-foreground/40 prose-th:font-black prose-th:text-[10px] prose-th:uppercase prose-th:tracking-widest prose-th:pb-2
                            prose-td:text-foreground/80 prose-td:py-2 prose-td:border-b prose-td:border-border-dim/30
                            prose-li:text-foreground/70 prose-li:marker:text-yellow-400
                            prose-a:text-yellow-400 prose-a:no-underline hover:prose-a:underline">
                            <TeamArticleContent />
                        </div>
                        {articleMentions.length > 0 && (
                            <script define:vars={{ articleMentions }}>
                            (function() {
                                const container = document.getElementById('about-content');
                                if (!container) return;
                                // 長い名前から順にテキストノードを置換
                                const players = articleMentions.slice().sort((a, b) => b.name.length - a.name.length);
                                function walk(node) {
                                    if (node.nodeType === 3) { // TEXT_NODE
                                        let text = node.textContent;
                                        let changed = false;
                                        for (const { name, slug } of players) {
                                            if (text.includes(name)) {
                                                text = text.split(name).join(`\x00${slug}\x01${name}\x02`);
                                                changed = true;
                                            }
                                        }
                                        if (changed) {
                                            const span = document.createElement('span');
                                            span.innerHTML = text
                                                .replace(/\x00([^\x01]+)\x01([^\x02]+)\x02/g,
                                                    (_, s, n) => `<a href="/players/${s}" class="text-yellow-400 hover:underline font-bold">${n}</a>`);
                                            node.replaceWith(span);
                                        }
                                    } else if (node.nodeType === 1 && node.tagName !== 'A' && node.tagName !== 'SCRIPT') {
                                        Array.from(node.childNodes).forEach(walk);
                                    }
                                }
                                walk(container);
                            })();
                            </script>
                        )}
                    </section>
                )}

                {/* [NEW] 直近の試合結果 */}
                {matchResults.length > 0 && (
                    <section class="mb-16 scroll-mt-32" id="results">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="flex items-center gap-3">
                                <div class="w-1.5 h-8 bg-yellow-400 rounded-full"></div>
                                <h2 class="text-2xl font-black text-foreground uppercase tracking-tight italic">
                                    Match Results
                                </h2>
                            </div>
                            <div class="flex-grow h-px bg-linear-to-r from-border-dim to-transparent"></div>
                            <a href="/results" class="group/link flex items-center gap-2 text-[10px] font-black text-yellow-500 hover:text-foreground transition-all uppercase tracking-widest">
                                View All Results 
                                <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            {matchResults.map((m: any) => (
                                <div class="bg-card border border-border-dim rounded-2xl p-5 hover:border-yellow-400/30 transition-all group overflow-hidden relative">
                                    <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                                        <span class="text-3xl font-black italic">{m.round > 0 ? `R${m.round}` : 'M'}</span>
                                    </div>
                                    <div class="text-[9px] font-black text-foreground/40 uppercase tracking-[0.2em] mb-3 flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
                                        {m.date ? m.date.replace(/-/g, '/') : 'TBA'}
                                        {m.division && <span class="text-yellow-400/60">[{m.division}]</span>}
                                    </div>
                                    <div class="flex flex-col items-center gap-3 mb-1">
                                        <div class="w-full flex items-center justify-between gap-2">
                                            <div class="flex-1 text-left">
                                                <div class="text-[10px] md:text-xs font-black text-foreground leading-tight">{m.home}</div>
                                            </div>
                                            <div class="px-3 py-1 bg-yellow-400/10 rounded-lg">
                                                <div class="text-base md:text-lg font-black text-yellow-400 tracking-tighter italic whitespace-nowrap leading-none">{m.score}</div>
                                            </div>
                                            <div class="flex-1 text-right">
                                                <div class="text-[10px] md:text-xs font-black text-foreground leading-tight">{m.away}</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-4 pt-3 border-t border-border-dim/30 flex items-center justify-between text-[8px] font-black uppercase tracking-widest italic group-hover:text-yellow-400/40 transition-colors">
                                        <span>Season 2025-26</span>
                                        <span class="text-foreground/20">Performance</span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                )}

                {/* 選手一覧 */}
            <section class="scroll-mt-32" id="players">
                <div class="flex items-center gap-4 mb-8">
                    <div class="flex items-center gap-3">
                        <div class="w-1.5 h-8 bg-yellow-400 rounded-full"></div>
                        <h2
                            class="text-2xl font-black text-foreground uppercase tracking-tight italic"
                        >
                            PLAYERS
                        </h2>
                    </div>
                    <div class="flex-grow h-px bg-linear-to-r from-border-dim to-transparent"></div>
                    <span
                        class="px-3 py-1 bg-card border border-border-dim rounded-lg text-[10px] font-black text-foreground/40 uppercase tracking-widest"
                        >{teamPlayers.length} 名</span
                    >
                </div>

                {
                    teamPlayers.length > 0 ? (
                        <TeamPlayerList
                            players={uniqueTeamPlayers}
                            isLeagueOne={isLeagueOne}
                            client:load
                        />
                    ) : (
                        <div class="bg-card rounded-3xl p-12 text-center border-2 border-dashed border-border-dim">
                            <p class="text-foreground/40 font-bold">
                                現在、登録されている所属選手はいません。
                            </p>
                        </div>
                    )
                }
            </section>
        </div>
    </main>
</Layout>
