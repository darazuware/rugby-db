---
import Layout from "../../../layouts/Layout.astro";
import StandingsTable from "../../../components/StandingsTable";
import TeamList from "../../../components/TeamList";
import PlayerList from "../../../components/PlayerList";
import AffiliateBanner from "../../../components/AffiliateBanner.astro";
import { getCollection } from "astro:content";
import teamsData from "../../../../data/teams.json";
import standingsData from "../../../../data/standings.json";
import resultsData from "../../../../data/results_2026.json";
import teamNamesJp from "../../../../data/team_names_jp.json";
import { getTeamSlug } from "../../../utils/team_utils";

export async function getStaticPaths() {
    return [
        {
            params: { league: "league-one" },
            props: { leagueName: "League One" },
        },
        {
            params: { league: "super-rugby" },
            props: { leagueName: "Super Rugby" },
        },
        { params: { league: "top14" }, props: { leagueName: "Top 14" } },
        { params: { league: "urc" }, props: { leagueName: "URC" } },
    ];
}

const { league } = Astro.params;
const { leagueName } = Astro.props;

// チーム情報のマッピングを取得する共通関数
const getTeamMapping = (teamName: string) => {
    const leagueMapping = (teamNamesJp as any)[league || ""] || {};
    // 1. 正式名で直接検索
    if (leagueMapping[teamName]) return leagueMapping[teamName];
    // 2. エイリアス、日本語名、または短縮日本語名で全体検索
    for (const formalName in leagueMapping) {
        const data = leagueMapping[formalName];
        const shortJp = data.jp.includes("（")
            ? data.jp.split("（")[0]
            : data.jp;
        if (
            data.jp === teamName ||
            shortJp === teamName ||
            (data.aliases && data.aliases.includes(teamName)) ||
            formalName.includes(teamName) ||
            teamName.includes(formalName) ||
            data.jp.includes(teamName) ||
            teamName.includes(data.jp)
        ) {
            return data;
        }
    }
    return null;
};

const filteredTeams = (teamsData as any[])
    .filter((t: any) => t.league === league)
    .map((t: any) => {
        const mapping = getTeamMapping(t.team_name);
        return {
            ...t,
            slug: t.slug || getTeamSlug(t.team_name),
            team_name_jp: t.team_name_jp || mapping?.jp || t.team_name,
            flag: t.flag || mapping?.flag || "",
            legal_entity: t.legal_entity || mapping?.country || "",
        };
    });

// 当該リーグの順位データと試合結果を取得
const leagueData = (standingsData as any)[league as keyof typeof standingsData];
const isTop14 = league === "top14";
const isURC = league === "urc";

const rawStandings = leagueData?.standings || [];
const fullResults = (resultsData as any)[league || ""] || [];
const results = fullResults.slice(0, 20); // 最新20件を表示（D1/D2/D3をカバーするため拡大）

const standings = rawStandings.map((s: any) => {
    const mapping = getTeamMapping(s.team_name);
    // teamsDataから正確なスラッグを取得してフォールバック
    const teamInTeams = filteredTeams.find((t: any) => 
        t.team_name === s.team_name || 
        t.team_name_jp === s.team_name || 
        (mapping && t.team_name === mapping.jp)
    );
    
    return {
        ...s,
        slug: teamInTeams?.slug || s.slug,
        display_name:
            s.display_name || mapping?.jp || s.team_name_jp || s.team_name,
        flag: s.flag || mapping?.flag || "",
    };
});

// 全選手データの取得と補完
// 全選手データの取得と補完
const allPlayersRaw = await getCollection("players");
const teamToDivision: Record<string, string> = {};
(teamsData as any[]).forEach((t: any) => {
    if (t.team_name && t.division) {
        teamToDivision[t.team_name] = t.division;
    }
});

// Reactコンポーネントに渡すためにシリアライズ可能なデータにクレンジング
const initialPlayers = allPlayersRaw.map((p) => {
    const division =
        (p.data.team ? teamToDivision[p.data.team] : "") ||
        p.data.division ||
        "";
    return {
        slug: p.slug,
        data: {
            ...p.data,
            division: division,
        },
    };
});

// ページタイトル用の装飾
const safeLeagueName = leagueName || league || "";
const leagueTitle = safeLeagueName.toUpperCase();
const leagueNameMap: Record<string, { en: string; jp: string }> = {
    "league-one": { en: "LEAGUE ONE", jp: "リーグワン" },
    "super-rugby": { en: "SUPER RUGBY", jp: "スーパーラグビー" },
    "top14": { en: "TOP 14", jp: "トップ14" },
    "urc": { en: "URC", jp: "ユナイテッド・ラグビー・チャンピオンシップ" }
};
const currentNames = leagueNameMap[league || ""] || { en: leagueTitle, jp: safeLeagueName };
---

<Layout
    title={`${safeLeagueName} チーム一覧・最新順位・選手名鑑 | RUGBY PICKS`}
    description={`${safeLeagueName}（${leagueTitle}）の最新順位、全所属クラブのチーム情報、および登録選手のロースター・スタッツ検索。公式にはない高度なフィルタリング機能を備えたデータベース。`}
>
    <main class="bg-background min-h-screen py-12 px-4">
        <div class="max-w-7xl mx-auto">
            <header class="mb-12">
                <nav
                    class="flex items-center gap-2 text-xs font-black text-foreground/40 uppercase tracking-widest mb-4"
                >
                    <a
                        href="/teams"
                        class="hover:text-yellow-500 transition-colors"
                        >Team List</a
                    >
                    <span>/</span>
                    <span class="text-foreground">{safeLeagueName}</span>
                </nav>
                <h1
                    class="text-4xl md:text-5xl font-black text-foreground tracking-tighter italic mb-4 uppercase flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4"
                >
                    <div>
                        {currentNames.en}<span class="text-yellow-400"> TEAMS</span>
                    </div>
                    <span class="not-italic text-xl md:text-2xl text-foreground/40"
                        >{currentNames.jp} チーム一覧・選手名鑑</span
                    >
                </h1>
                <p
                    class="text-foreground/60 font-bold italic border-l-4 border-yellow-400 pl-4"
                >
                    {safeLeagueName} の最新順位{
                        !isURC && "と所属チーム・ロースター情報"
                    }
                </p>

                {/* モバイル用ジャンプボタン - スクロール追従 */}
                {
                    !isURC && (
                        <div class="sticky top-0 z-40 bg-card/90 backdrop-blur-sm -mx-4 px-4 py-4 mb-0 border-b border-border-dim flex flex-wrap gap-2 xl:hidden overflow-x-auto no-scrollbar">
                            <a
                                href="#players"
                                class="px-4 py-2 bg-yellow-400 text-black text-[10px] font-black rounded-full uppercase tracking-widest shadow-lg shadow-yellow-400/20 active:scale-95 transition-all whitespace-nowrap"
                            >
                                選手検索
                            </a>
                            <a
                                href="#standings"
                                class="px-4 py-2 bg-card border border-border-dim text-foreground text-[10px] font-black rounded-full uppercase tracking-widest active:scale-95 transition-all whitespace-nowrap"
                            >
                                順位表・結果
                            </a>
                            <a
                                href="#teams"
                                class="px-4 py-2 bg-card border border-border-dim text-foreground text-[10px] font-black rounded-full uppercase tracking-widest active:scale-95 transition-all whitespace-nowrap"
                            >
                                クラブ一覧
                            </a>
                        </div>
                    )
                }
            </header>

            <div
                class="flex flex-col gap-20"
            >
                {
                    /* 選手一覧セクション (URC以外) - モバイルでは物理的に一番上に配置 */
                }
                {
                    !isURC && (
                        <div
                            id="players"
                            class="xl:col-span-12 xl:order-3 mb-12 xl:mt-20 xl:border-t xl:border-border-dim xl:pt-16"
                        >
                            <header class="mb-12">
                                <div class="flex items-center gap-4 mb-4">
                                    <h2 class="text-3xl font-black text-foreground uppercase tracking-tighter italic">
                                        Squad{" "}
                                        <span class="text-yellow-500">
                                            Search
                                        </span>
                                    </h2>
                                    <div class="flex-grow h-px bg-border-dim" />
                                </div>
                                <p class="text-foreground/60 font-bold italic border-l-4 border-yellow-400 pl-4">
                                    {safeLeagueName}{" "}
                                    に登録されている全選手から、スペック検索・ソートが可能です。
                                </p>
                            </header>
                            <div class="bg-card rounded-3xl p-2 shadow-sm border border-border-dim">
                                <PlayerList
                                    client:load
                                    initialPlayers={initialPlayers as any}
                                    leagueContext={league}
                                />
                            </div>
                        </div>
                    )
                }

                {/* チーム一覧 (URC以外) */}
                {
                    !isURC && (
                        <div
                            id="teams"
                            class="w-full"
                        >
                            <div class="flex items-center gap-4 mb-8">
                                <h2 class="text-2xl font-black text-foreground uppercase tracking-tight italic">
                                    All <span class="text-yellow-500">Clubs</span>
                                    <span class="ml-4 not-italic text-lg text-foreground/40 lowercase tracking-normal font-bold">全所属チーム</span>
                                </h2>
                                <div class="flex-grow h-px bg-border-dim" />
                            </div>
                            <TeamList
                                client:load
                                initialTeams={filteredTeams}
                                leagueContext={league}
                            />
                        </div>
                    )
                }

                {/* 順位表 - ページ下部へ移動 */}
                <div
                    id="standings"
                    class="w-full scroll-mt-24 pt-16 border-t border-border-dim"
                >
                    <header class="mb-12">
                        <div class="flex items-center gap-4 mb-4">
                            <h2 class="text-3xl font-black text-foreground uppercase tracking-tighter italic">
                                Standings <span class="text-yellow-500">&</span> Results
                                <span class="ml-4 not-italic text-lg text-foreground/40 lowercase tracking-normal font-bold">最新順位表・戦績</span>
                            </h2>
                            <div class="flex-grow h-px bg-border-dim" />
                        </div>
                    </header>

                    <div class="max-w-5xl mx-auto">
                        <StandingsTable
                            leagueId={league || ""}
                            standings={standings}
                            results={results}
                        />
                        <div
                            class="mt-6 p-6 bg-yellow-400/5 rounded-2xl border border-yellow-400/10 italic text-xs font-bold text-yellow-600/80 text-center"
                        >
                            ※ 順位データは毎週定期的に自動更新されます。
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-20 max-w-4xl mx-auto order-4">
                <AffiliateBanner league={league} />
            </div>
        </div>
    </main>

    {/* 固定クイックナビゲーション (PC & スマホ) */}
    <nav
        class="fixed right-4 bottom-8 xl:right-8 xl:top-1/2 xl:-translate-y-1/2 z-50 flex flex-col gap-3 animate-in fade-in slide-in-from-right-4 duration-500"
    >
        {/* トップへ戻る */}
        <a
            href="#top"
            class="w-12 h-12 md:w-14 md:h-14 bg-card/90 backdrop-blur-md border border-border-dim rounded-2xl shadow-xl flex items-center justify-center text-foreground/40 hover:text-yellow-500 hover:border-yellow-200 transition-all hover:-translate-y-1 group"
            title="トップへ戻る"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="m18 15-6-6-6 6"></path>
            </svg>
            <span
                class="absolute right-full mr-3 px-2 py-1 bg-card text-foreground text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block"
                >TOPへ戻る</span
            >
        </a>

        {
            !isURC && (
                <>
                    {/* 選手検索へ */}
                    <a
                        href="#players"
                        class="w-12 h-12 md:w-14 md:h-14 bg-yellow-400 border border-yellow-500 rounded-2xl shadow-xl shadow-yellow-400/20 flex items-center justify-center text-black hover:scale-110 transition-all group"
                        title="選手検索"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                        <span class="absolute right-full mr-3 px-2 py-1 bg-card text-foreground text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block">
                            選手検索
                        </span>
                    </a>

                    {/* 順位表へ */}
                    <a
                        href="#standings"
                        class="w-12 h-12 md:w-14 md:h-14 bg-card border border-border-dim rounded-2xl shadow-xl flex items-center justify-center text-foreground hover:border-yellow-400 transition-all group"
                        title="順位表"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M3 3v18h18" />
                            <path d="M7 16l4-4 4 4 5-8" />
                        </svg>
                        <span class="absolute right-full mr-3 px-2 py-1 bg-card text-foreground text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block">
                            順位・戦績
                        </span>
                    </a>

                    {/* クラブ一覧へ */}
                    <a
                        href="#teams"
                        class="w-12 h-12 md:w-14 md:h-14 bg-card border border-border-dim rounded-2xl shadow-xl flex items-center justify-center text-foreground hover:border-yellow-400 transition-all group"
                        title="クラブ一覧"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect width="7" height="7" x="3" y="3" rx="1" />
                            <rect width="7" height="7" x="14" y="3" rx="1" />
                            <rect width="7" height="7" x="14" y="14" rx="1" />
                            <rect width="7" height="7" x="3" y="14" rx="1" />
                        </svg>
                        <span class="absolute right-full mr-3 px-2 py-1 bg-card text-foreground text-[10px] font-bold rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block">
                            クラブ一覧
                        </span>
                    </a>
                </>
            )
        }
    </nav>
</Layout>
