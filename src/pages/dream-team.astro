---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import DreamTeamBuilder from "../components/DreamTeamBuilder";

const teamParam = Astro.url.searchParams.get("team") || undefined;
const isShared = !!teamParam;

const title = isShared
  ? "最強ラグビードリームチーム | RUGBY PICKS"
  : "ドリームチームビルダー | RUGBY PICKS";
const description = isShared
  ? "シェアされたラグビードリームチームを見る。あなたも最強の23人を選ぼう！"
  : "世界中のラグビー選手から最強の15人＋リザーブ8人を選んでチームを作ろう。SNSでシェアしよう！";
---

<Layout title={title} description={description}>
  <div class="mb-8">
    <span class="inline-block px-4 py-1.5 bg-yellow-400 text-black font-black text-[10px] rounded-full mb-4 tracking-widest uppercase italic">
      Dream Team Builder
    </span>
    <h1 class="text-4xl md:text-5xl font-black font-display italic tracking-tighter text-foreground uppercase mb-3">
      最強の<span class="text-yellow-400">23</span>人を選ぼう
    </h1>
    <p class="text-foreground/40 font-bold text-sm">
      世界中の選手から15人＋リザーブ8人を選択 → SNSでシェア
    </p>
  </div>

  <DreamTeamBuilder
    client:load
    initialEncoded={teamParam}
  />
</Layout>
