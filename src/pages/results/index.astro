---
import Layout from "../../layouts/Layout.astro";
import resultsData from "../../../data/results_2026.json";
import teamNamesJp from "../../../data/team_names_jp.json";
import teamsData from "../../../data/teams.json";

const leagues = [
    { id: "league-one", name: "リーグワン", label: "リーグワン", isParent: true },
    { id: "league-one-d1", name: "リーグワン D1", label: "D1", parentId: "league-one", division: "D1" },
    { id: "league-one-d2", name: "リーグワン D2", label: "D2", parentId: "league-one", division: "D2" },
    { id: "league-one-d3", name: "リーグワン D3", label: "D3", parentId: "league-one", division: "D3" },
    { id: "super-rugby", name: "スーパーラグビー", label: "スーパーラグビー" },
    { id: "top14", name: "TOP 14", label: "TOP 14" },
    { id: "urc", name: "URC", label: "URC" },
];

// チームのスラッグを取得するヘルパー
const getTeamSlug = (leagueId: string, teamName: string) => {
    if (!teamName) return null;
    const leagueKey = leagueId.startsWith('league-one') ? 'league-one' : leagueId;
    const cleanName = teamName.trim();
    
    // 1. 完全一致
    let team = (teamsData as any).find((t: any) => 
        t.league === leagueKey && t.team_name === cleanName
    );
    
    // 2. 部分一致 (teams.json の名称が長い場合など)
    if (!team) {
        team = (teamsData as any).find((t: any) => 
            t.league === leagueKey && (t.team_name.includes(cleanName) || cleanName.includes(t.team_name))
        );
    }
    
    return team ? `/teams/${leagueKey}/${team.slug}` : null;
};

// チーム名正規化関数 - より柔軟に
const normalizeTeam = (leagueId: string, name: string) => {
    if (!name) return { name: "Unknown", flag: null };
    const leagueKey = leagueId.startsWith('league-one') ? 'league-one' : leagueId;
    const leagueData = (teamNamesJp as any)[leagueKey] || {};
    const cleanInput = name.trim();
    
    // 1. 完全一致（キーまたは日本語名）
    if (leagueData[cleanInput]) return { name: leagueData[cleanInput].jp, flag: leagueData[cleanInput].flag };
    for (const [fullName, data] of Object.entries(leagueData)) {
        if ((data as any).jp === cleanInput) return { name: (data as any).jp, flag: (data as any).flag };
    }
    
    // 2. エイリアス検索（部分一致含む）
    for (const [fullName, data] of Object.entries(leagueData)) {
        const d = data as any;
        const lowerInput = cleanInput.toLowerCase();
        if (d.aliases?.some((a: string) => a.toLowerCase().trim() === lowerInput) || 
            fullName.toLowerCase().trim().includes(lowerInput) ||
            lowerInput.includes(fullName.toLowerCase().trim())) {
            return { name: d.jp, flag: d.flag };
        }
    }
    
    return { name: cleanInput, flag: null };
};

// Round ごとにグルーピングし、重複排除する関数
const groupByRound = (leagueId: string, results: any[]) => {
    // 1. データの正規化と初期収集
    const allEnhancedResults = results.map(r => {
        const normHome = normalizeTeam(leagueId, r.home);
        const normAway = normalizeTeam(leagueId, r.away);
        const sortedTeams = [normHome.name, normAway.name].sort();
        
        return {
            ...r,
            home: normHome.name,
            home_flag: normHome.flag || r.home_flag,
            home_link: getTeamSlug(leagueId, normHome.name),
            away: normAway.name,
            away_flag: normAway.flag || r.away_flag,
            away_link: getTeamSlug(leagueId, normAway.name),
            round: parseInt(r.round) || 0,
            _sortedTeams: sortedTeams,
            _dateObj: new Date(r.date)
        };
    });

    // 2. 重複排除 (チームペア + スコア + 近い日付)
    const uniqueMatches: any[] = [];
    
    // Round情報があるものを優先して先に処理
    const sortedForDedup = [...allEnhancedResults].sort((a, b) => (b.round > 0 ? 1 : 0) - (a.round > 0 ? 1 : 0));

    sortedForDedup.forEach(current => {
        const isDuplicate = uniqueMatches.find(existing => {
            // 同一対戦カード
            const sameTeams = existing._sortedTeams[0] === current._sortedTeams[0] && 
                             existing._sortedTeams[1] === current._sortedTeams[1];
            if (!sameTeams) return false;

            // スコアが一致、または一方が未確定
            const sameScore = existing.score === current.score || existing.score === "VS" || current.score === "VS";
            if (!sameScore) return false;

            // 日付が2日以内
            const diffDays = Math.abs(existing._dateObj.getTime() - current._dateObj.getTime()) / (1000 * 60 * 60 * 24);
            return diffDays <= 2;
        });

        if (!isDuplicate) {
            uniqueMatches.push(current);
        } else if (current.round > 0 && isDuplicate.round === 0) {
            // 既存が Round なしで、現在が Round ありなら差し替え
            const index = uniqueMatches.indexOf(isDuplicate);
            uniqueMatches[index] = current;
        }
    });

    // 3. Round ごとのグループ化 (本日(JST)より後の試合は除外)
    const groups: { [key: number]: any[] } = {};
    
    // 日本時間(JST)での「今日」を取得
    const jstToday = new Intl.DateTimeFormat('en-CA', { 
        timeZone: 'Asia/Tokyo', 
        year: 'numeric', 
        month: '2-digit', 
        day: '2-digit' 
    }).format(new Date());

    uniqueMatches.filter(m => m.date && m.date <= jstToday && m.score !== "VS").forEach(m => {
        const round = m.round;
        if (!groups[round]) groups[round] = [];
        groups[round].push(m);
    });

    return Object.keys(groups)
        .map(Number)
        .sort((a, b) => b - a)
        .map(round => {
            const matches = groups[round].sort((a, b) => b._dateObj.getTime() - a._dateObj.getTime());
            // 節ごとの日付範囲を算出
            const dates = matches.map(m => m.date).filter(Boolean).sort();
            const minDate = dates[0] ? dates[0].replace(/-/g, '.') : "";
            const maxDate = dates[dates.length - 1] ? dates[dates.length - 1].replace(/-/g, '.') : "";
            
            return {
                round,
                matches,
                dateRange: minDate && maxDate ? (minDate === maxDate ? minDate : `${minDate} 〜 ${maxDate}`) : ""
            };
        });
};

const getLeagueResults = (league: any) => {
    let results = [];
    if (league.parentId === "league-one") {
        results = (resultsData as any)["league-one"]?.filter((r: any) => r.division === league.division) || [];
    } else {
        results = (resultsData as any)[league.id] || [];
    }
    return groupByRound(league.id, results);
};
---

<Layout 
    title="試合結果・戦績一覧 | RUGBY PICKS"
    sidebarType="results"
    activeLeague="league-one-d1"
>
    <main class="pb-20">
        <header class="mb-12">
            <h1
                class="text-4xl md:text-5xl font-black text-foreground italic tracking-tighter mb-4 uppercase"
            >
                Match <span class="text-yellow-400">Results</span>
            </h1>
            <p class="text-foreground/40 font-bold text-sm">
                2025-26シーズンの全試合結果。常に最新の試合を最上部に表示。
            </p>
        </header>

        <!-- フィルター -->
        <div class="flex flex-col gap-4 mb-12" id="filter-wrapper">
            <div class="flex flex-wrap gap-2" id="filter-container">
                <button
                    class="filter-btn px-4 py-2 bg-yellow-400 text-black font-black italic rounded-xl shadow-lg shadow-yellow-400/20 text-[10px] transition-all uppercase tracking-widest"
                    data-league="all"
                >
                    ALL
                </button>
                {
                    leagues.filter(l => !l.parentId).map((league) => (
                        <button 
                            class="filter-btn px-4 py-2 bg-card/50 text-foreground/40 font-black rounded-xl border border-border-dim hover:border-yellow-400 opacity-80 hover:opacity-100 hover:text-foreground transition-all text-[10px] uppercase tracking-widest"
                            data-league={league.id}
                        >
                            {league.label}
                        </button>
                    ))
                }
            </div>

            <!-- リーグワン用サブフィルター (ディビジョン選択) -->
            <div id="league-one-sub-filters" class="flex flex-wrap gap-2 pl-4 border-l-2 border-red-600/30 hidden transition-all duration-300">
                <span class="text-[9px] font-black text-foreground/30 uppercase self-center mr-2 italic">Division:</span>
                {
                    leagues.filter(l => l.parentId === 'league-one').map((league) => (
                        <button 
                            class="filter-btn px-3 py-1.5 bg-card/30 text-foreground/40 font-black rounded-lg border border-border-dim hover:border-red-500/50 hover:text-foreground transition-all text-[9px] uppercase tracking-widest"
                            data-league={league.id}
                        >
                            {league.label}
                        </button>
                    ))
                }
            </div>
        </div>

			<!-- 戦績リスト (リーグ/Divisionごとにグループ化) -->
			<div class="max-w-4xl mx-auto space-y-16" id="results-container">
				{leagues.filter(l => !l.isParent).map((league) => {
					const leagueResults = getLeagueResults(league);
					if (leagueResults.length === 0) return null;

					return (
						<section data-league={league.id} class="league-section mb-20 scroll-mt-24">
							<div class="flex items-center gap-4 mb-8">
								<h2 class={`text-xl md:text-2xl font-black px-6 py-2 rounded-xl italic skew-x-[-10deg] ${
									league.id.startsWith('league-one') ? 'bg-red-600 text-white' :
									league.id === 'super-rugby' ? 'bg-blue-600 text-white' :
									league.id === 'top14' ? 'bg-yellow-600 text-black' : 'bg-card text-foreground'
								}`}>
									{league.name.toUpperCase()}
								</h2>
								<div class="h-[2px] flex-1 bg-gradient-to-r from-border-dim to-transparent"></div>
							</div>

							<div class="space-y-12">
                                <!-- 節選択ナビゲーション (PCではここに表示) -->
                                <div class="mb-12" id={`${league.id}-round-selector`}>
                                    <div class="flex items-center gap-3 mb-4">
                                        <h3 class="text-xs font-black text-foreground/40 uppercase tracking-widest italic">Jump to Round</h3>
                                        <div class="h-px flex-1 bg-border-dim/30"></div>
                                    </div>
                                    <div class="relative max-w-xs group/select">
                                        <select 
                                            class="round-jump-select w-full bg-card/40 border border-border-dim/50 rounded-xl px-4 py-2.5 text-[10px] font-black text-foreground/60 appearance-none cursor-pointer focus:outline-none focus:border-yellow-400 transition-all uppercase tracking-widest"
                                            data-league-id={league.id}
                                        >
                                            <option value="" disabled selected>Select Round</option>
                                            {leagueResults.map((group: any) => (
                                                <option value={`#${league.id}-round-${group.round}`}>
                                                    {group.round > 0 
                                                        ? `ROUND ${group.round}${group.dateRange ? ` (${group.dateRange})` : ''}`
                                                        : 'OTHER MATCHES'}
                                                </option>
                                            ))}
                                        </select>
                                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-foreground/20 group-hover/select:text-yellow-400 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>
                                    </div>
                                </div>

								{leagueResults.map((group: any) => (
                                    <div id={`${league.id}-round-${group.round}`} class="round-group scroll-mt-24 mb-16">
                                        <div class="round-sticky-header flex items-center gap-3 mb-6 bg-background/80 backdrop-blur-md py-4 z-20">
                                            <span class="text-yellow-400 font-black italic text-lg whitespace-nowrap">
                                                {group.round > 0 
                                                    ? (league.id.startsWith('league-one') ? `第${group.round}節` : `ROUND ${group.round}`)
                                                    : 'OTHER MATCHES'}
                                                {group.dateRange && (
                                                    <span class="text-foreground/30 text-[10px] ml-2 not-italic font-bold tracking-normal uppercase">
                                                        ({group.dateRange})
                                                    </span>
                                                )}
                                            </span>
                                            <div class="h-px flex-1 bg-border-dim/20"></div>
                                        </div>
                                        
                                        <div class="grid gap-4">
                                            {group.matches.map((result: any) => (
                                                <div class="bg-card/50 backdrop-blur-md border border-border-dim/50 rounded-2xl p-4 md:p-6 hover:border-yellow-400/30 transition-all group relative overflow-hidden">
                                                    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 md:gap-6">
                                                        <!-- Home Team -->
                                                        <div class="flex flex-col md:flex-row items-center md:justify-start justify-end gap-2 md:gap-3 text-right md:text-left overflow-hidden">
                                                            <div class="md:block hidden shrink-0">
                                                                <div class="text-[10px] text-foreground/30 font-bold mb-1 uppercase tracking-wider">
                                                                    {result.date.replace(/-/g, '/')}
                                                                </div>
                                                            </div>
                                                            <div class="flex items-center gap-2 md:gap-3 flex-row-reverse md:flex-row min-w-0 w-full justify-end md:justify-start">
                                                                {result.home_link ? (
                                                                    <a href={result.home_link} class="text-[10px] md:text-xl font-black text-foreground leading-tight truncate md:whitespace-nowrap flex-1 min-w-0 hover:text-yellow-400 transition-colors">
                                                                        {result.home}
                                                                    </a>
                                                                ) : (
                                                                    <span class="text-[10px] md:text-xl font-black text-foreground leading-tight truncate md:whitespace-nowrap flex-1 min-w-0">
                                                                        {result.home}
                                                                    </span>
                                                                )}
                                                                <span class="text-lg md:text-2xl shrink-0">
                                                                    {result.home_flag}
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- Score -->
                                                        <div class="flex flex-col items-center px-1 md:px-4 shrink-0">
                                                            <div class="text-xl md:text-4xl font-black text-yellow-400 italic tracking-widest bg-background px-2 py-1 md:px-6 md:py-2 rounded-lg md:rounded-xl border border-border-dim group-hover:border-yellow-400/50 transition-colors tabular-nums min-w-[70px] md:min-w-none text-center shadow-lg">
                                                                {result.score}
                                                            </div>
                                                            {(result as any).note && (
                                                                <span class="text-[8px] md:text-[10px] text-yellow-400/70 font-bold mt-1 md:mt-2 uppercase tracking-tighter text-center">
                                                                    {(result as any).note}
                                                                </span>
                                                            )}
                                                            <div class="md:hidden mt-1">
                                                                <div class="text-[8px] text-gray-500 font-black whitespace-nowrap text-center uppercase tracking-tighter">
                                                                    {result.date.replace(/-/g, '/')}
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Away Team -->
                                                        <div class="flex flex-col md:flex-row items-center md:justify-end justify-start gap-2 md:gap-3 text-left md:text-right overflow-hidden">
                                                            <div class="flex items-center gap-2 md:gap-3 min-w-0 w-full">
                                                                <span class="text-lg md:text-2xl shrink-0">
                                                                    {result.away_flag}
                                                                </span>
                                                                {result.away_link ? (
                                                                    <a href={result.away_link} class="text-[10px] md:text-xl font-black text-foreground leading-tight truncate md:whitespace-nowrap flex-1 min-w-0 text-left hover:text-yellow-400 transition-colors">
                                                                        {result.away}
                                                                    </a>
                                                                ) : (
                                                                    <span class="text-[10px] md:text-xl font-black text-foreground leading-tight truncate md:whitespace-nowrap flex-1 min-w-0 text-left">
                                                                        {result.away}
                                                                    </span>
                                                                )}
                                                            </div>
                                                        </div>
                                                    </div>

                                                    {result.detail_url && (
                                                        <div class="mt-4 flex justify-center md:justify-start">
                                                            <a 
                                                                href={result.detail_url} 
                                                                target="_blank" 
                                                                rel="noopener noreferrer"
                                                                class="inline-flex items-center gap-2 text-[10px] md:text-xs font-black text-gray-400 hover:text-yellow-400 transition-colors uppercase tracking-widest group/link"
                                                            >
                                                                <span>MATCH CENTER</span>
                                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="9 5l7 7-7 7" />
                                                                </svg>
                                                            </a>
                                                        </div>
                                                    )}
                                                </div>
                                            ))}
                                        </div>
                                        
                                        {/* 戻る操作の改善 */}
                                        <div class="mt-8 flex justify-end">
                                            <a 
                                                href={`#${league.id}-round-selector`} 
                                                class="inline-flex items-center gap-2 text-[8px] font-black text-foreground/20 hover:text-yellow-400 transition-colors uppercase tracking-[0.2em] group/back"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover:-translate-y-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
                                                Back to Selection
                                            </a>
                                        </div>
                                    </div>
								))}
							</div>
						</section>
					);
				})}
			</div>

            <!-- モバイル用フローティングRoundジャンプメニュー -->
            <div id="mobile-round-nav" class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-[60] w-[95%] max-w-sm transform transition-all duration-500 pointer-events-auto">
                <div class="bg-background/95 backdrop-blur-3xl border border-border-dim/50 rounded-[2.5rem] p-6 shadow-[0_20px_50px_rgba(0,0,0,0.3)] relative overflow-hidden pointer-events-auto">
                    <!-- 背景のカラーアクセント (JSで色変更) -->
                    <div id="mobile-nav-accent" class="absolute -top-32 -right-32 w-64 h-64 bg-yellow-400/20 rounded-full blur-[60px] transition-all duration-700"></div>

                    <div class="relative z-10">
                        <div class="flex items-center justify-between mb-5 px-1">
                            <div class="flex items-center gap-3">
                                <div id="mobile-league-badge" class="w-2.5 h-2.5 rounded-full bg-yellow-400 shadow-[0_0_15px_rgba(250,204,21,0.4)]"></div>
                                <span id="mobile-current-league-name" class="text-xs font-black text-foreground uppercase tracking-wider italic">リーグワン</span>
                                <!-- リーグワン用Divセレクター (SP) -->
                                <div id="mobile-div-selector" class="hidden items-center gap-1.5 ml-1 pl-3 border-l border-border-dim/30">
                                    {['D1', 'D2', 'D3'].map(d => (
                                        <button 
                                            data-league-div={`league-one-${d.toLowerCase()}`}
                                            class="mobile-div-btn text-[9px] font-black px-2 py-1 rounded bg-foreground/5 text-foreground/40 border border-border-dim/20 transition-all active:scale-90"
                                        >
                                            {d}
                                        </button>
                                    ))}
                                </div>
                            </div>
                            <a href="#top" class="text-[10px] font-black text-foreground/40 hover:text-foreground uppercase tracking-[0.2em] transition-colors bg-foreground/5 px-3 py-1.5 rounded-full border border-border-dim/30">TOP</a>
                        </div>

                        <!-- ラウンド選択 (プルダウン) -->
                        <div class="relative group/select mb-6">
                            <select 
                                id="mobile-round-select"
                                class="w-full bg-foreground/5 border border-border-dim/30 rounded-2xl p-4 text-xs font-black text-foreground/60 appearance-none cursor-pointer focus:outline-none focus:border-yellow-400 transition-all uppercase tracking-widest shadow-inner"
                            >
                                <option value="" disabled selected>Select Round</option>
                                {(() => {
                                    const l1d1 = getLeagueResults(leagues.find(l => l.id === 'league-one-d1'));
                                    return l1d1.map((group: any) => (
                                        <option value={`#league-one-d1-round-${group.round}`}>
                                            ROUND {group.round > 0 ? group.round : '?'}
                                        </option>
                                    ));
                                })()}
                            </select>
                            <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-foreground/20 group-hover/select:text-yellow-400 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        </div>

                        <!-- リーグクイックチェンジ: タブ形式に改善 -->
                        <div class="pt-5 border-t border-border-dim/30 flex items-center justify-between px-1">
                            <span class="text-[8px] font-black text-foreground/20 uppercase tracking-widest mr-2">Switch:</span>
                            <div class="flex flex-1 justify-between gap-2">
                                {[
                                    { id: 'league-one-d1', label: 'L1', color: 'hover:text-red-500' },
                                    { id: 'super-rugby', label: 'SR', color: 'hover:text-blue-500' },
                                    { id: 'top14', label: 'T14', color: 'hover:text-yellow-500' }
                                ].map(l => (
                                    <button 
                                        data-league-switch={l.id} 
                                        class={`flex-1 py-2.5 rounded-xl bg-foreground/5 text-[10px] font-black text-foreground/30 uppercase tracking-widest transition-all active:scale-95 ${l.color} hover:bg-foreground/10 active:bg-foreground/20 border border-border-dim/20`}
                                    >
                                        {l.label}
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="mt-20 text-center">
                <p class="text-foreground/30 text-sm italic">
                    ※データは2026年3月12日現在のものです。
                </p>
            </div>
    </main>
</Layout>

<script>
    const buttons = document.querySelectorAll('.filter-btn');
    const sections = document.querySelectorAll('.league-section');
    let activeLeague = 'all';

    buttons.forEach(button => {
        button.addEventListener('click', () => {
            const league = button.getAttribute('data-league');
            updateFilter(league || 'all');
        });
    });

    // リーグ別カラー設定
    const leagueColors: Record<string, { badge: string; accent: string; name: string }> = {
        'league-one-d1': { badge: 'bg-red-600', accent: 'bg-red-600/10', name: 'リーグワン D1' },
        'league-one-d2': { badge: 'bg-red-600', accent: 'bg-red-600/10', name: 'リーグワン D2' },
        'league-one-d3': { badge: 'bg-red-600', accent: 'bg-red-600/10', name: 'リーグワン D3' },
        'league-one': { badge: 'bg-red-600', accent: 'bg-red-600/10', name: 'リーグワン' },
        'super-rugby': { badge: 'bg-blue-600', accent: 'bg-blue-600/10', name: 'スーパーラグビー' },
        'top14': { badge: 'bg-yellow-600', accent: 'bg-yellow-600/10', name: 'Top 14' },
        'all': { badge: 'bg-yellow-400', accent: 'bg-yellow-400/20', name: 'All Leagues' }
    };

    function updateFilter(league: string) {
        console.log('Updating filter to:', league);
        
        // 以前のアクティブリーグを保持
        const prevLeague = activeLeague;

        // トグル処理
        if (activeLeague === league && league !== 'all') {
            activeLeague = 'all';
        } else {
            activeLeague = league || 'all';
        }

        // リーグワン親カテゴリが選択された場合、デフォルトでD1を表示
        if (activeLeague === 'league-one') {
            activeLeague = 'league-one-d1';
        }

        // フィルターボタンの更新 (メイン + サブ)
        buttons.forEach(btn => {
            const btnLeague = btn.getAttribute('data-league');
            const isActive = btnLeague === activeLeague || (activeLeague.startsWith('league-one') && btnLeague === 'league-one');
            
            if (isActive) {
                btn.classList.add('bg-yellow-400', 'text-black', 'shadow-[0_0_20px_rgba(250,204,21,0.3)]', 'italic', 'opacity-100');
                btn.classList.remove('bg-card', 'bg-card/30', 'bg-card/50', 'text-foreground/40', 'border-border-dim');
            } else {
                btn.classList.remove('bg-yellow-400', 'text-black', 'shadow-[0_0_20px_rgba(250,204,21,0.3)]', 'italic');
                btn.classList.add('bg-card/50', 'text-foreground/40', 'border-border-dim');
                if (btn.classList.contains('bg-card/30')) btn.classList.remove('bg-card/50'); // サブボタン用
            }
        });

        // リーグワン・サブフィルターの表示制御
        const subFilters = document.getElementById('league-one-sub-filters');
        const mobileDivSelector = document.getElementById('mobile-div-selector');
        
        if (activeLeague.startsWith('league-one')) {
            subFilters?.classList.remove('hidden');
            subFilters?.classList.add('flex');
            mobileDivSelector?.classList.remove('hidden');
            mobileDivSelector?.classList.add('flex');
        } else {
            subFilters?.classList.add('hidden');
            subFilters?.classList.remove('flex');
            mobileDivSelector?.classList.add('hidden');
            mobileDivSelector?.classList.remove('flex');
        }

        // モバイルDivボタンのハイライト
        document.querySelectorAll('.mobile-div-btn').forEach(btn => {
            if (btn.getAttribute('data-league-div') === activeLeague) {
                btn.classList.add('bg-yellow-400', 'text-black', 'border-yellow-500');
                btn.classList.remove('bg-foreground/5', 'text-foreground/40');
            } else {
                btn.classList.remove('bg-yellow-400', 'text-black', 'border-yellow-500');
                btn.classList.add('bg-foreground/5', 'text-foreground/40');
            }
        });

        const targetLeague = activeLeague === 'all' ? 'league-one-d1' : activeLeague;
        const colorSet = leagueColors[targetLeague] || leagueColors['all'];

        // サイドバー & モバイルナビのリーグボタンのハイライト
        document.querySelectorAll('[data-league-switch]').forEach(btn => {
            const switchId = btn.getAttribute('data-league-switch');
            const isActive = switchId === activeLeague || (activeLeague.startsWith('league-one') && switchId === 'league-one-d1');
            
            if (isActive) {
                btn.classList.add('border-yellow-400', 'bg-foreground/10', 'text-foreground');
                btn.classList.remove('text-foreground/20', 'text-foreground/30', 'border-border-dim/30');
            } else {
                btn.classList.remove('border-yellow-400', 'bg-foreground/10', 'text-foreground');
                btn.classList.add('border-border-dim/30');
            }
        });

        // サイドバー & モバイルナビのラウンドリンク更新
        const allRoundLinks = document.querySelectorAll('.sidebar-round-link, .mobile-round-link');
        allRoundLinks.forEach(link => {
            const round = link.getAttribute('data-round');
            link.setAttribute('href', `#${targetLeague}-round-${round}`);
        });

        // モバイルナビのラウンドプルダウンを動的に更新 (データがあるものだけ)
        const mobileRoundSelect = document.getElementById('mobile-round-select') as HTMLSelectElement;
        const targetSection = document.querySelector(`section[data-league="${targetLeague}"]`);
        if (mobileRoundSelect && targetSection) {
            const rounds = Array.from(targetSection.querySelectorAll('.round-group')).map(rg => {
                const id = rg.id;
                const roundNum = id.split('-round-')[1];
                return roundNum;
            });

            mobileRoundSelect.innerHTML = '<option value="" disabled selected>Select Round</option>' + 
                rounds.map(r => `<option value="#${targetLeague}-round-${r}">ROUND ${Number(r) > 0 ? r : '?'}</option>`).join('');

            // サイドバー等の購読コンポーネントへ通知
            window.dispatchEvent(new CustomEvent('leagueFilterUpdated', { 
                detail: { league: targetLeague, rounds: rounds.map(Number) } 
            }));
        }

        // 各セクションの表示・非表示を切り替え (New)
        const sections = document.querySelectorAll('.league-section') as NodeListOf<HTMLElement>;
        sections.forEach(section => {
            const leagueId = section.getAttribute('data-league');
            if (activeLeague === 'all' || leagueId === activeLeague) {
                section.style.display = 'block';
            } else {
                section.style.display = 'none';
            }
        });

        // モバイル用フローティングナビゲーションの表示制御
        const mobileRoundNav = document.getElementById('mobile-round-nav');
        if (window.innerWidth < 1024) {
            // リーグが選択されたら強制表示
            if (activeLeague !== 'all') {
                mobileRoundNav?.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            }
        }
    }

    // イベントリスナーの登録 (デリゲーション)
    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const leagueBtn = target.closest('[data-league-switch]') || target.closest('.mobile-div-btn');
        
        if (leagueBtn) {
            const league = leagueBtn.getAttribute('data-league-switch') || leagueBtn.getAttribute('data-league-div');
            updateFilter(league || 'all');
            
            // スクロール (対象セクションが見やすい位置へ)
            const targetSect = document.querySelector(`section[data-league="${league}"]`);
            if (targetSect) {
                setTimeout(() => {
                    const offset = 100;
                    const bodyRect = document.body.getBoundingClientRect().top;
                    const elementRect = targetSect.getBoundingClientRect().top;
                    const elementPosition = elementRect - bodyRect;
                    const offsetPosition = elementPosition - offset;
                    window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
                }, 50);
            }
        }
    });

    // モニタリング: スクロールによる表示制御は削除（updateFilterで制御するため）
    // window.addEventListener('scroll', ...) は不要になったので削除するか、簡略化
    // モバイルナビのスクロール監視
    window.addEventListener('scroll', () => {
        const mobileRoundNav = document.getElementById('mobile-round-nav');
        if (window.innerWidth < 1024) {
            if (activeLeague === 'all') {
                if (window.scrollY > 400) {
                    mobileRoundNav?.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
                } else {
                    mobileRoundNav?.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
                }
            } else {
                // リーグ選択時は常に表示
                mobileRoundNav?.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            }
        }
    });

    // 節ジャンプ・プルダウンの制御 (PC & Mobile)
    document.addEventListener('change', (e) => {
        const targetSelect = e.target as HTMLSelectElement;
        if (targetSelect.classList.contains('round-jump-select') || targetSelect.id === 'mobile-round-select') {
            const val = targetSelect.value;
            if (val) {
                window.location.hash = val;
                // 少しだけスクロール位置を調整
                setTimeout(() => {
                    window.scrollBy(0, -120);
                }, 10);
            }
        }
    });

    // クエリパラメータによる初期フィルタ設定とスクロール
    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const leagueParam = urlParams.get('league');
        const roundParam = urlParams.get('round');
        
        if (leagueParam) {
            let targetLeague = leagueParam;
            if (leagueParam === 'league-one') targetLeague = 'league-one-d1';
            updateFilter(targetLeague);

            if (!roundParam) {
                const targetSection = document.querySelector(`section[data-league="${targetLeague}"]`);
                if (targetSection) {
                    setTimeout(() => {
                        targetSection.scrollIntoView({ behavior: 'smooth' });
                    }, 100);
                }
            }
        } else {
            // クエリパラメータがない場合も初期化してサイドバーを同期させる (New)
            updateFilter('league-one-d1');
        }

        if (roundParam) {
            const leagueId = leagueParam || 'league-one-d1';
            const targetId = `${leagueId}-round-${roundParam}`;
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
                setTimeout(() => {
                    const offset = 120; // sticky header offset
                    const bodyRect = document.body.getBoundingClientRect().top;
                    const elementRect = targetEl.getBoundingClientRect().top;
                    const elementPosition = elementRect - bodyRect;
                    const offsetPosition = elementPosition - offset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }, 200);
            }
        }
    });
</script>

<style>
    .round-sticky-header {
        position: sticky;
        top: 72px; /* Navbar height */
        margin-top: -8px;
    }
</style>
