---
import Layout from "../../layouts/Layout.astro";
import resultsData from "../../../data/results_2026.json";

const leagues = [
    { id: "league-one-d1", name: "League One D1", label: "リーグワン D1", parentId: "league-one", division: "D1" },
    { id: "league-one-d2", name: "League One D2", label: "リーグワン D2", parentId: "league-one", division: "D2" },
    { id: "league-one-d3", name: "League One D3", label: "リーグワン D3", parentId: "league-one", division: "D3" },
    { id: "super-rugby", name: "Super Rugby", label: "スーパーラグビー" },
    { id: "top14", name: "Top 14", label: "TOP 14" },
    { id: "urc", name: "URC", label: "URC" },
];

// データを整形して最新順にする（JSON 側でも最新順だが、念のためここでもソート）
const getLeagueResults = (league: any) => {
    let results = [];
    if (league.parentId === "league-one") {
        results = (resultsData as any)["league-one"]?.filter((r: any) => r.division === league.division) || [];
    } else {
        results = (resultsData as any)[league.id] || [];
    }
    return results.sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
};
---

<Layout title="試合結果・戦績一覧 | RUGBY PICKS">
    <main class="bg-black min-h-screen pt-8 pb-20">
        <div class="container mx-auto px-4">
            <header class="mb-12 text-center">
                <h1
                    class="text-5xl font-black text-white italic tracking-tighter mb-4"
                >
                    MATCH <span class="text-yellow-400">RESULTS</span>
                </h1>
                <p class="text-gray-400 max-w-2xl mx-auto font-bold">
                    2025-26シーズンの全試合結果。常に最新の試合を最上部に表示。
                </p>
            </header>

            <!-- フィルター -->
            <div class="flex flex-wrap justify-center gap-3 mb-12" id="filter-container">
                <button
                    class="filter-btn px-5 py-2 bg-yellow-400 text-black font-black italic rounded-xl shadow-[0_0_20px_rgba(250,204,21,0.3)] text-sm transition-all"
                    data-league="all"
                >
                    ALL
                </button>
                {
                    leagues.map((league) => (
                        <button 
                            class="filter-btn px-5 py-2 bg-gray-900 text-white font-bold rounded-xl border border-gray-800 hover:border-yellow-400 transition-all text-sm"
                            data-league={league.id}
                        >
                            {league.label}
                        </button>
                    ))
                }
            </div>

			<!-- 戦績リスト (リーグ/Divisionごとにグループ化) -->
			<div class="max-w-4xl mx-auto space-y-16" id="results-container">
				{leagues.map((league) => {
					const leagueResults = getLeagueResults(league);
					if (leagueResults.length === 0) return null;

					return (
						<section data-league={league.id} class="league-section">
							<div class="flex items-center gap-4 mb-8">
								<h2 class={`text-xl md:text-2xl font-black px-6 py-2 rounded-xl italic skew-x-[-10deg] ${
									league.id.startsWith('league-one') ? 'bg-red-600 text-white' :
									league.id === 'super-rugby' ? 'bg-blue-600 text-white' :
									league.id === 'top14' ? 'bg-yellow-600 text-black' : 'bg-gray-800 text-white'
								}`}>
									{league.name.toUpperCase()}
								</h2>
								<div class="h-[2px] flex-1 bg-gradient-to-r from-gray-800 to-transparent"></div>
							</div>

							<div class="space-y-4">
								{leagueResults.map((result: any) => (
									<div class="bg-gray-900/50 backdrop-blur-md border border-gray-800/50 rounded-2xl p-4 md:p-6 hover:border-yellow-400/30 transition-all group relative overflow-hidden">
										<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 md:gap-6">
											<!-- Home Team -->
											<div class="flex flex-col md:flex-row items-center md:justify-start justify-end gap-2 md:gap-3 text-right md:text-left overflow-hidden">
												<div class="md:block hidden shrink-0">
													<div class="text-[10px] text-gray-500 font-bold mb-1 uppercase tracking-wider">
														{result.date.replace(/-/g, '/')} {result.round ? `• RD ${result.round}` : ''}
													</div>
												</div>
												<div class="flex items-center gap-2 md:gap-3 flex-row-reverse md:flex-row min-w-0 w-full justify-end md:justify-start">
													<span class="text-[10px] md:text-xl font-black text-white leading-tight truncate md:whitespace-nowrap flex-1 min-w-0">
														{result.home}
													</span>
													<span class="text-lg md:text-2xl shrink-0">
														{result.home_flag}
													</span>
												</div>
											</div>

											<!-- Score -->
											<div class="flex flex-col items-center px-1 md:px-4 shrink-0">
												<div class="text-xl md:text-4xl font-black text-yellow-400 italic tracking-widest bg-black px-2 py-1 md:px-6 md:py-2 rounded-lg md:rounded-xl border border-gray-800 group-hover:border-yellow-400/50 transition-colors tabular-nums min-w-[70px] md:min-w-none text-center shadow-lg">
													{result.score}
												</div>
												{(result as any).note && (
													<span class="text-[8px] md:text-[10px] text-yellow-400/70 font-bold mt-1 md:mt-2 uppercase tracking-tighter text-center">
														{(result as any).note}
													</span>
												)}
												<div class="md:hidden mt-1">
													<div class="text-[8px] text-gray-500 font-black whitespace-nowrap text-center uppercase tracking-tighter">
														{result.date.replace(/-/g, '/')} {result.round ? `• RD ${result.round}` : ''}
													</div>
												</div>
											</div>

											<!-- Away Team -->
											<div class="flex flex-col md:flex-row items-center md:justify-end justify-start gap-2 md:gap-3 text-left md:text-right overflow-hidden">
												<div class="flex items-center gap-2 md:gap-3 min-w-0 w-full">
													<span class="text-lg md:text-2xl shrink-0">
														{result.away_flag}
													</span>
													<span class="text-[10px] md:text-xl font-black text-white leading-tight truncate md:whitespace-nowrap flex-1 min-w-0 text-left">
														{result.away}
													</span>
												</div>
											</div>
										</div>
									</div>
								))}
							</div>
						</section>
					);
				})}
			</div>

            <div class="mt-20 text-center">
                <p class="text-gray-600 text-sm italic">
                    ※データは2026年3月9日現在のものです。
                </p>
            </div>
        </div>
    </main>
</Layout>

<script>
    const buttons = document.querySelectorAll('.filter-btn');
    const sections = document.querySelectorAll('.league-section');
    let activeLeague = 'all';

    buttons.forEach(button => {
        button.addEventListener('click', () => {
            const league = button.getAttribute('data-league');
            
            // トグル処理: クリックされたのが現在のアクティブなリーグなら解除（ALLに戻す）
            if (activeLeague === league && league !== 'all') {
                activeLeague = 'all';
            } else {
                activeLeague = league || 'all';
            }

            // UIの更新
            buttons.forEach(btn => {
                if (btn.getAttribute('data-league') === activeLeague) {
                    btn.classList.add('bg-yellow-400', 'text-black', 'shadow-[0_0_20px_rgba(250,204,21,0.3)]', 'italic');
                    btn.classList.remove('bg-gray-900', 'text-white', 'border-gray-800');
                } else {
                    btn.classList.remove('bg-yellow-400', 'text-black', 'shadow-[0_0_20px_rgba(250,204,21,0.3)]', 'italic');
                    btn.classList.add('bg-gray-900', 'text-white', 'border-gray-800');
                }
            });

            // コンテンツの表示制御
            sections.forEach(section => {
                const sectLeague = section.getAttribute('data-league');
                if (activeLeague === 'all' || sectLeague === activeLeague) {
                    (section as HTMLElement).style.display = 'block';
                } else {
                    (section as HTMLElement).style.display = 'none';
                }
            });
        });
    });
</script>

<style>
    main {
        background: radial-gradient(
            circle at 50% -20%,
            #1a1a1a 0%,
            #000000 100%
        );
    }
</style>
