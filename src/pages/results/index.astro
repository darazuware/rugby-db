---
import Layout from "../../layouts/Layout.astro";
import resultsData from "../../../data/results_2026.json";

const leagues = [
    { id: "league-one", name: "League One", label: "リーグワン" },
    { id: "super-rugby", name: "Super Rugby", label: "スーパーラグビー" },
    { id: "top14", name: "Top 14", label: "TOP 14" },
    { id: "urc", name: "URC", label: "URC" },
];

// データを整形して降順（最新順）に並べる
const allResults = Object.entries(resultsData)
    .flatMap(([leagueId, results]) => results.map((r) => ({ ...r, leagueId })))
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="試合結果・戦績一覧 | RUGBY PICKS">
    <main class="bg-black min-h-screen pt-8 pb-20">
        <div class="container mx-auto px-4">
            <header class="mb-12 text-center">
                <h1
                    class="text-5xl font-black text-white italic tracking-tighter mb-4"
                >
                    MATCH <span class="text-yellow-400">RESULTS</span>
                </h1>
                <p class="text-gray-400 max-w-2xl mx-auto font-bold">
                    2025-26シーズンの全試合結果。過去の激闘から最新のスコアまで網羅。
                </p>
            </header>

            <!-- フィルター (簡易実装) -->
            <div class="flex flex-wrap justify-center gap-4 mb-12">
                <button
                    class="px-6 py-2 bg-yellow-400 text-black font-black italic rounded-full shadow-[0_0_20px_rgba(250,204,21,0.3)]"
                >
                    ALL LEAGUES
                </button>
                {
                    leagues.map((league) => (
                        <button class="px-6 py-2 bg-gray-900 text-white font-bold rounded-full border border-gray-800 hover:border-yellow-400 transition-all">
                            {league.label}
                        </button>
                    ))
                }
            </div>

            <!-- 戦績リスト -->
            <div class="max-w-4xl mx-auto space-y-4">
                {
                    allResults.map((result) => (
                        <div class="bg-gray-900/50 backdrop-blur-md border border-gray-800/50 rounded-2xl p-6 hover:border-yellow-400/30 transition-all group relative overflow-hidden">
                            <div class="absolute top-0 right-0 p-2">
                                <span
                                    class={`text-[10px] font-black px-2 py-0.5 rounded uppercase ${
                                        result.leagueId === "league-one"
                                            ? "bg-red-600 text-white"
                                            : result.leagueId === "super-rugby"
                                            ? "bg-blue-600 text-white"
                                            : result.leagueId === "top14"
                                            ? "bg-yellow-600 text-black"
                                            : "bg-navy-900 text-white"
                                    }`}
                                >
                                    {result.leagueId}
                                </span>
                            </div>

                            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                                <div class="text-center md:text-left">
                                    <div class="text-xs text-gray-500 font-bold mb-1">
                                        {result.date} • ROUND {result.round}
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="text-2xl">
                                            {result.home_flag}
                                        </span>
                                        <span class="text-xl font-black text-white whitespace-nowrap">
                                            {result.home}
                                        </span>
                                    </div>
                                </div>

                                <div class="flex flex-col items-center">
                                    <div class="text-4xl font-black text-yellow-400 italic tracking-widest bg-black px-6 py-2 rounded-xl border border-gray-800 group-hover:border-yellow-400/50 transition-colors">
                                        {result.score}
                                    </div>
                                    {(result as any).note && (
                                        <span class="text-[10px] text-yellow-400/70 font-bold mt-2 uppercase tracking-tighter">
                                            {(result as any).note}
                                        </span>
                                    )}
                                </div>

                                <div class="text-center md:text-right">
                                    <div class="text-xs text-gray-500 font-bold mb-1 opacity-0 md:opacity-100">
                                        &nbsp;
                                    </div>
                                    <div class="flex items-center justify-end gap-3 flex-row-reverse md:flex-row">
                                        <span class="text-xl font-black text-white whitespace-nowrap">
                                            {result.away}
                                        </span>
                                        <span class="text-2xl">
                                            {result.away_flag}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="mt-20 text-center">
                <p class="text-gray-600 text-sm italic">
                    ※データは2026年3月9日現在のものです。
                </p>
            </div>
        </div>
    </main>
</Layout>

<style>
    main {
        background: radial-gradient(
            circle at 50% -20%,
            #1a1a1a 0%,
            #000000 100%
        );
    }
</style>
