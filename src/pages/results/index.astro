---
import Layout from "../../layouts/Layout.astro";
import resultsData from "../../../data/results_2026.json";
import teamNamesJp from "../../../data/team_names_jp.json";
import teamsData from "../../../data/teams.json";

const leagues = [
    { id: "league-one", name: "リーグワン", label: "リーグワン", isParent: true },
    { id: "league-one-d1", name: "リーグワン D1", label: "D1", parentId: "league-one", division: "D1" },
    { id: "league-one-d2", name: "リーグワン D2", label: "D2", parentId: "league-one", division: "D2" },
    { id: "league-one-d3", name: "リーグワン D3", label: "D3", parentId: "league-one", division: "D3" },
    { id: "super-rugby", name: "スーパーラグビー", label: "スーパーラグビー" },
    { id: "top14", name: "TOP 14", label: "TOP 14" },
    { id: "urc", name: "URC", label: "URC" },
    { id: "premiership", name: "プレミアシップ", label: "PREM" },
];

// チームのスラッグを取得するヘルパー
const getTeamSlug = (leagueId: string, teamName: string) => {
    if (!teamName) return null;
    const leagueKey = leagueId.startsWith('league-one') ? 'league-one' : leagueId;
    const cleanName = teamName.trim();
    
    // 1. 完全一致
    let team = (teamsData as any).find((t: any) => 
        t.league === leagueKey && t.team_name === cleanName
    );
    
    // 2. 部分一致 (teams.json の名称が長い場合など)
    if (!team) {
        team = (teamsData as any).find((t: any) => 
            t.league === leagueKey && (t.team_name.includes(cleanName) || cleanName.includes(t.team_name))
        );
    }
    
    return team ? `/teams/${leagueKey}/${team.slug}` : null;
};

// チーム名正規化関数
const normalizeTeam = (leagueId: string, name: string) => {
    if (!name) return { name: "Unknown", flag: null };
    const leagueKey = leagueId.startsWith('league-one') ? 'league-one' : leagueId;
    const leagueData = (teamNamesJp as any)[leagueKey] || {};
    const cleanInput = name.trim();
    
    if (leagueData[cleanInput]) return { name: leagueData[cleanInput].jp, flag: leagueData[cleanInput].flag };
    for (const [fullName, data] of Object.entries(leagueData)) {
        if ((data as any).jp === cleanInput) return { name: (data as any).jp, flag: (data as any).flag };
    }
    
    for (const [fullName, data] of Object.entries(leagueData)) {
        const d = data as any;
        const lowerInput = cleanInput.toLowerCase();
        if (d.aliases?.some((a: string) => a.toLowerCase().trim() === lowerInput) || 
            fullName.toLowerCase().trim().includes(lowerInput) ||
            lowerInput.includes(fullName.toLowerCase().trim())) {
            return { name: d.jp, flag: d.flag };
        }
    }
    
    return { name: cleanInput, flag: null };
};

// Round ごとにグルーピング
const groupByRound = (leagueId: string, results: any[]) => {
    const filteredResults = results.filter(r => {
        const home = r.home || "";
        const away = r.away || "";
        const garbage = ["リーグ戦", "準々", "準決", "決勝", "決定戦", "入替戦", "TBD"];
        return !garbage.some(g => home.includes(g) || away.includes(g));
    });

    const allEnhancedResults = filteredResults.map(r => {
        const normHome = normalizeTeam(leagueId, r.home);
        const normAway = normalizeTeam(leagueId, r.away);
        return {
            ...r,
            home: normHome.name,
            home_flag: normHome.flag || r.home_flag,
            home_link: getTeamSlug(leagueId, normHome.name),
            away: normAway.name,
            away_flag: normAway.flag || r.away_flag,
            away_link: getTeamSlug(leagueId, normAway.name),
            round: parseInt(r.round) || 0,
            _dateObj: new Date(r.date.replace(/\//g, '-'))
        };
    });

    const groups: { [key: number]: any[] } = {};
    allEnhancedResults.forEach(m => {
        const round = m.round;
        if (!groups[round]) groups[round] = [];
        groups[round].push(m);
    });

    return Object.keys(groups)
        .map(Number)
        .sort((a, b) => b - a)
        .map(round => {
            const matches = groups[round].sort((a, b) => b._dateObj.getTime() - a._dateObj.getTime());
            const dates = matches.map(m => m.date).filter(Boolean).sort();
            const minDate = dates[0] ? dates[0].replace(/-/g, '.') : "";
            const maxDate = dates[dates.length - 1] ? dates[dates.length - 1].replace(/-/g, '.') : "";
            const isAllFuture = matches.every(m => m.score === "VS" || m.score === "vs");
            
            return {
                round,
                matches,
                dateRange: minDate && maxDate ? (minDate === maxDate ? minDate : `${minDate} 〜 ${maxDate}`) : "",
                isAllFuture
            };
        });
};

const getLeagueResults = (league: any) => {
    const data = (resultsData as any).default || resultsData;
    const leagueKey = league.id === 'premiership' ? 'premiership' : 
                     (league.id.startsWith('league-one') ? 'league-one' : league.id);
    
    let results = [];
    if (league.parentId === "league-one") {
        const targetDiv = (league.division || "").toUpperCase().trim();
        results = (data as any)["league-one"]?.filter((r: any) => {
            const rDiv = (r.division || "").toUpperCase().trim();
            return rDiv.includes(targetDiv);
        }) || [];
    } else {
        results = (data as any)[leagueKey] || [];
    }
    return groupByRound(leagueKey, results);
};

const urlLeague = Astro.url.searchParams.get('league');
let initialLeague = urlLeague || 'league-one-d1';
if (initialLeague === 'league-one') initialLeague = 'league-one-d1';
---

<Layout 
    title="試合結果・戦績一覧 | RUGBY PICKS"
    sidebarType="results"
    activeLeague={initialLeague}
>
    <main class="pb-20">
        <header class="mb-12">
            <h1 class="text-4xl md:text-5xl font-black text-foreground italic tracking-tighter mb-4 uppercase">
                Match <span class="text-yellow-400">Results</span>
            </h1>
            <p class="text-foreground/40 font-bold text-sm">
                2025-26シーズンの全試合結果。常に最新の試合を最上部に表示。
            </p>
        </header>

        <div class="flex flex-col gap-4 mb-12" id="filter-wrapper">
            <div class="flex flex-wrap gap-2" id="filter-container">
                <button class="filter-btn px-4 py-2 bg-yellow-400 text-black font-black italic rounded-xl shadow-lg shadow-yellow-400/20 text-[10px] transition-all uppercase tracking-widest" data-league="all">
                    ALL
                </button>
                {leagues.filter(l => !l.parentId).map((league) => (
                    <button class="filter-btn px-4 py-2 bg-card/50 text-foreground/40 font-black rounded-xl border border-border-dim hover:border-yellow-400 opacity-80 hover:opacity-100 hover:text-foreground transition-all text-[10px] uppercase tracking-widest" data-league={league.id}>
                        {league.label}
                    </button>
                ))}
            </div>

            <div id="league-one-sub-filters" class="flex flex-wrap gap-2 pl-4 border-l-2 border-red-600/30 hidden transition-all duration-300">
                <span class="text-[9px] font-black text-foreground/30 uppercase self-center mr-2 italic">Division:</span>
                {leagues.filter(l => l.parentId === 'league-one').map((league) => (
                    <button class="filter-btn px-3 py-1.5 bg-card/30 text-foreground/40 font-black rounded-lg border border-border-dim hover:border-red-500/50 hover:text-foreground transition-all text-[9px] uppercase tracking-widest" data-league={league.id}>
                        {league.label}
                    </button>
                ))}
            </div>
        </div>

        <div class="max-w-4xl mx-auto space-y-16" id="results-container">
            {leagues.filter(l => !l.isParent).map((league) => {
                const leagueResults = getLeagueResults(league);
                if (leagueResults.length === 0) return null;

                return (
                    <section id={league.id} data-league={league.id} class="league-section mb-20 scroll-mt-24">
                        <div class="flex items-center gap-4 mb-8">
                            <h2 class={`text-xl md:text-2xl font-black px-6 py-2 rounded-xl italic skew-x-[-10deg] ${
                                league.id.startsWith('league-one') ? 'bg-red-600 text-white' :
                                league.id === 'super-rugby' ? 'bg-blue-600 text-white' :
                                league.id === 'top14' ? 'bg-yellow-600 text-black' : 
                                league.id === 'premiership' ? 'bg-[#FE5000] text-black' :
                                league.id === 'urc' ? 'bg-[#003366] text-white' : 'bg-card text-foreground'
                            }`}>
                                {league.name.toUpperCase()}
                            </h2>
                            <div class="h-[2px] flex-1 bg-gradient-to-r from-border-dim to-transparent"></div>
                        </div>

                        <div class="space-y-12">
                            <div class="mb-12" id={`${league.id}-round-selector`}>
                                <div class="flex items-center gap-3 mb-4">
                                    <h3 class="text-xs font-black text-foreground/40 uppercase tracking-widest italic">Jump to Round</h3>
                                    <div class="h-px flex-1 bg-border-dim/30"></div>
                                </div>
                                <div class="relative max-w-xs group/select">
                                    <select class="round-jump-select w-full bg-card/40 border border-border-dim/50 rounded-xl px-4 py-2.5 text-[10px] font-black text-foreground/60 appearance-none cursor-pointer focus:outline-none focus:border-yellow-400 transition-all uppercase tracking-widest" data-league-id={league.id}>
                                        <option value="" disabled selected>Select Round</option>
                                        {leagueResults.map((group: any) => (
                                            <option value={`#${league.id}-round-${group.round}`}>
                                                {group.round > 0 ? (league.id.startsWith('league-one') ? `第${group.round}節` : `ROUND ${group.round}`) : 'OTHER MATCHES'}
                                            </option>
                                        ))}
                                    </select>
                                    <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-foreground/20 group-hover/select:text-yellow-400 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                    </div>
                                </div>
                            </div>

                            {leagueResults.map((group: any) => (
                                <div id={`${league.id}-round-${group.round}`} class={`round-group scroll-mt-24 mb-16 ${group.isAllFuture ? 'hidden' : ''}`} style={group.isAllFuture ? "display: none;" : ""}>
                                    <div class="round-sticky-header flex items-center gap-3 mb-6 bg-background/80 backdrop-blur-md py-4 z-20">
                                        <span class="text-yellow-400 font-black italic text-lg whitespace-nowrap">
                                            {group.round > 0 ? (league.id.startsWith('league-one') ? `第${group.round}節` : `ROUND ${group.round}`) : 'OTHER MATCHES'}
                                            {group.dateRange && <span class="text-foreground/30 text-[10px] ml-2 not-italic font-bold uppercase">({group.dateRange})</span>}
                                        </span>
                                        <div class="h-px flex-1 bg-border-dim/20"></div>
                                    </div>
                                    
                                    <div class="grid gap-4">
                                        {group.matches.map((result: any) => (
                                            <div class="bg-card/50 backdrop-blur-md border border-border-dim/50 rounded-2xl p-4 md:p-6 hover:border-yellow-400/30 transition-all group relative overflow-hidden">
                                                <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 md:gap-6">
                                                    <div class="flex flex-col md:flex-row items-center md:justify-start justify-end gap-2 md:gap-3 text-right md:text-left overflow-hidden">
                                                        <div class="md:block hidden shrink-0 text-[10px] text-foreground/30 font-bold uppercase">{result.date}</div>
                                                        <div class="flex items-center gap-2 md:gap-3 flex-row-reverse md:flex-row min-w-0 w-full justify-end md:justify-start">
                                                            {result.home_link ? <a href={result.home_link} class="text-[10px] md:text-xl font-black text-foreground hover:text-yellow-400 truncate">{result.home}</a> : <span class="text-[10px] md:text-xl font-black text-foreground truncate">{result.home}</span>}
                                                            <span class="text-lg md:text-2xl">{result.home_flag}</span>
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-col items-center px-1 md:px-4 shrink-0">
                                                        <div class="text-xl md:text-4xl font-black text-yellow-400 italic bg-background px-2 py-1 md:px-6 md:py-2 rounded-lg border border-border-dim min-w-[70px] text-center shadow-lg">{result.score}</div>
                                                    </div>
                                                    <div class="flex flex-col md:flex-row items-center md:justify-end justify-start gap-2 md:gap-3 text-left md:text-right overflow-hidden">
                                                        <div class="flex items-center gap-2 md:gap-3 min-w-0 w-full">
                                                            <span class="text-lg md:text-2xl">{result.away_flag}</span>
                                                            {result.away_link ? <a href={result.away_link} class="text-[10px] md:text-xl font-black text-foreground hover:text-yellow-400 truncate">{result.away}</a> : <span class="text-[10px] md:text-xl font-black text-foreground truncate">{result.away}</span>}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                    <div class="mt-8 flex justify-end">
                                        <a href={`#${league.id}-round-selector`} class="inline-flex items-center gap-2 text-[8px] font-black text-foreground/20 hover:text-yellow-400 uppercase tracking-widest group/back">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover:-translate-y-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m18 15-6-6-6 6"></path></svg>
                                            Back to Selection
                                        </a>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                );
            })}
        </div>

        <div id="mobile-round-nav" class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-[60] w-[95%] max-w-sm">
            <div class="bg-background/95 backdrop-blur-3xl border border-border-dim/50 rounded-[2.5rem] p-6 shadow-2xl relative overflow-hidden">
                <div class="relative z-10">
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center gap-3">
                            <div class="w-2.5 h-2.5 rounded-full bg-yellow-400 shadow-xl"></div>
                            <span id="mobile-current-league-name" class="text-xs font-black text-foreground uppercase italic text-shadow-sm">リーグワン</span>
                        </div>
                        <a href="#top" class="text-[10px] font-black text-foreground/40 bg-foreground/5 px-3 py-1.5 rounded-full border border-border-dim/30">TOP</a>
                    </div>
                    <div class="relative mb-6">
                        <select id="mobile-round-select" class="w-full bg-foreground/5 border border-border-dim/30 rounded-2xl p-4 text-xs font-black appearance-none focus:border-yellow-400 transition-all uppercase tracking-widest">
                            <option value="" disabled selected>Select Round</option>
                            {leagues.filter(l => !l.isParent).map(l => (
                                <optgroup label={l.name} data-league-group={l.id} class="hidden">
                                    {getLeagueResults(l).map((g: any) => (
                                        <option value={`#${l.id}-round-${g.round}`}>
                                            {l.id.startsWith('league-one') ? `第${g.round}節` : `ROUND ${g.round}`}
                                        </option>
                                    ))}
                                </optgroup>
                            ))}
                        </select>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-foreground/20">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>
                    <div class="pt-5 border-t border-border-dim/30 flex items-center justify-between">
                        <div class="flex flex-1 justify-between gap-2">
                            {['super-rugby', 'top14', 'premiership', 'urc'].map(id => (
                                <button data-league-switch={id} class="flex-1 py-2.5 rounded-xl bg-foreground/5 text-[10px] font-black text-foreground/30 uppercase tracking-widest border border-border-dim/20">
                                    {id === 'premiership' ? 'PREM' : id.toUpperCase().slice(0, 3)}
                                </button>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script is:inline>
(function() {
    let activeLeague = '';
    const leagueColors = {
        'all': { label: 'ALL LEAGUES', from: 'bg-gray-100', text: 'text-gray-900' },
        'league-one-d1': { label: 'DIVISION 1', from: 'bg-black', text: 'text-white' },
        'league-one-d2': { label: 'DIVISION 2', from: 'bg-black', text: 'text-white' },
        'league-one-d3': { label: 'DIVISION 3', from: 'bg-black', text: 'text-white' },
        'super-rugby': { label: 'SUPER RUGBY', from: 'bg-blue-900', text: 'text-white' },
        'top14': { label: 'TOP 14', from: 'bg-gray-900', text: 'text-white' },
        'urc': { label: 'URC', from: 'bg-blue-950', text: 'text-white' },
        'premiership': { label: 'PREMIERSHIP', from: 'bg-[#FE5000]', text: 'text-black' }
    };

    function updateFilter(league) {
        if (!league) return;
        const normalized = league.toLowerCase();
        activeLeague = normalized;
        
        const sections = document.querySelectorAll('.league-section');
        sections.forEach(section => {
            const sid = section.getAttribute('data-league').toLowerCase();
            const isMatch = normalized === 'all' || sid === normalized || (normalized === 'league-one' && sid.includes('league-one'));
            section.style.display = isMatch ? 'block' : 'none';
        });

        const mobileSelect = document.getElementById('mobile-round-select');
        if (mobileSelect) {
            mobileSelect.querySelectorAll('optgroup').forEach(group => {
                const gid = group.getAttribute('data-league-group').toLowerCase();
                group.classList.toggle('hidden', gid !== normalized && !(normalized === 'league-one' && gid.includes('league-one')));
                group.disabled = gid !== normalized && !(normalized === 'league-one' && gid.includes('league-one'));
            });
        }
    }

    document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-league], [data-league-switch]');
        if (btn) updateFilter(btn.getAttribute('data-league') || btn.getAttribute('data-league-switch'));
    });

    document.addEventListener('change', (e) => {
        const select = e.target.closest('.round-jump-select, #mobile-round-select');
        if (select && select.value) {
            const targetId = select.value.replace('#', '');
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
                targetEl.classList.remove('hidden');
                targetEl.style.display = 'block';
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    });

    const p = new URLSearchParams(window.location.search);
    updateFilter(p.get('league') || 'league-one-d1');
})();
</script>
